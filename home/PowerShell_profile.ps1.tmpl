# PowerShell Profile managed by chezmoi
# This file is deployed to ~/PowerShell_profile.ps1
# Load from $PROFILE (OneDrive) with:
#   if (Test-Path "$env:USERPROFILE\PowerShell_profile.ps1") { . "$env:USERPROFILE\PowerShell_profile.ps1" }

# === mise activation (requires PowerShell 7+) ===
mise activate pwsh | Out-String | Invoke-Expression

# === Environment variables ===
$env:EDITOR = 'edit'

# === Functions ===

# Copilot CLI workaround: edit.exe を新コンソールで開く短縮コマンド
function Open-EditInNewConsole {
    param(
        [Parameter(ValueFromRemainingArguments = $true)]
        [string[]]$Path
    )

    $escapedPath = $Path | ForEach-Object {
        '"' + ($_ -replace '"', '\"') + '"'
    }
    $command = if ($escapedPath) {
        'start "" edit ' + ($escapedPath -join ' ')
    }
    else {
        'start "" edit'
    }

    Start-Process -FilePath 'cmd.exe' -ArgumentList '/c', $command | Out-Null
}

function zi { cdi @args }

# ghq + fzf: fuzzy-search git repositories and cd into selection
function ghcd {
    $dir = ghq list -p | fzf --preview 'dir /a {}'
    if ($dir) { Set-Location $dir }
}

function ll { Get-ChildItem -Force @args }

# mise 本体を mise 組み込み機能で更新する（プラグインは更新しない）
function Invoke-MiseSelfUpdate {
    if ($args.Count -ne 0) {
        Write-Error "❌ mise-self-update は追加引数を受け付けません" -ErrorAction Continue
        $global:LASTEXITCODE = 2
        return
    }

    $prevErrorAction = $ErrorActionPreference
    $previousNativeErrorPreference = $PSNativeCommandUseErrorActionPreference
    $ErrorActionPreference = 'Stop'
    $PSNativeCommandUseErrorActionPreference = $false
    $setTemporaryMiseGitHubToken = $false
    try {
        if (-not (Get-Command mise -ErrorAction SilentlyContinue)) {
            throw "mise が見つかりません"
        }

        $processEnvironment = [Environment]::GetEnvironmentVariables('Process')
        if (
            -not $processEnvironment.Contains('MISE_GITHUB_TOKEN') -and
            -not $processEnvironment.Contains('GITHUB_API_TOKEN') -and
            -not $processEnvironment.Contains('GITHUB_TOKEN')
        ) {
            $token = $env:GH_TOKEN
            if (-not $token -and (Get-Command gh -ErrorAction SilentlyContinue)) {
                $token = gh auth token 2>$null
                if ($LASTEXITCODE -ne 0) {
                    $token = $null
                }
            }
            if ($token) {
                $env:MISE_GITHUB_TOKEN = $token
                $setTemporaryMiseGitHubToken = $true
            }
        }

        Write-Host "==> mise: 本体を self-update..."
        try {
            mise self-update --yes --no-plugins
            $selfUpdateExitCode = $LASTEXITCODE
        }
        finally {
            if ($setTemporaryMiseGitHubToken) {
                Remove-Item Env:\MISE_GITHUB_TOKEN -ErrorAction SilentlyContinue
                $setTemporaryMiseGitHubToken = $false
            }
        }
        if ($selfUpdateExitCode -ne 0) { throw "mise self-update に失敗しました" }

        Write-Host "==> mise: shim を再生成..."
        mise reshim
        if ($LASTEXITCODE -ne 0) { throw "mise reshim に失敗しました" }

        Write-Host "✅ mise 本体の更新が完了しました"
        $global:LASTEXITCODE = 0
    }
    catch {
        Write-Error "❌ $($_.Exception.Message)" -ErrorAction Continue
        $global:LASTEXITCODE = 1
    }
    finally {
        if ($setTemporaryMiseGitHubToken) {
            Remove-Item Env:\MISE_GITHUB_TOKEN -ErrorAction SilentlyContinue
        }
        $PSNativeCommandUseErrorActionPreference = $previousNativeErrorPreference
        $ErrorActionPreference = $prevErrorAction
    }
}

# mise 管理ツールの一括更新（日常操作）
# upgrade → lockfile 更新 → chezmoi 反映 → git commit+push を一括実行
function Invoke-MiseUpgrade {
    $prevErrorAction = $ErrorActionPreference
    $previousNativeErrorPreference = $PSNativeCommandUseErrorActionPreference
    $ErrorActionPreference = 'Stop'
    $PSNativeCommandUseErrorActionPreference = $false
    $miseLog = $null
    $backupRoot = $null
    $miseConfigDir = Join-Path $HOME ".config\mise"
    $lockfile = Join-Path $miseConfigDir "mise.lock"
    $locksDir = Join-Path $miseConfigDir "locks"
    $hadLockfile = $false
    $hadLocksDir = $false
    $sourceLockfile = $null
    $sourceLocksDir = $null
    $hadSourceLockfile = $false
    $hadSourceLocksDir = $false
    $restoreTargetOnFailure = $false
    $restoreSourceOnFailure = $false
    $previousGitHubToken = $env:GITHUB_TOKEN
    try {
        # 前提条件チェック
        if (-not (Get-Command gh -ErrorAction SilentlyContinue)) {
            throw "gh CLI が見つかりません。https://cli.github.com/ からインストールしてください"
        }
        if (-not (Get-Command mise -ErrorAction SilentlyContinue)) {
            throw "mise が見つかりません。https://mise.jdx.dev/ からインストールしてください"
        }
        if (-not (Get-Command chezmoi -ErrorAction SilentlyContinue)) {
            throw "chezmoi が見つかりません。https://www.chezmoi.io/ からインストールしてください"
        }

        $token = gh auth token 2>$null
        if ($LASTEXITCODE -ne 0 -or -not $token) {
            throw "GitHub 認証が必要です。gh auth login を実行してください"
        }
        $env:GITHUB_TOKEN = $token

        function Restore-MiseArtifacts {
            param(
                [Parameter(Mandatory)]
                [string]$CurrentLockfile,
                [Parameter(Mandatory)]
                [AllowEmptyString()]
                [string]$CurrentLocksDir,
                [Parameter(Mandatory)]
                [string]$BackupDir,
                [Parameter(Mandatory)]
                [bool]$HadLockfile,
                [Parameter(Mandatory)]
                [bool]$HadLocksDir
            )

            if (Test-Path -LiteralPath $CurrentLockfile) {
                Remove-Item -LiteralPath $CurrentLockfile -Force -ErrorAction Stop
            }
            if ($CurrentLocksDir -and (Test-Path -LiteralPath $CurrentLocksDir)) {
                Remove-Item -LiteralPath $CurrentLocksDir `
                    -Recurse -Force -ErrorAction Stop
            }
            if ($HadLockfile) {
                Copy-Item -Path (Join-Path $BackupDir "mise.lock") `
                    -Destination $CurrentLockfile -Force
            }
            if ($HadLocksDir) {
                if (-not $CurrentLocksDir) {
                    throw "dependency sidecar の復元先が空です"
                }
                Copy-Item -Path (Join-Path $BackupDir "locks") `
                    -Destination $CurrentLocksDir -Recurse -Force
            }
        }

        function Invoke-MiseChecked {
            param(
                [Parameter(Mandatory)]
                [string]$Phase,
                [Parameter(Mandatory)]
                [string]$FailureMessage,
                [Parameter(Mandatory)]
                [string[]]$Arguments
            )

            $previousNativeErrorPreference = $PSNativeCommandUseErrorActionPreference
            try {
                $PSNativeCommandUseErrorActionPreference = $false
                $capturedOutput = @(
                    & mise @Arguments 2>&1 |
                        Tee-Object -FilePath $miseLog -Append |
                        ForEach-Object {
                            Write-Host "$_"
                            $_
                        }
                )
                $miseExitCode = $LASTEXITCODE
            }
            finally {
                $PSNativeCommandUseErrorActionPreference = $previousNativeErrorPreference
            }
            if ($miseExitCode -ne 0) {
                throw $FailureMessage
            }
            $normalizedOutput = $capturedOutput |
                ForEach-Object { "$_" -replace "`e\[[0-9;]*[A-Za-z]", "" }
            $minimumReleaseAgePattern = '^mise WARN\s+newer \S+ release \S+(?:\s+\(released [^)]+\))?\s+ignored by minimum_release_age \([^)]+\); latest eligible release is \S+\s*$'
            $recoveredFallbackPattern = '^mise WARN\s+mise-versions\s+endpoint=\S+\s+repo=\S+\s+tag=\S+\s+outcome=\S+\s+status=\S+\s+fallback=true(?:\s+error=.*)?$'
            $blockingWarnings = $normalizedOutput |
                Where-Object {
                    $_ -match 'mise WARN' -and
                    $_ -notmatch $minimumReleaseAgePattern -and
                    $_ -notmatch $recoveredFallbackPattern
                }
            if ($blockingWarnings) {
                throw "${Phase}: 処理を中止する警告を検出したため、commit と push を中止します"
            }
            $minimumReleaseAgeWarnings = $normalizedOutput |
                Where-Object { $_ -match $minimumReleaseAgePattern }
            foreach ($warning in $minimumReleaseAgeWarnings) {
                Write-Warning "${Phase}: リリース待機期間による保留を検出しました。処理を継続します: $warning"
            }
            $recoveredFallbackWarnings = $normalizedOutput |
                Where-Object { $_ -match $recoveredFallbackPattern }
            foreach ($warning in $recoveredFallbackWarnings) {
                Write-Warning "${Phase}: 回復済みのメタデータ取得フォールバックを検出しました。処理を継続します: $warning"
            }
        }

        $miseLog = [System.IO.Path]::GetTempFileName()
        $backupRoot = Join-Path ([System.IO.Path]::GetTempPath()) (
            "mise-upgrade-" + [System.Guid]::NewGuid().ToString("N")
        )
        $targetBackupDir = Join-Path $backupRoot "target"
        New-Item -ItemType Directory -Path $targetBackupDir -Force | Out-Null
        $hadLockfile = Test-Path $lockfile
        $hadLocksDir = Test-Path $locksDir
        if ($hadLockfile) {
            Copy-Item -Path $lockfile `
                -Destination (Join-Path $targetBackupDir "mise.lock") -Force
        }
        if ($hadLocksDir) {
            Copy-Item -Path $locksDir `
                -Destination (Join-Path $targetBackupDir "locks") -Recurse -Force
        }
        $restoreTargetOnFailure = $true

        Write-Host "==> mise upgrade: ツールを最新版に更新..."
        Invoke-MiseChecked `
            -Phase "mise upgrade" `
            -FailureMessage "mise upgrade に失敗しました。" `
            -Arguments @("upgrade")

        Write-Host "==> mise lock: lockfile と dependency sidecar を再生成..."
        Remove-Item -Path $lockfile -Force -ErrorAction SilentlyContinue
        Remove-Item -Path $locksDir -Recurse -Force -ErrorAction SilentlyContinue
        Invoke-MiseChecked `
            -Phase "mise lock" `
            -FailureMessage "lockfile と dependency sidecar の再生成に失敗しました。実行ログを確認してください。" `
            -Arguments @("lock", "--global", "--platform", "linux-x64,linux-arm64,macos-arm64,windows-x64,windows-arm64", "--bump")

        New-Item -ItemType Directory -Path $locksDir -Force | Out-Null
        $lockText = [System.IO.File]::ReadAllText($lockfile)
        if ([string]::IsNullOrWhiteSpace($lockText)) {
            throw "lockfile が存在しないか空です"
        }
        $aubePaths = [regex]::Matches(
            $lockText,
            '(?m)^\s*aube\s*=\s*\{\s*path\s*=\s*"([^"]+)"'
        ) | ForEach-Object { $_.Groups[1].Value }
        $aubeDeclarationCount = [regex]::Matches(
            $lockText,
            '(?m)^\s*aube\s*='
        ).Count
        if ($aubePaths.Count -ne $aubeDeclarationCount) {
            throw "lockfile の dependency sidecar path をすべて解析できません"
        }
        foreach ($aubePath in $aubePaths) {
            $pathParts = $aubePath -split '/'
            if ($aubePath -notmatch '^locks/[^/\\]+(?:/[^/\\]+)*\z' -or
                $pathParts -contains '..') {
                throw "lockfile の dependency sidecar path が不正です: $aubePath"
            }
            $sidecarDir = Join-Path $miseConfigDir ($aubePath -replace '/', '\')
            foreach ($requiredFile in @("aube-lock.yaml", "package.json")) {
                if (-not (Test-Path -LiteralPath (Join-Path $sidecarDir $requiredFile))) {
                    throw "dependency sidecar が不足しています: $aubePath/$requiredFile"
                }
            }
        }
        if ($aubePaths.Count -eq 0) {
            [System.IO.File]::WriteAllText((Join-Path $locksDir ".keep"), "")
        }

        $sourceHome = "$(& chezmoi source-path)".Trim()
        if ($LASTEXITCODE -ne 0 -or -not $sourceHome) {
            throw "chezmoi ソースディレクトリを取得できません"
        }
        $sourceRoot = Split-Path $sourceHome -Parent
        $branch = git -C $sourceRoot rev-parse --abbrev-ref HEAD
        if ($LASTEXITCODE -ne 0 -or $branch -ne "main") {
            throw "chezmoi ソースが main ブランチではありません (現在: $branch)。git checkout main してから再実行してください"
        }

        $sourceLockfile = "$(& chezmoi source-path $lockfile)".Trim()
        if ($LASTEXITCODE -ne 0 -or -not $sourceLockfile) {
            throw "mise.lock の chezmoi ソースパスを取得できません"
        }
        $resolvedSourceLocksDir = "$(& chezmoi source-path $locksDir 2>$null)".Trim()
        if ($LASTEXITCODE -eq 0 -and $resolvedSourceLocksDir) {
            $sourceLocksDir = $resolvedSourceLocksDir
        }
        $sourceBackupDir = Join-Path $backupRoot "source"
        New-Item -ItemType Directory -Path $sourceBackupDir -Force | Out-Null
        $hadSourceLockfile = Test-Path $sourceLockfile
        $hadSourceLocksDir = $sourceLocksDir -and (
            Test-Path -LiteralPath $sourceLocksDir
        )
        if ($hadSourceLockfile) {
            Copy-Item -Path $sourceLockfile `
                -Destination (Join-Path $sourceBackupDir "mise.lock") -Force
        }
        if ($hadSourceLocksDir) {
            Copy-Item -Path $sourceLocksDir `
                -Destination (Join-Path $sourceBackupDir "locks") -Recurse -Force
        }
        $restoreSourceOnFailure = $true

        Write-Host "==> chezmoi: lockfile と dependency sidecar をソースに反映..."
        chezmoi re-add $lockfile
        if ($LASTEXITCODE -ne 0) {
            throw "mise.lock の chezmoi re-add に失敗しました"
        }
        if ($hadSourceLocksDir) {
            chezmoi forget --force $locksDir
            if ($LASTEXITCODE -ne 0) {
                throw "既存 dependency sidecar の chezmoi forget に失敗しました"
            }
        }
        chezmoi add --exact $locksDir
        if ($LASTEXITCODE -ne 0) {
            throw "dependency sidecar の chezmoi add --exact に失敗しました"
        }
        $updatedSourceLocksDir = "$(& chezmoi source-path $locksDir 2>$null)".Trim()
        if ($LASTEXITCODE -ne 0 -or -not $updatedSourceLocksDir) {
            throw "更新後の dependency sidecar の chezmoi ソースパスを取得できません"
        }
        $sourceLocksDir = $updatedSourceLocksDir

        $restoreSourceOnFailure = $false
        $restoreTargetOnFailure = $false
        Remove-Item -Path $backupRoot -Recurse -Force -ErrorAction SilentlyContinue
        Remove-Item -Path $miseLog -Force -ErrorAction SilentlyContinue

        Push-Location $sourceRoot
        try {
            git add -A
            if ($LASTEXITCODE -ne 0) {
                throw "git add に失敗しました"
            }
            $diff = git diff --cached --quiet 2>&1
            if ($LASTEXITCODE -eq 0) {
                Write-Host "✅ 更新するツールはありませんでした"
                return
            }

            git commit -m "chore: upgrade mise tools"
            if ($LASTEXITCODE -ne 0) {
                throw "git commit に失敗しました"
            }

            git push
            if ($LASTEXITCODE -ne 0) {
                throw "git push に失敗しました。コミットは完了しています。手動で push してください"
            }
        }
        finally {
            Pop-Location
        }

        Write-Host "✅ mise ツールの更新が完了しました"
    }
    catch {
        $failure = $_
        $restoreFailed = $false
        if ($restoreSourceOnFailure) {
            try {
                & chezmoi forget --force $locksDir 2>$null | Out-Null
                $currentSourceLocksDir = "$(& chezmoi source-path $locksDir 2>$null)".Trim()
                if ($LASTEXITCODE -eq 0 -and $currentSourceLocksDir) {
                    $sourceLocksDir = $currentSourceLocksDir
                }
                Restore-MiseArtifacts `
                    -CurrentLockfile $sourceLockfile `
                    -CurrentLocksDir $sourceLocksDir `
                    -BackupDir (Join-Path $backupRoot "source") `
                    -HadLockfile $hadSourceLockfile `
                    -HadLocksDir $hadSourceLocksDir
                Write-Warning "chezmoi ソースの lockfile と dependency sidecar を復元しました"
            }
            catch {
                $restoreFailed = $true
                Write-Error "❌ chezmoi ソースの lockfile と dependency sidecar を復元できませんでした: $($_.Exception.Message)" -ErrorAction Continue
            }
        }
        if ($restoreTargetOnFailure) {
            try {
                Restore-MiseArtifacts `
                    -CurrentLockfile $lockfile `
                    -CurrentLocksDir $locksDir `
                    -BackupDir (Join-Path $backupRoot "target") `
                    -HadLockfile $hadLockfile `
                    -HadLocksDir $hadLocksDir
                Write-Warning "mise upgrade 実行前の lockfile と dependency sidecar を復元しました"
            }
            catch {
                $restoreFailed = $true
                Write-Error "❌ mise upgrade 実行前の lockfile と dependency sidecar を復元できませんでした: $($_.Exception.Message)" -ErrorAction Continue
            }
        }
        if ($backupRoot -and (Test-Path $backupRoot) -and -not $restoreFailed) {
            Remove-Item -Path $backupRoot -Recurse -Force -ErrorAction SilentlyContinue
        }
        if ($miseLog -and (Test-Path $miseLog)) {
            Write-Error "❌ $($failure.Exception.Message) 実行ログ: $miseLog" -ErrorAction Continue
        }
        else {
            Write-Error "❌ $($failure.Exception.Message)" -ErrorAction Continue
        }
        throw $failure
    }
    finally {
        if ($null -eq $previousGitHubToken) {
            Remove-Item Env:GITHUB_TOKEN -ErrorAction SilentlyContinue
        }
        else {
            $env:GITHUB_TOKEN = $previousGitHubToken
        }
        $PSNativeCommandUseErrorActionPreference = $previousNativeErrorPreference
        $ErrorActionPreference = $prevErrorAction
    }
}

# git-hooks-audit: ghq 管理下の全リポジトリを走査し、init.templateDir 経由の
# pre-commit hook (gitleaks) が効いているか報告する (ADR-018)。
# init.templateDir は git init/clone 時に一度だけ hook をコピーする方式のため、
# 既存リポジトリや、独自 hooksPath を持つリポジトリ (lefthook/husky 等) では
# 自動的には保護されない。ここでは削除・変更は一切行わず、状態を可視化するのみ。
function Invoke-GitHooksAudit {
    if (-not (Get-Command ghq -ErrorAction SilentlyContinue)) {
        Write-Error "❌ ghq が見つかりません"
        return
    }

    ghq list -p | ForEach-Object {
        $repo = $_
        if (-not (Test-Path $repo -PathType Container)) { return }

        # --local ではなく実効値を見る（global/system/includeIf 由来の override も検知するため）
        $hooksPathEffective = git -C $repo config --get core.hooksPath 2>$null
        if ($LASTEXITCODE -eq 0 -and $hooksPathEffective) {
            if ($hooksPathEffective -eq "$HOME/.config/git/hooks" -or $hooksPathEffective -eq "~/.config/git/hooks") {
                Write-Host "⚠️  ${repo}: core.hooksPath=$hooksPathEffective (旧グローバル設定。chezmoi apply 後に再確認)"
            }
            else {
                Write-Host "⚠️  ${repo}: core.hooksPath=$hooksPathEffective (init.templateDir hook は使われません)"
            }
            return
        }

        $isBare = git -C $repo rev-parse --is-bare-repository 2>$null
        if ($LASTEXITCODE -ne 0 -or -not $isBare) {
            Write-Host "❓ ${repo}: git repo として認識できません"
            return
        }
        if ($isBare -eq 'true') {
            Write-Host "ℹ️  ${repo}: bare repo のため対象外"
            return
        }

        # 手動で相対パスを組み立てない（worktree 等で $repo 相対とは限らないため）
        $hookPath = git -C $repo rev-parse --path-format=absolute --git-path hooks/pre-commit 2>$null
        $gitOk = $LASTEXITCODE -eq 0
        if (-not $gitOk -or -not $hookPath) {
            Write-Host "❓ ${repo}: hook path を解決できません"
            return
        }

        if (-not (Test-Path $hookPath -PathType Leaf)) {
            Write-Host "❌ ${repo}: pre-commit hook が無い（backfill: git -C '$repo' init）"
            return
        }

        if (Select-String -Path $hookPath -Pattern 'gitleaks.*git.*--pre-commit.*--staged' -Quiet) {
            Write-Host "✅ ${repo}: gitleaks hook 有効"
        }
        else {
            Write-Host "ℹ️  ${repo}: pre-commit hook はあるが gitleaks 製ではない（他ツールが管理中と思われる）"
        }
    }
}

# === Aliases ===
Set-Alias -Name e -Value Open-EditInNewConsole
Set-Alias -Name k -Value kubectl
Set-Alias -Name mise-self-update -Value Invoke-MiseSelfUpdate
Set-Alias -Name mise-upgrade -Value Invoke-MiseUpgrade
Set-Alias -Name git-hooks-audit -Value Invoke-GitHooksAudit

# Bypass the broken WindowsApps execution alias; see docs/troubleshooting.md.
$copilotCli = Join-Path $env:LOCALAPPDATA 'Microsoft\WinGet\Links\copilot.exe'
if (Test-Path -LiteralPath $copilotCli -PathType Leaf) {
    Set-Alias -Name copilot -Value $copilotCli
}
Remove-Variable copilotCli

# Copilot CLI: local sandbox is enabled. preToolUse hooks still protect
# sensitive files and shell-level secret reads.
function Invoke-CopilotGuardrails {
    copilot `
      --allow-all `
      --secret-env-vars 'AZURE_CLIENT_SECRET,ARM_CLIENT_SECRET,ARM_ACCESS_KEY,AZURE_STORAGE_CONNECTION_STRING' `
      @args
}
Set-Alias -Name copilot-guardrails -Value Invoke-CopilotGuardrails

# === Completers and tool setup ===

# https://learn.microsoft.com/en-us/cli/azure/install-azure-cli-windows?tabs=azure-cli#enable-tab-completion-in-powershell
Register-ArgumentCompleter -Native -CommandName az -ScriptBlock {
    param($commandName, $wordToComplete, $cursorPosition)
    $completion_file = New-TemporaryFile
    $env:ARGCOMPLETE_USE_TEMPFILES = 1
    $env:_ARGCOMPLETE_STDOUT_FILENAME = $completion_file
    $env:COMP_LINE = $wordToComplete
    $env:COMP_POINT = $cursorPosition
    $env:_ARGCOMPLETE = 1
    $env:_ARGCOMPLETE_SUPPRESS_SPACE = 0
    $env:_ARGCOMPLETE_IFS = "`n"
    $env:_ARGCOMPLETE_SHELL = 'powershell'
    az 2>&1 | Out-Null
    Get-Content $completion_file | Sort-Object | ForEach-Object {
        [System.Management.Automation.CompletionResult]::new($_, $_, "ParameterValue", $_)
    }
    Remove-Item $completion_file, Env:\_ARGCOMPLETE_STDOUT_FILENAME, Env:\ARGCOMPLETE_USE_TEMPFILES, Env:\COMP_LINE, Env:\COMP_POINT, Env:\_ARGCOMPLETE, Env:\_ARGCOMPLETE_SUPPRESS_SPACE, Env:\_ARGCOMPLETE_IFS, Env:\_ARGCOMPLETE_SHELL
}

# Completion cache: generate once and return the source file path.
# Cache is invalidated when the tool binary is updated (mtime comparison).
function Get-CachedSourcePath {
    param(
        [string]$Name,
        [string]$Command,
        [scriptblock]$Generator
    )
    $cmdInfo = Get-Command $Command -ErrorAction SilentlyContinue
    if (-not $cmdInfo) { return }
    $cmdPath = $cmdInfo.Source

    $cacheDir = Join-Path $env:LOCALAPPDATA 'shell-completions'
    $cacheFile = Join-Path $cacheDir "$Name.ps1"
    if (-not (Test-Path $cacheDir)) { [void](New-Item -ItemType Directory -Path $cacheDir -Force) }

    $cmdMtime = (Get-Item $cmdPath).LastWriteTime
    if ((Test-Path $cacheFile) -and (Get-Item $cacheFile).LastWriteTime -gt $cmdMtime) {
        return $cacheFile
    }

    $output = & $Generator 2>$null | Out-String
    if ($output) {
        Set-Content -Path $cacheFile -Value $output -Encoding utf8
        return $cacheFile
    }
}

function Clear-CompletionCache {
    $cacheDir = Join-Path $env:LOCALAPPDATA 'shell-completions'
    if (Test-Path $cacheDir) { Remove-Item -Recurse -Force $cacheDir }
    Write-Host "Completion cache cleared. Restart shell to regenerate."
}

$kubectlCompletionPath = Get-CachedSourcePath -Name kubectl -Command kubectl -Generator { kubectl completion powershell }
if ($kubectlCompletionPath) {
    . $kubectlCompletionPath
    $kubectlCompleter = Get-Variable -Name __kubectlCompleterBlock -ValueOnly -ErrorAction SilentlyContinue
    if ($kubectlCompleter) {
        Register-ArgumentCompleter -CommandName k -ScriptBlock $kubectlCompleter
    }
}

