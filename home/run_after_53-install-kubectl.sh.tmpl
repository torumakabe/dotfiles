{{- if ne .chezmoi.os "windows" -}}
{{- $platform := printf "%s-%s" .chezmoi.os .chezmoi.arch -}}
#!/usr/bin/env bash
# kubectl を公式バイナリから ~/.local/bin へ直接導入する。

set -euo pipefail

tool_name=kubectl
tool_version='{{ .kubectl.version }}'
{{ if not (hasKey .kubectl.assets $platform) }}
echo "error: kubectl ${tool_version} has no asset for {{ $platform }}" >&2
exit 1
{{ else }}
{{- $asset := index .kubectl.assets $platform }}
bin_dir="${HOME}/.local/bin"
target="${bin_dir}/${tool_name}"
mise_target="${HOME}/.local/share/mise/shims/${tool_name}"
jq_path="${bin_dir}/jq"
platform_os='{{ .chezmoi.os }}'
platform_arch='{{ .chezmoi.arch }}'
executable_arch='{{ $asset.executableArch }}'
asset_file='{{ $asset.file }}'
asset_url='{{ $asset.url }}'
asset_sha256='{{ $asset.sha256 }}'

[ "${executable_arch}" = "${platform_arch}" ] || {
  echo "error: declared executable architecture ${executable_arch} does not match ${platform_arch}" >&2
  exit 1
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    echo "error: sha256sum or shasum is required to verify ${asset_file}" >&2
    return 1
  fi
}

assert_target_replaceable() {
  if [ -L "${target}" ]; then
    local current
    current="$(readlink "${target}")"
    if [ "${current}" != "${mise_target}" ]; then
      echo "error: ${target} is a foreign symlink (${current}); refusing to replace it" >&2
      return 1
    fi
    if [ -d "${target}" ]; then
      echo "error: ${target} points to a directory; refusing to replace it" >&2
      return 1
    fi
  elif [ -e "${target}" ] && [ ! -f "${target}" ]; then
    echo "error: ${target} is not a regular file; refusing to replace it" >&2
    return 1
  fi
}

has_expected_architecture() {
  local binary=$1 header
  [ -f "${binary}" ] && [ ! -L "${binary}" ] || return 1
  if ! header="$(LC_ALL=C od -An -tx1 -N20 "${binary}" 2>/dev/null |
    awk '{ for (i = 1; i <= NF; i++) printf "%s", $i } END { print "" }')"; then
    return 1
  fi
  case "${platform_os}:${platform_arch}" in
    linux:amd64)
      [ "${#header}" -ge 40 ] && [ "${header:0:12}" = "7f454c460201" ] &&
        [ "${header:36:4}" = "3e00" ]
      ;;
    linux:arm64)
      [ "${#header}" -ge 40 ] && [ "${header:0:12}" = "7f454c460201" ] &&
        [ "${header:36:4}" = "b700" ]
      ;;
    darwin:arm64)
      [ "${#header}" -ge 16 ] && [ "${header:0:16}" = "cffaedfe0c000001" ]
      ;;
    *) return 1 ;;
  esac
}

has_expected_version() {
  local binary=$1 cwd=$2 output found
  [ -f "${binary}" ] && [ ! -L "${binary}" ] && [ -x "${binary}" ] || return 1
  [ -x "${jq_path}" ] || {
    echo "error: ${jq_path} is required to verify kubectl" >&2
    return 1
  }
  if ! output="$(cd "${cwd}" && "${binary}" version --client=true --output=json 2>/dev/null)"; then
    return 1
  fi
  if ! found="$(printf '%s' "${output}" | "${jq_path}" -er '.clientVersion.gitVersion' 2>/dev/null)"; then
    return 1
  fi
  [ "${found}" = "v${tool_version}" ]
}

command -v od >/dev/null 2>&1 || {
  echo "error: od is required to verify ${tool_name} architecture" >&2
  exit 1
}
[ -x "${jq_path}" ] || {
  echo "error: ${jq_path} is required to verify kubectl" >&2
  exit 1
}
assert_target_replaceable
if [ ! -L "${target}" ] && has_expected_architecture "${target}" &&
  has_expected_version "${target}" "${bin_dir}"; then
  exit 0
fi

command -v curl >/dev/null 2>&1 || {
  echo "error: curl is required to install ${tool_name}" >&2
  exit 1
}
mkdir -p "${bin_dir}"
stage_dir="$(mktemp -d "${bin_dir}/.${tool_name}-install.XXXXXX")"
trap 'rm -rf "${stage_dir}"' EXIT
chmod 700 "${stage_dir}"
download="${stage_dir}/download"

if ! curl --proto '=https' --tlsv1.2 -fsSL -o "${download}" "${asset_url}"; then
  echo "error: failed to download ${asset_file}; keeping the current ${tool_name}" >&2
  exit 1
fi
if [ "$(sha256_file "${download}")" != "${asset_sha256}" ]; then
  echo "error: checksum verification failed for ${asset_file}" >&2
  exit 1
fi

candidate="${stage_dir}/${tool_name}"
cp "${download}" "${candidate}"
if [ ! -f "${candidate}" ] || [ -L "${candidate}" ]; then
  echo "error: downloaded ${asset_file} is not a regular file" >&2
  exit 1
fi
if ! has_expected_architecture "${candidate}"; then
  echo "error: ${asset_file} does not contain a ${platform_arch} ${platform_os} executable" >&2
  exit 1
fi
chmod 755 "${candidate}"
if ! has_expected_version "${candidate}" "${stage_dir}"; then
  echo "error: ${asset_file} did not report kubectl ${tool_version}" >&2
  exit 1
fi

assert_target_replaceable
echo "Installing kubectl ${tool_version}..."
if ! mv -f "${candidate}" "${target}"; then
  echo "error: could not publish ${target}; the previous file was kept" >&2
  exit 1
fi
{{ end }}
{{- end -}}
