{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# Copilot CLI local sandbox 設定 (Linux/macOS)
#
# Copilot sandbox policy version: 3

set -euo pipefail

sandbox_default_enabled={{ if or .codespaces .devcontainer }}false{{ else }}true{{ end }}

if ! command -v jq >/dev/null 2>&1; then
  echo 'jq not found on PATH; cannot configure Copilot sandbox settings.' >&2
  exit 1
fi

copilot_home="${COPILOT_HOME:-${HOME}/.copilot}"
settings_path="${copilot_home}/settings.json"
settings_dir="$(dirname "${settings_path}")"
mkdir -p "${settings_dir}"

tmp_dir="$(mktemp -d)"
merged="${tmp_dir}/merged.json"
empty_input="${tmp_dir}/empty.json"
desired="${tmp_dir}/desired.json"
settings_tmp="$(mktemp "${settings_dir}/.settings.json.XXXXXX")"
chmod 0600 "${settings_tmp}"
trap 'rm -f "${merged}" "${empty_input}" "${desired}" "${settings_tmp}"; rmdir "${tmp_dir}" 2>/dev/null || true' EXIT

cat >"${desired}" <<'JSON'
{{ include ".chezmoitemplates/copilot-user-settings.json" }}
JSON
jq -e . "${desired}" >/dev/null

if [ -f "${settings_path}" ]; then
  input_path="${settings_path}"
else
  input_path="${empty_input}"
  printf '{}\n' >"${input_path}"
fi

# `/sandbox disable` persists sandbox.enabled=false in settings.json, and that
# must survive this template update until `/sandbox enable` restores it. jq's
# `//` cannot be used here because it also substitutes on `false`; presence
# and type must be checked explicitly before the desired template is merged.
enabled_present="$(jq -r '(.sandbox // {}) | has("enabled")' "${input_path}")"
if [ "${enabled_present}" = "true" ]; then
  enabled_type="$(jq -r '.sandbox.enabled | type' "${input_path}")"
  case "${enabled_type}" in
  boolean)
    existing_enabled="$(jq -c '.sandbox.enabled' "${input_path}")"
    ;;
  *)
    echo "Error: ${settings_path} has a non-boolean sandbox.enabled (${enabled_type}); refusing to overwrite it. Fix or remove the value and re-run chezmoi apply." >&2
    exit 1
    ;;
  esac
else
  existing_enabled="${sandbox_default_enabled}"
fi

for path_name in readwritePaths readonlyPaths deniedPaths; do
  path_type="$(
    jq -r --arg name "${path_name}" '
      (.sandbox.userPolicy.filesystem // {}) as $filesystem
      | if ($filesystem | has($name)) then
          ($filesystem[$name] | type)
        else
          "missing"
        end
    ' "${input_path}"
  )"
  case "${path_type}" in
  missing|null|array)
    ;;
  *)
    echo "Error: ${settings_path} has a non-array sandbox.userPolicy.filesystem.${path_name} (${path_type}); refusing to overwrite it. Fix or remove the value and re-run chezmoi apply." >&2
    exit 1
    ;;
  esac
done

jq --slurpfile desired "${desired}" '
  .experimental = $desired[0].experimental
  | .sandbox = (
    ((.sandbox // {}) * $desired[0].sandbox)
    | .userPolicy = (
      (.userPolicy // {})
      | del(.version)
      | .filesystem = (
        (.filesystem // {})
        | .readwritePaths = (.readwritePaths // [])
        | .readonlyPaths = (.readonlyPaths // [])
        | .deniedPaths = (.deniedPaths // [])
        | .clearPolicyOnExit = false
      )
      | .network = (
        (.network // {})
        | del(.allowedHosts, .blockedHosts)
      )
    )
  )
' "${input_path}" >"${merged}"

jq --argjson enabled "${existing_enabled}" '.sandbox.enabled = $enabled' "${merged}" >"${settings_tmp}"

jq -e . "${settings_tmp}" >/dev/null
mv -f "${settings_tmp}" "${settings_path}"
echo "Configured Copilot CLI local sandbox in ${settings_path}"
{{- end -}}
