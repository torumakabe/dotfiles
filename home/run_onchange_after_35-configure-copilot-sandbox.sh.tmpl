{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# Copilot CLI local sandbox 設定 (Linux/macOS)
#
# Copilot sandbox policy version: 5

set -euo pipefail

sandbox_default_enabled={{ if or .codespaces .devcontainer }}false{{ else }}true{{ end }}

if ! command -v jq >/dev/null 2>&1; then
  echo 'jq not found on PATH; cannot configure Copilot sandbox settings.' >&2
  exit 1
fi

copilot_home="${COPILOT_HOME:-${HOME}/.copilot}"
settings_path="${copilot_home}/settings.json"
settings_dir="$(dirname "${settings_path}")"
mise_data_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-${HOME}/.local/share}/mise}"
mise_installs="${MISE_INSTALLS_DIR:-${mise_data_dir}/installs}"
{{ if eq .chezmoi.os "darwin" -}}
copilot_uv_cache_home="${HOME}/Library/Caches"
{{ else -}}
copilot_uv_cache_home="${XDG_CACHE_HOME:-${HOME}/.cache}"
{{ end -}}
copilot_uv_cache_parent="${copilot_uv_cache_home}/github-copilot"
copilot_uv_cache_dir="${copilot_uv_cache_parent}/uv"
mkdir -p "${settings_dir}"

case "${mise_installs}" in
"${mise_data_dir}"|"${mise_data_dir%/}"/*)
  external_mise_installs=""
  ;;
*)
  external_mise_installs="${mise_installs}"
  ;;
esac

tmp_dir="$(mktemp -d)"
merged="${tmp_dir}/merged.json"
empty_input="${tmp_dir}/empty.json"
desired="${tmp_dir}/desired.json"
settings_tmp="$(mktemp "${settings_dir}/.settings.json.XXXXXX")"
chmod 0600 "${settings_tmp}"
trap 'rm -f "${merged}" "${empty_input}" "${desired}" "${settings_tmp}"; rmdir "${tmp_dir}" 2>/dev/null || true' EXIT

cat >"${desired}" <<'JSON'
{{ include ".chezmoitemplates/copilot-user-settings.json" }}
JSON
jq -e . "${desired}" >/dev/null

if [ -f "${settings_path}" ]; then
  input_path="${settings_path}"
else
  input_path="${empty_input}"
  printf '{}\n' >"${input_path}"
fi

# `/sandbox disable` persists sandbox.enabled=false in settings.json, and that
# must survive this template update until `/sandbox enable` restores it. jq's
# `//` cannot be used here because it also substitutes on `false`; presence
# and type must be checked explicitly before the desired template is merged.
enabled_present="$(jq -r '(.sandbox // {}) | has("enabled")' "${input_path}")"
if [ "${enabled_present}" = "true" ]; then
  enabled_type="$(jq -r '.sandbox.enabled | type' "${input_path}")"
  case "${enabled_type}" in
  boolean)
    existing_enabled="$(jq -c '.sandbox.enabled' "${input_path}")"
    ;;
  *)
    echo "Error: ${settings_path} has a non-boolean sandbox.enabled (${enabled_type}); refusing to overwrite it. Fix or remove the value and re-run chezmoi apply." >&2
    exit 1
    ;;
  esac
else
  existing_enabled="${sandbox_default_enabled}"
fi

for path_name in readwritePaths readonlyPaths deniedPaths; do
  path_type="$(
    jq -r --arg name "${path_name}" '
      (.sandbox.userPolicy.filesystem // {}) as $filesystem
      | if ($filesystem | has($name)) then
          ($filesystem[$name] | type)
        else
          "missing"
        end
    ' "${input_path}"
  )"
  case "${path_type}" in
  missing|null|array)
    ;;
  *)
    echo "Error: ${settings_path} has a non-array sandbox.userPolicy.filesystem.${path_name} (${path_type}); refusing to overwrite it. Fix or remove the value and re-run chezmoi apply." >&2
    exit 1
    ;;
  esac
done

jq \
  --arg home "${HOME}" \
  --arg mise_data_dir "${mise_data_dir}" \
  --arg external_mise_installs "${external_mise_installs}" \
  --arg copilot_uv_cache_dir "${copilot_uv_cache_dir}" \
  --slurpfile desired "${desired}" '
  def expand_home:
    if type != "string" then
      .
    elif . == "~" then
      $home
    elif startswith("~/") then
      $home + .[1:]
    else
      .
    end;

  def normalize_path:
    expand_home
    | if type != "string" then
        .
      else
        . as $path
        | ($path | startswith("/")) as $absolute
        | reduce ($path | split("/")[]) as $part
            ([];
              if $part == "" or $part == "." then
                .
              elif $part == ".." then
                if length > 0 and .[-1] != ".." then
                  .[0:-1]
                elif $absolute then
                  .
                else
                  . + [$part]
                end
              else
                . + [$part]
              end
            )
        | join("/")
        | if $absolute then "/" + . else . end
        | if . == "" and $absolute then "/" else . end
      end;

  def contains_path($paths; $path):
    any($paths[]?;
      type == "string" and
      (normalize_path == ($path | normalize_path))
    );

  def contains_or_is_parent($paths; $path):
    ($path | normalize_path) as $normalized_path
    | any($paths[]?;
        type == "string" and (
          (normalize_path) as $candidate
          | $candidate != "" and (
              $candidate == $normalized_path or
              $candidate == "/" or
              ($normalized_path | startswith($candidate + "/"))
            )
        )
      );

  def append_managed_readonly($path):
    if $path == "" then
      .
    elif contains_or_is_parent(.deniedPaths; $path) then
      error("sandbox.userPolicy.filesystem.deniedPaths conflicts with managed mise path: \($path)")
    elif contains_path(.readwritePaths; $path) or contains_path(.readonlyPaths; $path) then
      .
    else
      .readonlyPaths += [$path]
    end;

  def append_managed_readwrite($path):
    if contains_or_is_parent(.deniedPaths; $path) then
      error("sandbox.userPolicy.filesystem.deniedPaths conflicts with managed Copilot uv cache path: \($path)")
    elif contains_or_is_parent(.readonlyPaths; $path) then
      error("sandbox.userPolicy.filesystem.readonlyPaths conflicts with managed Copilot uv cache path: \($path)")
    elif contains_path(.readwritePaths; $path) then
      .
    else
      .readwritePaths += [$path]
    end;

  . * $desired[0]
  | .sandbox = (
    (.sandbox // {})
    | .userPolicy = (
      (.userPolicy // {})
      | del(.version)
      | .filesystem = (
        (.filesystem // {})
        | .readwritePaths = (.readwritePaths // [])
        | .readonlyPaths = (.readonlyPaths // [])
        | .deniedPaths = (.deniedPaths // [])
        | append_managed_readonly($mise_data_dir)
        | append_managed_readonly($external_mise_installs)
        | append_managed_readwrite($copilot_uv_cache_dir)
        | .clearPolicyOnExit = false
      )
      | .network = (
        (.network // {})
        | del(.allowedHosts, .blockedHosts)
      )
    )
  )
' "${input_path}" >"${merged}"

for managed_cache_path in "${copilot_uv_cache_parent}" "${copilot_uv_cache_dir}"; do
  if [ -L "${managed_cache_path}" ]; then
    echo "Error: managed Copilot uv cache path is a symbolic link: ${managed_cache_path}" >&2
    exit 1
  fi
done
mkdir -p "${mise_data_dir}" "${mise_installs}" "${copilot_uv_cache_dir}"
for managed_cache_path in "${copilot_uv_cache_parent}" "${copilot_uv_cache_dir}"; do
  if [ -L "${managed_cache_path}" ]; then
    echo "Error: managed Copilot uv cache path is a symbolic link: ${managed_cache_path}" >&2
    exit 1
  fi
done

jq --argjson enabled "${existing_enabled}" '.sandbox.enabled = $enabled' "${merged}" >"${settings_tmp}"

jq -e . "${settings_tmp}" >/dev/null
mv -f "${settings_tmp}" "${settings_path}"
echo "Configured Copilot CLI local sandbox in ${settings_path}"
{{- end -}}
