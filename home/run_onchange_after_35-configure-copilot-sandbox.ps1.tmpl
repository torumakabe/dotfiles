{{- if eq .chezmoi.os "windows" -}}
# Copilot CLI local sandbox 設定 (Windows)
#
# Copilot sandbox policy version: 7

$ErrorActionPreference = 'Stop'

$copilotHome = if ($env:COPILOT_HOME) { $env:COPILOT_HOME } else { Join-Path $HOME '.copilot' }
$settingsPath = Join-Path $copilotHome 'settings.json'
$settingsDir = Split-Path -Parent $settingsPath

$desiredSettings = @'
{{ include ".chezmoitemplates/copilot-user-settings.json" }}
'@ | ConvertFrom-Json

function Fail-SandboxSettings {
  param([Parameter(Mandatory = $true)] [string] $Message)

  Write-Error "Copilot sandbox settings: $Message"
  exit 1
}

if (Test-Path -LiteralPath $settingsPath) {
  try {
    $settings = Get-Content -LiteralPath $settingsPath -Raw | ConvertFrom-Json
  } catch {
    Fail-SandboxSettings "Failed to parse $settingsPath as JSON. Configure Copilot sandbox manually or remove JSONC comments before chezmoi apply."
  }
} else {
  $settings = [pscustomobject]@{}
}

function Set-JsonProperty {
  param(
    [Parameter(Mandatory = $true)] [object] $Object,
    [Parameter(Mandatory = $true)] [string] $Name,
    [Parameter(Mandatory = $true)] $Value
  )

  if ($Object.PSObject.Properties[$Name]) {
    $Object.$Name = $Value
  } else {
    Add-Member -InputObject $Object -NotePropertyName $Name -NotePropertyValue $Value
  }
}

function Get-JsonArrayOrEmpty {
  param($Value)
  if ($null -eq $Value) { return ,@() }
  return ,@($Value)
}

function Get-JsonProperty {
  param(
    $Object,
    [Parameter(Mandatory = $true)] [string] $Name
  )

  if ($null -eq $Object) { return $null }
  $prop = $Object.PSObject.Properties[$Name]
  if ($null -eq $prop) { return $null }
  return $prop.Value
}

function Merge-JsonObject {
  param(
    [Parameter(Mandatory = $true)] [object] $Target,
    [Parameter(Mandatory = $true)] [object] $Source
  )

  foreach ($property in $Source.PSObject.Properties) {
    $targetProperty = $Target.PSObject.Properties[$property.Name]
    if (
      $null -ne $targetProperty -and
      $targetProperty.Value -is [pscustomobject] -and
      $property.Value -is [pscustomobject]
    ) {
      Merge-JsonObject -Target $targetProperty.Value -Source $property.Value
    } else {
      Set-JsonProperty -Object $Target -Name $property.Name -Value $property.Value
    }
  }
}

function Remove-JsonProperty {
  param(
    $Object,
    [Parameter(Mandatory = $true)] [string] $Name
  )

  if ($null -ne $Object -and $Object.PSObject.Properties[$Name]) {
    $Object.PSObject.Properties.Remove($Name)
  }
}

function Resolve-WindowsPolicyPath {
  param(
    [Parameter(Mandatory = $true)] [string] $PathValue,
    [Parameter(Mandatory = $true)] [string] $PathName,
    [string] $HomeDir,
    [switch] $AllowTilde,
    [switch] $RequireExistingDirectory
  )

  if ($null -eq $PathValue) {
    $PathValue = ''
  }
  if ($PathValue.IndexOfAny(@([char]13, [char]10)) -ge 0) {
    Fail-SandboxSettings "$PathName must be single-line."
  }

  $candidate = $PathValue
  if ($AllowTilde) {
    if ($candidate -eq '~') {
      $candidate = $HomeDir
    } elseif ($candidate.StartsWith('~/') -or $candidate.StartsWith('~\')) {
      $candidate = Join-Path $HomeDir (($candidate.Substring(2)) -replace '/', '\')
    }
  }

  if (
    [string]::IsNullOrEmpty($candidate) -or
    $candidate.StartsWith('\\') -or
    $candidate.StartsWith('//') -or
    $candidate.StartsWith('\\?\') -or
    $candidate.StartsWith('//?/') -or
    $candidate -notmatch '^[A-Za-z]:[\\/].*'
  ) {
    Fail-SandboxSettings "$PathName must be a local absolute, single-line directory."
  }

  $suffix = $candidate.Substring(3)
  if (
    $suffix -match '[\\/]{2,}' -or
    $suffix -match '(^|[\\/])\.(?:[\\/]|$)' -or
    $suffix -match '(^|[\\/])\.\.(?:[\\/]|$)'
  ) {
    Fail-SandboxSettings "$PathName must not contain redundant separators or '.'/'..' components."
  }

  $normalized = '{0}\{1}' -f $candidate.Substring(0, 2), ($suffix -replace '/', '\')
  $root = [System.IO.Path]::GetPathRoot($normalized)
  $rootItem = Get-Item -LiteralPath $root -Force -ErrorAction Stop
  if (-not $rootItem.PSIsContainer) {
    Fail-SandboxSettings "$PathName must not contain non-directories: $root"
  }
  if ($rootItem.Attributes -band [System.IO.FileAttributes]::ReparsePoint) {
    Fail-SandboxSettings "$PathName must not contain symlinks or reparse points: $root"
  }

  $current = $rootItem.FullName
  $hasMissingAncestor = $false
  foreach ($component in ([regex]::Split($normalized.Substring($root.Length), '[\\/]') | Where-Object { $_ -ne '' })) {
    $next = Join-Path $current $component
    if (-not $hasMissingAncestor -and (Test-Path -LiteralPath $next)) {
      $item = Get-Item -LiteralPath $next -Force -ErrorAction Stop
      if (-not $item.PSIsContainer) {
        Fail-SandboxSettings "$PathName must not contain non-directories: $next"
      }
      if ($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint) {
        Fail-SandboxSettings "$PathName must not contain symlinks or reparse points: $next"
      }
      $current = $item.FullName
    } else {
      $hasMissingAncestor = $true
      $current = $next
    }
  }

  if ($RequireExistingDirectory) {
    $finalItem = Get-Item -LiteralPath $current -Force -ErrorAction Stop
    if (-not $finalItem.PSIsContainer) {
      Fail-SandboxSettings "$PathName must resolve to a non-root, single-line directory."
    }
    $current = $finalItem.FullName
    if ($current.IndexOfAny(@([char]13, [char]10)) -ge 0) {
      Fail-SandboxSettings "$PathName must resolve to a non-root, single-line directory."
    }
    $resolvedRoot = [System.IO.Path]::GetPathRoot($current)
    if ($resolvedRoot.TrimEnd('\') -ceq $current.TrimEnd('\')) {
      Fail-SandboxSettings "$PathName must not resolve to a drive root."
    }
  }

  return $current
}

function Test-PathPrefix {
  param(
    [Parameter(Mandatory = $true)] [string] $Path,
    [Parameter(Mandatory = $true)] [string] $Prefix
  )

  $normalizedPath = (($Path -replace '/', '\').TrimEnd('\')) + '\'
  $normalizedPrefix = (($Prefix -replace '/', '\').TrimEnd('\')) + '\'
  return $normalizedPath.StartsWith($normalizedPrefix, [System.StringComparison]::OrdinalIgnoreCase)
}

if ($env:UV_CACHE_DIR) {
  Fail-SandboxSettings "Unset launch-environment UV_CACHE_DIR before applying settings and starting Copilot; command-local overrides remain supported."
}

$homeSource = if ($env:USERPROFILE) { $env:USERPROFILE } elseif ($HOME) { $HOME } else { '' }
$homeDir = Resolve-WindowsPolicyPath -PathValue $homeSource -PathName 'HOME' -RequireExistingDirectory
$localAppDataDir = Resolve-WindowsPolicyPath -PathValue $env:LOCALAPPDATA -PathName 'LOCALAPPDATA' -RequireExistingDirectory
$uvCacheDir = Join-Path (Join-Path $localAppDataDir 'github-copilot') 'uv'
$cacheCovered = $false

# `/sandbox disable` persists sandbox.enabled=$false in settings.json, and that
# must survive this template update until `/sandbox enable` restores it.
# PSObject.Properties['enabled'] must be inspected on the pre-merge object,
# because Merge-JsonObject below would otherwise let the desired template's
# `true` win over a pre-existing `false`. A present-but-non-boolean value
# fails explicitly instead of being silently coerced.
$preMergeSandbox = Get-JsonProperty -Object $settings -Name 'sandbox'
$preMergeEnabledProperty = if ($null -ne $preMergeSandbox) { $preMergeSandbox.PSObject.Properties['enabled'] } else { $null }

$preserveEnabled = $false
$preservedEnabledValue = $null
if ($null -ne $preMergeEnabledProperty) {
$preMergeEnabledValue = $preMergeEnabledProperty.Value
if ($preMergeEnabledValue -is [bool]) {
  $preserveEnabled = $true
  $preservedEnabledValue = $preMergeEnabledValue
} else {
  $enabledTypeDescription = if ($null -eq $preMergeEnabledValue) { 'null' } else { $preMergeEnabledValue.GetType().Name }
  Fail-SandboxSettings "$settingsPath has a non-boolean sandbox.enabled ($enabledTypeDescription); refusing to overwrite it. Fix or remove the value and re-run chezmoi apply."
}
}

$preMergePolicy = Get-JsonProperty -Object $preMergeSandbox -Name 'userPolicy'
$preMergeFilesystem = Get-JsonProperty -Object $preMergePolicy -Name 'filesystem'
foreach ($pathName in @('readwritePaths', 'readonlyPaths', 'deniedPaths')) {
  $pathProperty = if ($null -ne $preMergeFilesystem) {
    $preMergeFilesystem.PSObject.Properties[$pathName]
  } else {
    $null
  }
  if ($null -ne $pathProperty -and $null -ne $pathProperty.Value -and $pathProperty.Value -isnot [array]) {
    $pathTypeDescription = $pathProperty.Value.GetType().Name
    Fail-SandboxSettings "$settingsPath has a non-array sandbox.userPolicy.filesystem.$pathName ($pathTypeDescription); refusing to overwrite it. Fix or remove the value and re-run chezmoi apply."
  }

  $pathValues = if ($null -ne $pathProperty) { $pathProperty.Value } else { $null }
  foreach ($rule in (Get-JsonArrayOrEmpty $pathValues)) {
    if ($rule -isnot [string] -or [string]::IsNullOrEmpty($rule) -or $rule.IndexOfAny(@([char]13, [char]10)) -ge 0) {
      Fail-SandboxSettings "$pathName must contain nonempty, single-line path strings."
    }
    $resolvedRule = Resolve-WindowsPolicyPath -PathValue $rule -PathName 'policy path' -HomeDir $homeDir -AllowTilde
    if (Test-PathPrefix -Path $uvCacheDir -Prefix $resolvedRule) {
      if ($pathName -eq 'readwritePaths') {
        $cacheCovered = $true
      } else {
        Fail-SandboxSettings "uv cache $uvCacheDir conflicts with $pathName rule $rule; no permission was changed."
      }
    }
    if ($pathName -ne 'readwritePaths' -and (Test-PathPrefix -Path $resolvedRule -Prefix $uvCacheDir)) {
      Fail-SandboxSettings "uv cache $uvCacheDir contains $pathName rule $rule; no permission was changed."
    }
  }
}

# This template renders only on native Windows. Codespaces and Dev Containers
# use the POSIX template, which applies their environment-specific false default.
Merge-JsonObject -Target $settings -Source $desiredSettings

$existingSandbox = Get-JsonProperty -Object $settings -Name 'sandbox'
$existingPolicy = Get-JsonProperty -Object $existingSandbox -Name 'userPolicy'
$existingFilesystem = Get-JsonProperty -Object $existingPolicy -Name 'filesystem'
$existingNetwork = Get-JsonProperty -Object $existingPolicy -Name 'network'

$sandbox = if ($null -ne $existingSandbox) { $existingSandbox } else { [pscustomobject]@{} }
$userPolicy = if ($null -ne $existingPolicy) { $existingPolicy } else { [pscustomobject]@{} }
$filesystem = if ($null -ne $existingFilesystem) { $existingFilesystem } else { [pscustomobject]@{} }
$network = if ($null -ne $existingNetwork) { $existingNetwork } else { [pscustomobject]@{} }

$readwritePaths = @(
  (Get-JsonArrayOrEmpty (Get-JsonProperty -Object $existingFilesystem -Name 'readwritePaths')) +
  $(if ($cacheCovered) { @() } else { @($uvCacheDir) })
)
Set-JsonProperty -Object $filesystem -Name 'readwritePaths' -Value $readwritePaths
Set-JsonProperty -Object $filesystem -Name 'readonlyPaths' -Value (Get-JsonArrayOrEmpty (Get-JsonProperty -Object $existingFilesystem -Name 'readonlyPaths'))
Set-JsonProperty -Object $filesystem -Name 'deniedPaths' -Value (Get-JsonArrayOrEmpty (Get-JsonProperty -Object $existingFilesystem -Name 'deniedPaths'))
Set-JsonProperty -Object $filesystem -Name 'clearPolicyOnExit' -Value $false

Set-JsonProperty -Object $network -Name 'allowOutbound' -Value $true
Set-JsonProperty -Object $network -Name 'allowLocalNetwork' -Value $true
Remove-JsonProperty -Object $network -Name 'allowedHosts'
Remove-JsonProperty -Object $network -Name 'blockedHosts'

Set-JsonProperty -Object $userPolicy -Name 'filesystem' -Value $filesystem
Set-JsonProperty -Object $userPolicy -Name 'network' -Value $network
Remove-JsonProperty -Object $userPolicy -Name 'version'
Set-JsonProperty -Object $sandbox -Name 'userPolicy' -Value $userPolicy
if ($preserveEnabled) {
  Set-JsonProperty -Object $sandbox -Name 'enabled' -Value $preservedEnabledValue
}

Set-JsonProperty -Object $settings -Name 'sandbox' -Value $sandbox

New-Item -ItemType Directory -Path $uvCacheDir -Force | Out-Null
New-Item -ItemType Directory -Path $settingsDir -Force | Out-Null

$settingsJson = $settings | ConvertTo-Json -Depth 100
$temporaryPath = Join-Path $settingsDir ([System.IO.Path]::GetRandomFileName())
$backupPath = $null
try {
  $encoding = [System.Text.UTF8Encoding]::new($false)
  $stream = [System.IO.File]::Open(
    $temporaryPath,
    [System.IO.FileMode]::CreateNew,
    [System.IO.FileAccess]::Write,
    [System.IO.FileShare]::None
  )
  try {
    $writer = [System.IO.StreamWriter]::new($stream, $encoding)
    try {
      $writer.WriteLine($settingsJson)
    } finally {
      $writer.Dispose()
    }
  } finally {
    $stream.Dispose()
  }

  [void](Get-Content -LiteralPath $temporaryPath -Raw | ConvertFrom-Json)

  $destinationItem = Get-Item -LiteralPath $settingsPath -Force -ErrorAction SilentlyContinue
  if ($destinationItem) {
    if ($destinationItem.PSIsContainer) {
      throw "Refusing to replace a directory: $settingsPath"
    }
    if ($destinationItem.Attributes -band [System.IO.FileAttributes]::ReparsePoint) {
      [System.IO.File]::Move($temporaryPath, $settingsPath, $true)
    } else {
      $backupPath = Join-Path $settingsDir ([System.IO.Path]::GetRandomFileName())
      [System.IO.File]::Replace($temporaryPath, $settingsPath, $backupPath)
    }
  } else {
    [System.IO.File]::Move($temporaryPath, $settingsPath)
  }
} finally {
  Remove-Item -LiteralPath $temporaryPath -Force -ErrorAction SilentlyContinue
  if ($backupPath) {
    Remove-Item -LiteralPath $backupPath -Force -ErrorAction SilentlyContinue
  }
}

Write-Host "Configured Copilot CLI local sandbox in $settingsPath"
{{- end -}}
