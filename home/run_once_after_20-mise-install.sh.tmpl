{{ if ne .chezmoi.os "windows" -}}
#!/bin/bash
set -euo pipefail

# Activate mise and install tool versions from config
# Order dependency:
# - Keep this after run_once_before_20-install-mise because `mise` must already exist.
# - Keep this in the `after_` phase because chezmoi must first apply
#   ~/.config/mise/config.toml and ~/.config/mise/mise.lock.
# - Keep run_once_after_30-install-tools after this script because it relies on runtimes
#   and shims installed by `mise install`.
export PATH="${HOME}/.local/bin:${PATH}"

if ! command -v mise >/dev/null 2>&1; then
  echo "mise not found, skipping tool installation"
  exit 0
fi

{{ if and .devcontainer (not .codespaces) -}}
# Dev container (非 Codespaces): コンテナ作成時は gh が未認証のため
# GITHUB_TOKEN を取得できず、レート制限に抵触する。mise install はスキップし、
# コンテナ起動後にユーザーが gh auth login してから手動実行する。
echo "Dev container detected — skipping mise install"
echo "Run the following after container creation:"
echo "  gh auth login"
echo "  GITHUB_TOKEN=\$(gh auth token) mise install --yes"
exit 0
{{ end -}}

# gh が認証済みなら GITHUB_TOKEN を自動設定してレート制限を回避する
if [ -z "${GITHUB_TOKEN:-}" ] && command -v gh >/dev/null 2>&1; then
  if gh auth status >/dev/null 2>&1; then
    GITHUB_TOKEN="$(gh auth token 2>/dev/null)" && export GITHUB_TOKEN
    echo "Using GitHub token from gh CLI"
  fi
fi

lockfile="${HOME}/.config/mise/mise.lock"
lockfile_backup=""

restore_lockfile() {
  status=$?
  trap - EXIT
  if [ -n "${lockfile_backup}" ]; then
    if ! cmp -s "${lockfile_backup}" "${lockfile}"; then
      if cp -p "${lockfile_backup}" "${lockfile}"; then
        echo 'Restored managed mise lockfile after installation.'
      else
        echo "ERROR: failed to restore managed mise lockfile: ${lockfile}" >&2
        status=1
      fi
    fi
    rm -f "${lockfile_backup}"
  fi
  exit "${status}"
}

if [ -f "${lockfile}" ]; then
  if ! lockfile_backup="$(mktemp)"; then
    echo 'ERROR: failed to create mise lockfile backup.' >&2
    exit 1
  fi
  if ! cp -p "${lockfile}" "${lockfile_backup}"; then
    rm -f "${lockfile_backup}"
    echo 'ERROR: failed to back up managed mise lockfile.' >&2
    exit 1
  fi
  trap restore_lockfile EXIT
fi

max_attempts=3
attempt=1
wait_sec=10
missing_marker='(missing)'

echo "Installing tool versions via mise..."
while [ "$attempt" -le "$max_attempts" ]; do
  if mise install --yes 2>&1; then
    echo "mise install completed successfully"
    break
  fi

  if ! missing_tools_output="$(mise ls --missing 2>/dev/null)"; then
    echo "Warning: failed to inspect missing tools after mise install attempt ${attempt}/${max_attempts}. Retrying..." >&2
    missing_count=1
  else
    missing_count="$(printf '%s\n' "$missing_tools_output" | awk -v marker="$missing_marker" 'BEGIN {count=0} index($0, marker) {count++} END {print count+0}')"
  fi

  if [ "$missing_count" -eq 0 ]; then
    echo "All tools installed successfully"
    break
  fi

  if [ "$attempt" -lt "$max_attempts" ]; then
    echo "Attempt ${attempt}/${max_attempts}: ${missing_count} tool(s) remaining. Retrying in ${wait_sec}s..."
    sleep "$wait_sec"
    wait_sec=$((wait_sec * 2))
  fi

  attempt=$((attempt + 1))
done

# 最終チェック
if ! missing_tools="$(mise ls --missing 2>/dev/null)"; then
  echo "ERROR: failed to inspect final mise installation status." >&2
  exit 1
elif echo "$missing_tools" | grep -F -q "$missing_marker"; then
  echo "" >&2
  echo "========================================" >&2
  echo "WARNING: mise install が一部失敗しました" >&2
  echo "========================================" >&2
  echo "$missing_tools" >&2
  echo "" >&2
  echo "リトライ: mise install" >&2
  echo "========================================" >&2
  exit 1
fi
{{ end -}}
