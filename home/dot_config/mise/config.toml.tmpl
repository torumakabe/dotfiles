[tools]
go = "latest"
terraform = "latest"
kubectl = "latest"
helm = "latest"
trivy = "latest"
node = "lts"
uv = "latest"
fzf = "latest"
github-cli = "latest"
1password = "latest"
cue = "latest"
ghq = "latest"
azure-kubelogin = "latest"
yq = "latest"
sqlc = "latest"
cosign = "latest"
golangci-lint = "latest"
kustomize = "latest"
ripgrep = "latest"
zoxide = "latest"
bat = "latest"
shellcheck = "latest"
gitleaks = "latest"
jq = "latest"
bun = "latest"
"npm:typescript" = "latest"
"npm:typescript-language-server" = "latest"
codex = "latest"
{{ if not (and (eq .chezmoi.os "linux") (eq .chezmoi.arch "arm64")) -}}
# プリビルドバイナリが linux/arm64 未提供のためスキップ
cargo-make = "latest"
{{ end -}}

[tools.dotnet]
version = "latest"
{{ if eq .chezmoi.os "windows" -}}
# core:dotnet の install-time verification が system dotnet を拾わないよう、
# mise の共有 root を検証コマンドの PATH 先頭へ置く。
install_env = { DOTNET_ROOT = '{{ env "LOCALAPPDATA" }}\mise\dotnet-root', PATH = '{{ env "LOCALAPPDATA" }}\mise\dotnet-root;$PATH' }
{{ end -}}

[settings]
experimental = true
lockfile = true
# auto-lock と `--platform` 未指定の `mise lock` が使う基準集合を固定する。
# 未指定だと mise install の auto-lock が musl を含む既定集合を書き足し、
# chezmoi apply が lockfile の差分を検知して非対話環境で停止する。
# 実行中のプラットフォームは、この配列に無くても必ず対象へ加わる。
lockfile_platforms = ["linux-x64", "linux-arm64", "macos-arm64", "windows-x64", "windows-arm64"]
fetch_remote_versions_timeout = "60s"

[tool_alias]
dotnet = "core:dotnet"
