{{- if eq .chezmoi.os "windows" -}}
{{- $platform := printf "%s-%s" .chezmoi.os .chezmoi.arch -}}
$ErrorActionPreference = 'Stop'
$toolVersion = '{{ .onePassword.version }}'
{{ if not (hasKey .onePassword.assets $platform) }}
throw "1Password CLI $toolVersion has no asset for {{ $platform }}"
{{ else }}
{{- $asset := index .onePassword.assets $platform }}
$binDir = Join-Path $HOME '.local\bin'
$target = Join-Path $binDir 'op.exe'
$miseTarget = Join-Path $env:LOCALAPPDATA 'mise\shims\op.exe'
$platformArch = '{{ .chezmoi.arch }}'
$executableArch = '{{ $asset.executableArch }}'
$emulated = [System.Convert]::ToBoolean('{{ $asset.emulated }}')
$assetFile = '{{ $asset.file }}'
$assetUrl = '{{ $asset.url }}'
$assetSha256 = '{{ $asset.sha256 }}'
$assetEntry = '{{ $asset.entry }}'
$expectedSubject = '{{ .onePassword.windowsVerification.subject }}'
$expectedIssuer = '{{ .onePassword.windowsVerification.issuer }}'
$expectedEku = '{{ .onePassword.windowsVerification.eku }}'

if ($executableArch -cne $platformArch -and
    -not ($platformArch -ceq 'arm64' -and $executableArch -ceq 'amd64' -and $emulated)) {
    throw "unsupported 1Password CLI architecture declaration: $executableArch on $platformArch"
}

function ConvertTo-NormalizedPath {
    param([string]$Path, [string]$BasePath)
    if (-not [System.IO.Path]::IsPathRooted($Path)) { $Path = Join-Path $BasePath $Path }
    return [System.IO.Path]::GetFullPath($Path).Replace('\', '/').TrimEnd('/')
}

function Assert-TargetReplaceable {
    $item = Get-Item -LiteralPath $target -Force -ErrorAction SilentlyContinue
    if (-not $item) { return 'Missing' }
    if ($item.PSIsContainer) { throw "$target is a directory; refusing to replace it." }
    if ($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint) {
        $linkTarget = [string]@($item.Target)[0]
        if (-not [System.IO.Path]::IsPathRooted($linkTarget)) {
            $linkTarget = Join-Path $item.DirectoryName $linkTarget
        }
        if ((ConvertTo-NormalizedPath $linkTarget $item.DirectoryName) -ine
            (ConvertTo-NormalizedPath $miseTarget $item.DirectoryName)) {
            throw "$target is a foreign symlink; refusing to replace it."
        }
        return 'MiseLink'
    }
    if (-not (Test-Path -LiteralPath $target -PathType Leaf)) {
        throw "$target is not a regular file; refusing to replace it."
    }
    return 'File'
}

function Test-BinaryArchitecture {
    param([string]$Path)
    $item = Get-Item -LiteralPath $Path -Force -ErrorAction SilentlyContinue
    if (-not $item -or $item.PSIsContainer -or
        ($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint)) { return $false }
    $stream = $null
    $reader = $null
    try {
        $stream = [System.IO.File]::OpenRead($Path)
        $reader = [System.IO.BinaryReader]::new($stream)
        if ($stream.Length -lt 64 -or $reader.ReadUInt16() -ne 0x5A4D) { return $false }
        $stream.Position = 0x3c
        $peOffset = $reader.ReadUInt32()
        if ($peOffset -gt ($stream.Length - 6)) { return $false }
        $stream.Position = $peOffset
        if ($reader.ReadUInt32() -ne 0x00004550) { return $false }
        $machine = $reader.ReadUInt16()
        $expectedMachine = if ($executableArch -ceq 'amd64') { 0x8664 } else { 0xAA64 }
        return $machine -eq $expectedMachine
    }
    catch [System.IO.IOException] { return $false }
    catch [System.UnauthorizedAccessException] { return $false }
    catch [System.Security.SecurityException] { return $false }
    finally {
        if ($reader) { $reader.Dispose() } elseif ($stream) { $stream.Dispose() }
    }
}

function Test-AuthenticodeIdentity {
    param([string]$Path)
    try {
        $signature = Get-AuthenticodeSignature -LiteralPath $Path
    }
    catch [System.Management.Automation.CommandNotFoundException] { return $false }
    catch [System.IO.IOException] { return $false }
    catch [System.UnauthorizedAccessException] { return $false }
    catch [System.Security.SecurityException] { return $false }
    if ($signature.Status -ne [System.Management.Automation.SignatureStatus]::Valid -or
        -not $signature.SignerCertificate) { return $false }
    $certificate = $signature.SignerCertificate
    if ($certificate.Subject -cne $expectedSubject -or $certificate.Issuer -cne $expectedIssuer) {
        return $false
    }
    return @($certificate.EnhancedKeyUsageList |
        ForEach-Object { $_.ObjectId.Value }).Contains($expectedEku)
}

function Test-ExpectedVersion {
    param([string]$Path, [string]$WorkingDirectory)
    $oldHome = $env:HOME
    $oldProfile = $env:USERPROFILE
    $probeHome = Join-Path $WorkingDirectory 'probe-home'
    New-Item -ItemType Directory -Force -Path $probeHome | Out-Null
    Push-Location -LiteralPath $WorkingDirectory
    try {
        $env:HOME = $probeHome
        $env:USERPROFILE = $probeHome
        $output = & $Path --version 2>$null
        if ($LASTEXITCODE -ne 0) { return $false }
    }
    catch [System.Management.Automation.CommandNotFoundException] { return $false }
    catch [System.Management.Automation.ApplicationFailedException] { return $false }
    catch [System.ComponentModel.Win32Exception] { return $false }
    catch [System.IO.IOException] { return $false }
    catch [System.UnauthorizedAccessException] { return $false }
    finally {
        $env:HOME = $oldHome
        $env:USERPROFILE = $oldProfile
        Pop-Location
    }
    return @($output).Count -eq 1 -and ([string]$output).Trim() -ceq $toolVersion
}

function Assert-Unlocked {
    if ((Assert-TargetReplaceable) -ne 'File') { return }
    try {
        $stream = [System.IO.File]::Open(
            $target, [System.IO.FileMode]::Open, [System.IO.FileAccess]::ReadWrite,
            [System.IO.FileShare]::None)
        $stream.Dispose()
    }
    catch {
        throw "$target cannot be replaced because it is locked; the existing file was not changed."
    }
}

function Extract-ExactZipEntry {
    param([string]$Archive, [string]$EntryName, [string]$Output)
    if ([System.IO.Path]::IsPathRooted($EntryName) -or
        @($EntryName.Replace('\', '/').Split('/')).Contains('..')) {
        throw "unsafe archive entry $EntryName"
    }
    $bundle = [System.IO.Compression.ZipFile]::OpenRead($Archive)
    try {
        $matches = @($bundle.Entries | Where-Object {
            $_.FullName.Replace('\', '/') -ceq $EntryName.Replace('\', '/')
        })
        if ($matches.Count -ne 1 -or -not $matches[0].Name) {
            throw "expected exactly one regular $EntryName in the archive"
        }
        $inputStream = $matches[0].Open()
        $outputStream = [System.IO.File]::Create($Output)
        try { $inputStream.CopyTo($outputStream) }
        finally {
            $outputStream.Dispose()
            $inputStream.Dispose()
        }
    }
    finally { $bundle.Dispose() }
}

$state = Assert-TargetReplaceable
if ($state -eq 'File' -and (Test-BinaryArchitecture $target) -and
    (Test-AuthenticodeIdentity $target) -and (Test-ExpectedVersion $target $binDir)) {
    exit 0
}

New-Item -ItemType Directory -Force -Path $binDir | Out-Null
$stageDir = Join-Path $binDir ('.op-install.' + [System.IO.Path]::GetRandomFileName())
New-Item -ItemType Directory -Path $stageDir | Out-Null
try {
    $archive = Join-Path $stageDir 'download.zip'
    Invoke-WebRequest -Uri $assetUrl -OutFile $archive -UseBasicParsing
    if ((Get-FileHash -LiteralPath $archive -Algorithm SHA256).Hash.ToLowerInvariant() -ne $assetSha256) {
        throw "checksum verification failed for $assetFile"
    }
    $candidate = Join-Path $stageDir 'op.exe'
    Extract-ExactZipEntry $archive $assetEntry $candidate
    $candidateItem = Get-Item -LiteralPath $candidate -Force -ErrorAction SilentlyContinue
    if (-not $candidateItem -or $candidateItem.PSIsContainer -or
        ($candidateItem.Attributes -band [System.IO.FileAttributes]::ReparsePoint)) {
        throw "$assetEntry is not a regular file in $assetFile"
    }
    if (-not (Test-BinaryArchitecture $candidate)) {
        throw "$assetFile does not contain the declared $executableArch executable"
    }
    if (-not (Test-AuthenticodeIdentity $candidate)) {
        throw "$assetFile does not contain an authentic 1Password CLI executable"
    }
    Unblock-File -LiteralPath $candidate
    if (-not (Test-ExpectedVersion $candidate $stageDir)) {
        throw "$assetFile did not report 1Password CLI $toolVersion"
    }
    Assert-Unlocked
    Assert-TargetReplaceable | Out-Null
    [System.IO.File]::Move($candidate, $target, $true)
}
finally {
    Remove-Item -LiteralPath $stageDir -Recurse -Force -ErrorAction SilentlyContinue
}
{{ end }}
{{- end }}
