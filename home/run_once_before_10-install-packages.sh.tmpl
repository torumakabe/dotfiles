{{ if ne .chezmoi.os "windows" -}}
#!/bin/bash
set -euo pipefail

# System packages — runs once before chezmoi applies dotfiles
# Order dependency:
# - Keep this before run_once_before_20-install-mise so git/zsh/curl are available first.
# - When changing packages here, confirm the later shell setup and mise bootstrap still
#   have the commands they expect on each platform.
export DEBIAN_FRONTEND=noninteractive

download_file() {
  local url=$1
  local output=$2
  curl --proto '=https' --tlsv1.2 -fsSL -o "${output}" "${url}"
}

sha256_file() {
  local file=$1

  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "${file}" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "${file}" | awk '{print $1}'
  else
    echo "error: sha256sum or shasum required to verify downloads" >&2
    exit 1
  fi
}

make_install_tmp_dir() {
  local tmp_root="${XDG_RUNTIME_DIR:-${HOME}/.cache}/dotfiles-install"
  mkdir -p "${tmp_root}"
  chmod 700 "${tmp_root}"
  mktemp -d "${tmp_root}/run.XXXXXX"
}

# gh はベンダーのパッケージマネージャーが所有する。未導入か、本リポジトリが要求する
# 最小版 (home/.chezmoidata.toml の githubCli.minimumVersion) 未満のときだけ導入・更新する。
# 最小版以上は更新しない。
GH_MINIMUM_VERSION="{{ .githubCli.minimumVersion }}"

version_ge() {
  local left="${1%%[-+]*}" right="${2%%[-+]*}"
  local index left_field right_field
  local -a left_parts right_parts

  IFS='.' read -r -a left_parts <<<"${left}"
  IFS='.' read -r -a right_parts <<<"${right}"
  for index in 0 1 2; do
    left_field=$((10#${left_parts[index]:-0}))
    right_field=$((10#${right_parts[index]:-0}))
    if [ "${left_field}" -gt "${right_field}" ]; then
      return 0
    fi
    if [ "${left_field}" -lt "${right_field}" ]; then
      return 1
    fi
  done
  return 0
}

gh_meets_minimum() {
  local binary=$1
  local installed

  [ -x "${binary}" ] || return 1
  installed="$("${binary}" --version 2>/dev/null | awk 'NR == 1 { print $3 }')"
  [ -n "${installed}" ] || return 1
  version_ge "${installed}" "${GH_MINIMUM_VERSION}"
}

apt_gh_path() {
  local binary

  dpkg-query -W -f='${db:Status-Abbrev}' gh 2>/dev/null | grep -q '^ii ' || return 1
  binary="$(dpkg-query -L gh 2>/dev/null | awk '/\/bin\/gh$/ { print; exit }')"
  [ -x "${binary}" ] || return 1
  printf '%s\n' "${binary}"
}

homebrew_gh_path() {
  local prefix

  prefix="$(brew --prefix gh 2>/dev/null)" || return 1
  [ -x "${prefix}/bin/gh" ] || return 1
  printf '%s\n' "${prefix}/bin/gh"
}

primary_key_fingerprints() {
  local key_file=$1

  gpg --batch --with-colons --import-options show-only --import "${key_file}" 2>/dev/null \
    | awk -F: '
        $1 == "pub" { primary = 1; next }
        primary && $1 == "fpr" { print $10; primary = 0 }
      '
}

azure_cli_suite() {
  case "$1" in
    bullseye|bookworm|jammy|noble)
      printf '%s\n' "$1"
      ;;
    *)
      return 1
      ;;
  esac
}

{{ if eq .chezmoi.os "linux" -}}
echo "Installing system packages via apt..."
# git: ディストロ標準の git は設定ベースフック (git >= 2.54) に届かない
# （Ubuntu 24.04 = 2.43、26.04 = 2.53 を確認）。
# ADR-020 の gitleaks フックはこの機能に依存するため、git-core PPA を使う。
# PPA が使えない環境ではディストロ版のまま続行し、設定フックは無効になる
# （chezmoi apply 時の run_after_40-check-git-hooks が警告する）。
if ! command -v add-apt-repository >/dev/null 2>&1; then
  sudo apt-get update -qq || echo "Warning: apt-get update had errors, continuing..." >&2
  sudo apt-get install -y -qq software-properties-common
fi
if ! sudo add-apt-repository -y ppa:git-core/ppa 2>/dev/null; then
  echo "Warning: could not add ppa:git-core/ppa; falling back to distro git (config-based hooks will be inactive)." >&2
fi
# サードパーティリポジトリのGPGキー期限切れ等でupdate全体が失敗することがあるため、警告に留める
if ! sudo apt-get update -qq; then
  echo "Warning: apt-get update had errors (possibly from third-party repos), continuing..." >&2
fi
sudo apt-get install -y -qq \
  bash-completion \
  bubblewrap \
{{ if eq .chezmoi.arch "arm64" -}}
  build-essential \
{{ end -}}
  curl \
  git \
  gnupg \
  keychain \
  libreoffice-impress \
  poppler-utils \
  software-properties-common \
  unzip \
  vim \
  xdg-utils \
  zsh

{{ if or .codespaces .devcontainer -}}
# PPA で入れた git を実際に解決させる。
# Codespaces と Dev Container のベースイメージは devcontainers の git feature を
# version=latest, ppa=false で使い、git をソースからビルドして prefix=/usr/local
# へ入れる。/usr/local/bin は PATH で /usr/bin より先に来るため、上の apt が
# 新しい git を入れても解決されるのは古いソースビルド版のままになる。
# イメージのビルド時点で最新だった git が 2.54 未満なら、ADR-020 の設定ベース
# フックは無効のままになる (Codespaces universal 5.1.5 = git 2.53.0 で実測)。
#
# 張り替えるのは、設定ベースフックが有効か無効かを分ける場合だけに限る。
# 隠している側が 2.54 未満で、かつ /usr/bin 側が 2.54 以上のときにしか動かない。
# イメージが要件を満たすようになれば、この処理は何もしない。
# 削除ではなく symlink へ置き換えるのは、/usr/local/bin/git を直接指す設定
# (VS Code の git.path など) をそのまま生かすためである。
# >>> git-unshadow: tests/test_git_shadow_resolution.py がこの関数を抽出して実行する
# 対象ディレクトリは呼び出し側が引数で渡す。テストが偽のディレクトリを渡せる一方、
# 実行時に環境変数で対象を差し替えられないようにするためである。
git_unshadow() {
  local unshadow_from="${1}"
  local unshadow_to="${2}"
  local unshadow_required="2.54"
  local shadowing_version target_version shadowing_path shadowing_name

  [ -x "${unshadow_from}/git" ] || return 0
  ! [ -L "${unshadow_from}/git" ] || return 0
  [ -x "${unshadow_to}/git" ] || return 0

  # 実行できない git を掴んでいても apply を止めないよう、取得できなければ空にする。
  shadowing_version="$("${unshadow_from}/git" --version 2>/dev/null | awk '{print $3}' || true)"
  target_version="$("${unshadow_to}/git" --version 2>/dev/null | awk '{print $3}' || true)"
  [ -n "${shadowing_version}" ] && [ -n "${target_version}" ] || return 0
  dpkg --compare-versions "${shadowing_version}" lt "${unshadow_required}" 2>/dev/null || return 0
  dpkg --compare-versions "${target_version}" ge "${unshadow_required}" 2>/dev/null || return 0

  echo "Redirecting ${unshadow_from} git ${shadowing_version} to ${unshadow_to} git ${target_version}..."
  for shadowing_path in "${unshadow_from}"/git "${unshadow_from}"/git-* "${unshadow_from}"/scalar; do
    shadowing_name="$(basename "${shadowing_path}")"
    # 移動先に対応が無いものは残す。git-lfs のように git 本体とは別に配布される
    # ツールを巻き込まないための条件である。
    if [ -e "${shadowing_path}" ] && [ ! -L "${shadowing_path}" ] && [ -x "${unshadow_to}/${shadowing_name}" ]; then
      sudo ln -sfn "${unshadow_to}/${shadowing_name}" "${shadowing_path}"
    fi
  done
  hash -r
}
# <<< git-unshadow
git_unshadow /usr/local/bin /usr/bin

{{ end -}}
# Copilot CLI — mise の github: バックエンドでは更新が遅れるため、
# 公式リリースを checksum 検証して導入し、更新は copilot update で行う
# 判定に command -v を使わない: Codespaces / Dev Container のベースイメージには
# /usr/local/bin/copilot が同梱されていることがあり、これを検出すると自前の導入が
# スキップされ、copilot update の対象外の古いバイナリが使われ続ける。
# 公式スクリプトは非 root で ~/.local/bin へ入れるため、その実体で判定する。
if [ ! -x "${HOME}/.local/bin/copilot" ]; then
  COPILOT_VERSION="1.0.80"
  case "$(dpkg --print-architecture)" in
    amd64)
      copilot_archive="copilot-linux-x64.tar.gz"
      expected_sha256="039933c9247686131c4406abb1d439bdbf68103edc1ff585bd70d5b0dc940f72"
      ;;
    arm64)
      copilot_archive="copilot-linux-arm64.tar.gz"
      expected_sha256="3ed85e711955e13be523bf492bc6c93b40b69925bcb7f817c9d08abf4839cf89"
      ;;
    *)
      echo "error: unsupported architecture for Copilot CLI: $(dpkg --print-architecture)" >&2
      exit 1
      ;;
  esac
  echo "Installing GitHub Copilot CLI ${COPILOT_VERSION}..."
  (
    tmp_dir="$(make_install_tmp_dir)"
    trap 'rm -rf "${tmp_dir}"' EXIT
    archive_path="${tmp_dir}/${copilot_archive}"
    if ! download_file \
      "https://github.com/github/copilot-cli/releases/download/v${COPILOT_VERSION}/${copilot_archive}" \
      "${archive_path}"; then
      echo "Warning: failed to download GitHub Copilot CLI ${COPILOT_VERSION}; skipping installation." >&2
      exit 0
    fi
    actual_sha256="$(sha256_file "${archive_path}")"
    if [ "${actual_sha256}" != "${expected_sha256}" ]; then
      echo "error: checksum verification failed for ${copilot_archive}" >&2
      exit 1
    fi
    mkdir -p "${HOME}/.local/bin"
    tar -xzf "${archive_path}" -C "${HOME}/.local/bin" copilot
    chmod 755 "${HOME}/.local/bin/copilot"
  )
fi

# GitHub CLI — mise install 前にトークン取得手段を確保する
# Codespaces もカスタム Dev Container のベースイメージに gh がない場合があるため、
# 他の Linux 環境と同じ apt 経路を使う。既存の apt 版が最小版以上なら更新しない。
vendor_gh="$(apt_gh_path || true)"
if ! gh_meets_minimum "${vendor_gh}"; then
  echo "Installing GitHub CLI ${GH_MINIMUM_VERSION} or later via apt..."
  sudo mkdir -p -m 755 /etc/apt/keyrings
  if ! curl --proto '=https' --tlsv1.2 -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | \
    sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg >/dev/null; then
    echo "Warning: failed to download the GitHub CLI repository key; skipping GitHub CLI installation." >&2
  else
    sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | \
      sudo tee /etc/apt/sources.list.d/github-cli.list >/dev/null
    if ! sudo apt-get update -qq; then
      echo "Warning: apt-get update failed for the GitHub CLI repository; skipping GitHub CLI installation." >&2
    elif ! sudo apt-get install -y -qq gh; then
      echo "Warning: failed to install GitHub CLI from apt; continue and retry after network recovery." >&2
    fi
  fi
fi

# >>> 1password-cli apt
# 1Password CLI — vendor APT repository owns the Linux installation. Existing repository
# configuration is accepted only when it already matches the pinned key, policy, and source;
# this block never overwrites a different administrator-managed configuration.
ONEPASSWORD_MINIMUM_VERSION="{{ .onePassword.minimumVersion }}"
ONEPASSWORD_APT_KEY_URL="{{ .onePassword.linuxApt.keyUrl }}"
ONEPASSWORD_APT_KEY_SHA256="{{ .onePassword.linuxApt.publicKeySha256 }}"
ONEPASSWORD_APT_KEY_FINGERPRINT="{{ .onePassword.linuxApt.primaryFingerprint }}"
ONEPASSWORD_APT_POLICY_URL="{{ .onePassword.linuxApt.policyUrl }}"
ONEPASSWORD_APT_POLICY_SHA256="{{ .onePassword.linuxApt.policySha256 }}"

onepassword_cli_meets_minimum() {
  local installed

  dpkg-query -W -f='${db:Status-Abbrev}' 1password-cli 2>/dev/null |
    grep -q '^ii ' || return 1
  [ -x /usr/bin/op ] || return 1
  installed="$(/usr/bin/op --version 2>/dev/null)" || return 1
  [ -n "${installed}" ] || return 1
  version_ge "${installed}" "${ONEPASSWORD_MINIMUM_VERSION}"
}

if ! onepassword_cli_meets_minimum; then
  case "$(dpkg --print-architecture)" in
    amd64|arm64) onepassword_arch="$(dpkg --print-architecture)" ;;
    *)
      echo "error: 1Password CLI APT repository does not support $(dpkg --print-architecture)" >&2
      exit 1
      ;;
  esac
  echo "Installing 1Password CLI ${ONEPASSWORD_MINIMUM_VERSION} or later via vendor APT..."
  (
    tmp_dir="$(make_install_tmp_dir)"
    trap 'rm -rf "${tmp_dir}"' EXIT
    key_file="${tmp_dir}/1password.asc"
    keyring_file="${tmp_dir}/1password.gpg"
    policy_file="${tmp_dir}/1password.pol"
    system_keyring=/usr/share/keyrings/1password-archive-keyring.gpg
    debsig_keyring=/usr/share/debsig/keyrings/AC2D62742012EA22/debsig.gpg
    debsig_policy=/etc/debsig/policies/AC2D62742012EA22/1password.pol
    source_file=/etc/apt/sources.list.d/1password.list
    source_line="deb [arch=${onepassword_arch} signed-by=${system_keyring}] https://downloads.1password.com/linux/debian/${onepassword_arch} stable main"

    command -v gpg >/dev/null 2>&1 || {
      echo "error: gpg is required to verify the 1Password repository key" >&2
      exit 1
    }
    download_file "${ONEPASSWORD_APT_KEY_URL}" "${key_file}" || {
      echo "error: failed to download the 1Password repository key" >&2
      exit 1
    }
    [ "$(sha256_file "${key_file}")" = "${ONEPASSWORD_APT_KEY_SHA256}" ] || {
      echo "error: checksum verification failed for the 1Password repository key" >&2
      exit 1
    }
    downloaded_fingerprints="$(
      gpg --no-options --batch --no-autostart --with-colons \
        --import-options show-only --import "${key_file}" 2>/dev/null |
        awk -F: '$1 == "pub" { primary = 1; next } primary && $1 == "fpr" { print $10; primary = 0 }'
    )" || {
      echo "error: failed to inspect the 1Password repository key" >&2
      exit 1
    }
    [ "${downloaded_fingerprints}" = "${ONEPASSWORD_APT_KEY_FINGERPRINT}" ] || {
      echo "error: 1Password repository key fingerprint verification failed" >&2
      exit 1
    }
    gpg --no-options --batch --no-autostart --dearmor \
      --output "${keyring_file}" "${key_file}" || {
      echo "error: failed to prepare the verified 1Password repository key" >&2
      exit 1
    }

    download_file "${ONEPASSWORD_APT_POLICY_URL}" "${policy_file}" || {
      echo "error: failed to download the 1Password debsig policy" >&2
      exit 1
    }
    [ "$(sha256_file "${policy_file}")" = "${ONEPASSWORD_APT_POLICY_SHA256}" ] || {
      echo "error: checksum verification failed for the 1Password debsig policy" >&2
      exit 1
    }

    for existing_keyring in "${system_keyring}" "${debsig_keyring}"; do
      if sudo test -e "${existing_keyring}"; then
        existing_fingerprints="$(
          sudo gpg --no-options --batch --no-autostart --with-colons \
            --import-options show-only --import "${existing_keyring}" 2>/dev/null |
            awk -F: '$1 == "pub" { primary = 1; next } primary && $1 == "fpr" { print $10; primary = 0 }'
        )" || {
          echo "error: failed to inspect existing ${existing_keyring}; refusing to overwrite it" >&2
          exit 1
        }
        [ "${existing_fingerprints}" = "${ONEPASSWORD_APT_KEY_FINGERPRINT}" ] || {
          echo "error: existing ${existing_keyring} is not the pinned 1Password key; refusing to overwrite it" >&2
          exit 1
        }
      fi
    done
    if sudo test -e "${debsig_policy}"; then
      existing_policy_sha256="$(sudo sh -c 'sha256sum "$1" 2>/dev/null || shasum -a 256 "$1"' sh "${debsig_policy}" | awk '{print $1}')" || {
        echo "error: failed to inspect existing ${debsig_policy}; refusing to overwrite it" >&2
        exit 1
      }
      [ "${existing_policy_sha256}" = "${ONEPASSWORD_APT_POLICY_SHA256}" ] || {
        echo "error: existing ${debsig_policy} differs from the pinned policy; refusing to overwrite it" >&2
        exit 1
      }
    fi
    if sudo test -e "${source_file}"; then
      [ "$(sudo cat "${source_file}")" = "${source_line}" ] || {
        echo "error: existing ${source_file} differs from the required 1Password source; refusing to overwrite it" >&2
        exit 1
      }
    fi

    sudo test -e "${system_keyring}" ||
      sudo install -D -m 644 "${keyring_file}" "${system_keyring}"
    sudo test -e "${debsig_keyring}" ||
      sudo install -D -m 644 "${keyring_file}" "${debsig_keyring}"
    sudo test -e "${debsig_policy}" ||
      sudo install -D -m 644 "${policy_file}" "${debsig_policy}"
    if ! sudo test -e "${source_file}"; then
      printf '%s\n' "${source_line}" | sudo tee "${source_file}" >/dev/null
    fi
    sudo apt-get update -qq
    sudo apt-get install -y -qq debsig-verify 1password-cli
  )
  onepassword_cli_meets_minimum || {
    echo "error: installed 1Password CLI does not satisfy ${ONEPASSWORD_MINIMUM_VERSION}" >&2
    exit 1
  }
fi
# <<< 1password-cli apt

{{ if and (not .codespaces) (not .devcontainer) -}}
# Azure CLI — Microsoft 署名付き apt リポジトリから導入する
# Codespaces では devcontainer Feature で導入するためスキップ。このリポジトリの
# .devcontainer/devcontainer.json は chezmoi テンプレートと Python テストの開発だけを
# 対象とするため az / azd の Feature を含めない
if ! command -v az >/dev/null 2>&1; then
  echo "Installing Azure CLI via Microsoft apt repository..."
  (
    tmp_dir="$(make_install_tmp_dir)"
    trap 'rm -rf "${tmp_dir}"' EXIT
    microsoft_key="${tmp_dir}/microsoft.asc"
    microsoft_key_home="${tmp_dir}/gnupg"
    expected_fingerprint="BC528686B50D79E339D3721CEB3E94ADBE1229CF"
    if ! download_file "https://packages.microsoft.com/keys/microsoft.asc" "${microsoft_key}"; then
      echo "Warning: failed to download the Microsoft repository key; skipping Azure CLI installation." >&2
      exit 0
    fi
    if ! downloaded_fingerprints="$(primary_key_fingerprints "${microsoft_key}")"; then
      echo "error: failed to inspect the downloaded Microsoft signing key" >&2
      exit 1
    fi
    if ! printf '%s\n' "${downloaded_fingerprints}" | grep -Fxq "${expected_fingerprint}"; then
      echo "error: Microsoft signing key fingerprint verification failed" >&2
      exit 1
    fi
    mkdir -m 700 "${microsoft_key_home}"
    GNUPGHOME="${microsoft_key_home}" gpg --batch --import "${microsoft_key}" >/dev/null 2>&1
    GNUPGHOME="${microsoft_key_home}" gpg --batch --export "${expected_fingerprint}" \
      >"${tmp_dir}/microsoft.gpg"
    if ! exported_fingerprints="$(primary_key_fingerprints "${tmp_dir}/microsoft.gpg")"; then
      echo "error: failed to inspect the isolated Microsoft signing key" >&2
      exit 1
    fi
    if [ "${exported_fingerprints}" != "${expected_fingerprint}" ]; then
      echo "error: isolated Microsoft signing key did not contain exactly the verified primary key" >&2
      exit 1
    fi
    sudo install -D -m 644 "${tmp_dir}/microsoft.gpg" /etc/apt/keyrings/microsoft.gpg
    . /etc/os-release
    repository_suite=""
    if [ -n "${VERSION_CODENAME:-}" ]; then
      repository_suite="$(azure_cli_suite "${VERSION_CODENAME}")" || true
    fi
    if [ -z "${repository_suite}" ] && [ -n "${UBUNTU_CODENAME:-}" ]; then
      repository_suite="$(azure_cli_suite "${UBUNTU_CODENAME}")" || true
    fi
    if [ -z "${repository_suite}" ]; then
      echo "Warning: unsupported distribution codename for the Azure CLI repository: ${VERSION_CODENAME:-${UBUNTU_CODENAME:-unknown}}; skipping Azure CLI installation." >&2
      exit 0
    fi
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/azure-cli/ ${repository_suite} main" | \
      sudo tee /etc/apt/sources.list.d/azure-cli.list >/dev/null
    if ! sudo apt-get update -qq; then
      echo "Warning: apt-get update failed for the Azure CLI repository; skipping Azure CLI installation." >&2
      exit 0
    fi
    if ! sudo apt-get install -y -qq azure-cli; then
      echo "Warning: failed to install Azure CLI from apt; continue and retry after network recovery." >&2
    fi
  )
fi

# Azure Developer CLI — 固定した公式 .deb を checksum 検証して導入する
# github: バックエンドはバイナリ名を正規化しないため、macOS (brew) / Windows (winget) と同様に
# mise 外で管理する。更新は azd update で行う
if ! command -v azd >/dev/null 2>&1; then
  AZD_VERSION="1.31.1"
  case "$(dpkg --print-architecture)" in
    amd64)
      expected_sha256="414bc5a111ade678f2bf81f5396019b8c42e6151154a7e332307e7ce1146180e"
      ;;
    arm64)
      expected_sha256="009dae211c4a8f9001f7e7dd3aca88e89caba9d45a7e7c80506c9d8372c95514"
      ;;
    *)
      echo "error: unsupported architecture for Azure Developer CLI: $(dpkg --print-architecture)" >&2
      exit 1
      ;;
  esac
  echo "Installing Azure Developer CLI ${AZD_VERSION}..."
  (
    tmp_dir="$(make_install_tmp_dir)"
    trap 'rm -rf "${tmp_dir}"' EXIT
    azd_deb="${tmp_dir}/azd_${AZD_VERSION}_$(dpkg --print-architecture).deb"
    if ! download_file \
      "https://github.com/Azure/azure-dev/releases/download/azure-dev-cli_${AZD_VERSION}/azd_${AZD_VERSION}_$(dpkg --print-architecture).deb" \
      "${azd_deb}"; then
      echo "Warning: failed to download Azure Developer CLI ${AZD_VERSION}; skipping installation." >&2
      exit 0
    fi
    actual_sha256="$(sha256_file "${azd_deb}")"
    if [ "${actual_sha256}" != "${expected_sha256}" ]; then
      echo "error: checksum verification failed for Azure Developer CLI" >&2
      exit 1
    fi
    if ! sudo apt-get install -y -qq "${azd_deb}"; then
      echo "Warning: failed to install Azure Developer CLI; continue and retry after network recovery." >&2
    fi
  )
fi
{{ end -}}

{{ else if eq .chezmoi.os "darwin" -}}
echo "Installing system packages via brew..."
brew update --quiet
# Terraform の署名検証に使う。既存の gpg があれば Homebrew 操作は行わない。
if ! command -v gpg >/dev/null 2>&1; then
  brew install gnupg
fi
# サードパーティ tap (azure/azd) の formula は HOMEBREW_REQUIRE_TAP_TRUST 強制後に
# 未信頼だと黙ってスキップされるため、install 前に formula 単位で信頼しておく。
# 強制は Homebrew 5.2.0 / 6.0.0 のいずれか早い方でデフォルト化予定。
# brew trust は冪等。古い brew に未実装でも全体を止めないよう失敗は警告に留める。
brew trust --formula azure/azd/azd \
  || echo "Warning: 'brew trust' unavailable or failed; azd install may be skipped under tap-trust enforcement." >&2
# azure-cli / azd / copilot-cli: GUI アプリや github: バックエンド都合を避けるため
# macOS では brew で管理
# git: Apple Git は 2.50 系で停滞しており、設定ベースフック (git >= 2.54) を
# 使えない。ADR-020 の gitleaks フックはこの機能に依存するため、brew 版を入れる。
# PATH で Apple Git より優先させる処理は ~/.zprofile 側にある（後述の理由により
# /etc/zprofile の path_helper より後で prepend する必要がある）。
brew install \
  azure-cli \
  azure/azd/azd \
  copilot-cli \
  git \
  poppler \
  watch \
  zsh-completions
brew install --cask libreoffice

# >>> p3-homebrew
# P3 workstation tools are installed or upgraded only when the Homebrew-owned
# binary is missing or below the declared minimum. PATH candidates are ignored.
P3_BREW_BIN=/opt/homebrew/bin/brew
[ -x "${P3_BREW_BIN}" ] || {
  echo "error: Homebrew is required at ${P3_BREW_BIN} for P3 workstation tools" >&2
  exit 1
}
P3_EXPECTED_BREW_PREFIX="$(dirname "$(dirname "${P3_BREW_BIN}")")"
P3_BREW_PREFIX_RAW="$("${P3_BREW_BIN}" --prefix)"
[ "${P3_BREW_PREFIX_RAW}" = "${P3_EXPECTED_BREW_PREFIX}" ] || {
  echo "error: ${P3_BREW_BIN} reported an unexpected prefix: ${P3_BREW_PREFIX_RAW}" >&2
  exit 1
}
P3_BREW_PREFIX="$(cd -P "${P3_BREW_PREFIX_RAW}" && pwd)"

p3_homebrew_is_installed() {
  local kind=$1 package=$2

  if [ "${kind}" = "cask" ]; then
    "${P3_BREW_BIN}" list --cask --versions "${package}" >/dev/null 2>&1
  else
    "${P3_BREW_BIN}" list --formula --versions "${package}" >/dev/null 2>&1
  fi
}

p3_resolve_link() {
  local current=$1 target directory

  while [ -L "${current}" ]; do
    directory="$(cd -P "$(dirname "${current}")" && pwd)"
    target="$(readlink "${current}")"
    case "${target}" in
      /*) current="${target}" ;;
      *) current="${directory}/${target}" ;;
    esac
  done
  directory="$(cd -P "$(dirname "${current}")" && pwd)"
  printf '%s/%s\n' "${directory}" "$(basename "${current}")"
}

p3_homebrew_binary() {
  local kind=$1 package=$2 command_name=$3 prefix binary resolved

  p3_homebrew_is_installed "${kind}" "${package}" || return 1
  if [ "${kind}" = "cask" ]; then
    prefix="${P3_BREW_PREFIX}"
  else
    prefix="$("${P3_BREW_BIN}" --prefix "${package}")" || return 1
    [ "${prefix}" = "${P3_EXPECTED_BREW_PREFIX}/opt/${package}" ] || {
      echo "error: Homebrew formula ${package} reported an unexpected prefix: ${prefix}" >&2
      return 1
    }
  fi
  binary="${prefix}/bin/${command_name}"
  [ -x "${binary}" ] || return 1
  resolved="$(p3_resolve_link "${binary}")" || return 1
  case "${kind}:${resolved}" in
    "cask:${P3_BREW_PREFIX}/Caskroom/${package}/"*) ;;
    "formula:${P3_BREW_PREFIX}/Cellar/${package}/"*) ;;
    *) return 1 ;;
  esac
  [ -f "${resolved}" ] && [ ! -L "${resolved}" ] || return 1
  printf '%s\n' "${binary}"
}

p3_binary_version() {
  local tool=$1 binary=$2 command_name=$3 output

  case "${tool}" in
    1password)
      output="$("${binary}" --version 2>/dev/null)" || return 1
      case "${output}" in
        *'
'*) return 1 ;;
      esac
      printf '%s\n' "${output}" | grep -E '^[0-9]+(\.[0-9]+){2}$'
      return
      ;;
    cargo-make)
      if [ "${command_name}" = "cargo-make" ]; then
        output="$("${binary}" make --version 2>/dev/null)" || return 1
      else
        output="$("${binary}" --version 2>/dev/null)" || return 1
      fi
      case "${output}" in
        *'
'*) return 1 ;;
      esac
      printf '%s\n' "${output}" |
        grep -Eq '^cargo-make [0-9]+(\.[0-9]+){2}$' || return 1
      printf '%s\n' "${output#cargo-make }"
      return
      ;;
    lefthook)
      output="$("${binary}" version 2>/dev/null)" || return 1
      ;;
    *)
      output="$("${binary}" --version 2>/dev/null)" || return 1
      ;;
  esac
  printf '%s\n' "${output}" \
    | grep -Eo '[0-9]+(\.[0-9]+){2}' \
    | head -n 1
}

p3_macos_arch_matches() {
  local binary=$1 expected header

  case "$(uname -m)" in
    arm64|aarch64) expected='cffaedfe0c000001' ;;
    x86_64|amd64) expected='cffaedfe07000001' ;;
    *)
      echo "error: unsupported macOS architecture: $(uname -m)" >&2
      return 1
      ;;
  esac
  header="$(LC_ALL=C od -An -tx1 -N8 "${binary}" 2>/dev/null |
    awk '{ for (i = 1; i <= NF; i++) printf "%s", $i } END { print "" }')" ||
    return 1
  [ "${header}" = "${expected}" ]
}

p3_homebrew_install_or_upgrade() {
  local tool=$1 minimum=$2 package=$3 kind=$4 command_name=$5 extra_command=${6:-}
  local binary installed_version extra_binary extra_version

  if p3_homebrew_is_installed "${kind}" "${package}"; then
    binary="$(p3_homebrew_binary "${kind}" "${package}" "${command_name}")" || {
      echo "error: Homebrew package ${package} is installed but its owned ${command_name} binary is unavailable" >&2
      return 1
    }
    if ! p3_macos_arch_matches "${binary}"; then
      echo "error: Homebrew-owned ${command_name} does not match the native macOS architecture; refusing to replace it" >&2
      return 1
    fi
    installed_version="$(p3_binary_version "${tool}" "${binary}" "${command_name}")" || {
      echo "error: could not determine the Homebrew-owned ${command_name} version" >&2
      return 1
    }
    if [ -n "${extra_command}" ]; then
      extra_binary="$(p3_homebrew_binary "${kind}" "${package}" "${extra_command}")" || {
        echo "error: Homebrew package ${package} is missing its owned ${extra_command} binary" >&2
        return 1
      }
      if ! p3_macos_arch_matches "${extra_binary}"; then
        echo "error: Homebrew-owned ${extra_command} does not match the native macOS architecture" >&2
        return 1
      fi
      extra_version="$(p3_binary_version "${tool}" "${extra_binary}" "${extra_command}")" || {
        echo "error: could not determine the Homebrew-owned ${extra_command} version" >&2
        return 1
      }
    fi
    if version_ge "${installed_version}" "${minimum}" &&
      { [ -z "${extra_command}" ] || version_ge "${extra_version}" "${minimum}"; }; then
      return 0
    fi
    echo "Upgrading ${tool} to ${minimum} or later via Homebrew..."
    if [ "${kind}" = "cask" ]; then
      "${P3_BREW_BIN}" upgrade --cask "${package}"
    else
      "${P3_BREW_BIN}" upgrade "${package}"
    fi
  else
    if [ -e "${P3_BREW_PREFIX}/bin/${command_name}" ] || [ -L "${P3_BREW_PREFIX}/bin/${command_name}" ]; then
      echo "error: ${P3_BREW_PREFIX}/bin/${command_name} exists but is not owned by Homebrew package ${package}" >&2
      return 1
    fi
    echo "Installing ${tool} ${minimum} or later via Homebrew..."
    if [ "${kind}" = "cask" ]; then
      "${P3_BREW_BIN}" install --cask "${package}"
    else
      "${P3_BREW_BIN}" install "${package}"
    fi
  fi

  binary="$(p3_homebrew_binary "${kind}" "${package}" "${command_name}")" || {
    echo "error: Homebrew did not provide the expected ${command_name} binary for ${package}" >&2
    return 1
  }
  if ! p3_macos_arch_matches "${binary}"; then
    echo "error: Homebrew installed ${command_name} for the wrong CPU architecture" >&2
    return 1
  fi
  installed_version="$(p3_binary_version "${tool}" "${binary}" "${command_name}")" || {
    echo "error: could not determine the installed ${command_name} version" >&2
    return 1
  }
  if ! version_ge "${installed_version}" "${minimum}"; then
    echo "error: Homebrew installed ${tool} ${installed_version}, below required ${minimum}" >&2
    return 1
  fi
  if [ -n "${extra_command}" ]; then
    extra_binary="$(p3_homebrew_binary "${kind}" "${package}" "${extra_command}")" || {
      echo "error: Homebrew did not provide the expected ${extra_command} binary for ${package}" >&2
      return 1
    }
    if ! p3_macos_arch_matches "${extra_binary}"; then
      echo "error: Homebrew installed ${extra_command} for the wrong CPU architecture" >&2
      return 1
    fi
    extra_version="$(p3_binary_version "${tool}" "${extra_binary}" "${extra_command}")" || {
      echo "error: could not determine the installed ${extra_command} version" >&2
      return 1
    }
    if ! version_ge "${extra_version}" "${minimum}"; then
      echo "error: Homebrew installed ${extra_command} ${extra_version}, below required ${minimum}" >&2
      return 1
    fi
  fi
}

P3_HOMEBREW_SPECS=(
  "1password|{{ .onePassword.minimumVersion }}|{{ .onePassword.homebrew.package }}|{{ .onePassword.homebrew.kind }}|op|"
  "bat|{{ .bat.minimumVersion }}|{{ .bat.homebrew.package }}|{{ .bat.homebrew.kind }}|bat|"
  "cargo-make|{{ .cargoMake.minimumVersion }}|{{ .cargoMake.homebrew.package }}|{{ .cargoMake.homebrew.kind }}|cargo-make|makers"
  "fzf|{{ .fzf.minimumVersion }}|{{ .fzf.homebrew.package }}|{{ .fzf.homebrew.kind }}|fzf|"
  "ghq|{{ .ghq.minimumVersion }}|{{ .ghq.homebrew.package }}|{{ .ghq.homebrew.kind }}|ghq|"
  "gitleaks|{{ .gitleaks.minimumVersion }}|{{ .gitleaks.homebrew.package }}|{{ .gitleaks.homebrew.kind }}|gitleaks|"
  "lefthook|{{ .lefthook.minimumVersion }}|{{ .lefthook.homebrew.package }}|{{ .lefthook.homebrew.kind }}|lefthook|"
  "ripgrep|{{ .ripgrep.minimumVersion }}|{{ .ripgrep.homebrew.package }}|{{ .ripgrep.homebrew.kind }}|rg|"
  "shellcheck|{{ .shellcheck.minimumVersion }}|{{ .shellcheck.homebrew.package }}|{{ .shellcheck.homebrew.kind }}|shellcheck|"
  "zoxide|{{ .zoxide.minimumVersion }}|{{ .zoxide.homebrew.package }}|{{ .zoxide.homebrew.kind }}|zoxide|"
)

for p3_spec in "${P3_HOMEBREW_SPECS[@]}"; do
  IFS='|' read -r p3_tool p3_minimum p3_package p3_kind p3_command p3_extra <<<"${p3_spec}"
  p3_homebrew_install_or_upgrade \
    "${p3_tool}" "${p3_minimum}" "${p3_package}" "${p3_kind}" "${p3_command}" "${p3_extra}"
done
# <<< p3-homebrew

# gh: mise install 前にトークン取得手段を確保する。導入と更新は Homebrew が所有し、
# 未導入か最小版未満のときだけ操作する。最小版以上の版は更新しない。
vendor_gh="$(homebrew_gh_path || true)"
if ! gh_meets_minimum "${vendor_gh}"; then
  if [ -n "${vendor_gh}" ]; then
    echo "Upgrading GitHub CLI to ${GH_MINIMUM_VERSION} or later via brew..."
    brew upgrade gh \
      || echo "Warning: failed to upgrade GitHub CLI via Homebrew. Retry manually with 'brew upgrade gh'." >&2
  else
    echo "Installing GitHub CLI ${GH_MINIMUM_VERSION} or later via brew..."
    brew install gh \
      || echo "Warning: failed to install GitHub CLI via Homebrew. Retry manually with 'brew install gh'." >&2
  fi
fi

{{ end -}}

# Rust — rust-toolchain.toml を持つプロジェクトでの version pinning を機能させるため、
# mise ではなく公式インストーラー (rustup) で管理する。詳細: docs/adr/016-rust-external-rustup.md
if ! command -v rustup >/dev/null 2>&1; then
  RUSTUP_VERSION="1.29.0"
  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64)
      rustup_target="x86_64-unknown-linux-gnu"
      expected_sha256="4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10"
      ;;
    Linux-aarch64|Linux-arm64)
      rustup_target="aarch64-unknown-linux-gnu"
      expected_sha256="9732d6c5e2a098d3521fca8145d826ae0aaa067ef2385ead08e6feac88fa5792"
      ;;
    Darwin-x86_64)
      rustup_target="x86_64-apple-darwin"
      expected_sha256="33cf85df9142bc6d29cbc62fa5ca1d4c29622cddb55213a4c1a43c457fb9b2d7"
      ;;
    Darwin-arm64)
      rustup_target="aarch64-apple-darwin"
      expected_sha256="aeb4105778ca1bd3c6b0e75768f581c656633cd51368fa61289b6a71696ac7e1"
      ;;
    *)
      echo "error: unsupported platform for rustup: $(uname -s)-$(uname -m)" >&2
      exit 1
      ;;
  esac
  echo "Installing Rust via rustup-init ${RUSTUP_VERSION}..."
  (
    tmp_dir="$(make_install_tmp_dir)"
    trap 'rm -rf "${tmp_dir}"' EXIT
    rustup_init="${tmp_dir}/rustup-init"
    if ! download_file \
      "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${rustup_target}/rustup-init" \
      "${rustup_init}"; then
      echo "Warning: failed to download rustup-init ${RUSTUP_VERSION}; skipping installation." >&2
      exit 0
    fi
    actual_sha256="$(sha256_file "${rustup_init}")"
    if [ "${actual_sha256}" != "${expected_sha256}" ]; then
      echo "error: checksum verification failed for rustup-init" >&2
      exit 1
    fi
    chmod 755 "${rustup_init}"
    if ! "${rustup_init}" -y --no-modify-path; then
      echo "Warning: rustup-init could not complete installation; continue and retry after network recovery." >&2
    fi
  )
fi
{{ end -}}
