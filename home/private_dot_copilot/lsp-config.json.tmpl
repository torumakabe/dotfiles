{
  "lspServers": {
    "python": {
      "command": "ty",
      "args": ["server"],
      "fileExtensions": {
        ".py": "python",
        ".pyi": "python"
      }
    },
    "typescript": {
      "command": "typescript-language-server",
      "args": ["--stdio"],
      "initializationOptions": {
        "tsserver": {
          "path": {{ joinPath .chezmoi.homeDir ".local/share/chezmoi-dotfiles/typescript-lsp/node_modules/typescript/lib/tsserver.js" | toJson }}
        }
      },
      "fileExtensions": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact"
      }
    }
  }
}
