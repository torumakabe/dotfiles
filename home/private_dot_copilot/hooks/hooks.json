{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "\"$HOME/.copilot/hooks/run-hook.sh\" copilot-guard.py",
        "powershell": "& \"$HOME\\.copilot\\hooks\\run-hook.ps1\" copilot-guard.py",
        "cwd": ".",
        "timeoutSec": 30
      },
      {
        "type": "command",
        "bash": "\"$HOME/.copilot/hooks/run-hook.sh\" node-global-enforcer.py",
        "powershell": "& \"$HOME\\.copilot\\hooks\\run-hook.ps1\" node-global-enforcer.py",
        "cwd": ".",
        "timeoutSec": 30
      },
      {
        "type": "command",
        "bash": "\"$HOME/.copilot/hooks/run-hook.sh\" uv-enforcer.py",
        "powershell": "& \"$HOME\\.copilot\\hooks\\run-hook.ps1\" uv-enforcer.py",
        "cwd": ".",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "\"$HOME/.copilot/hooks/run-hook.sh\" audit-log.py",
        "powershell": "& \"$HOME\\.copilot\\hooks\\run-hook.ps1\" audit-log.py",
        "cwd": ".",
        "timeoutSec": 15
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "bash": "\"$HOME/.copilot/hooks/run-hook.sh\" audit-failure.py",
        "powershell": "& \"$HOME\\.copilot\\hooks\\run-hook.ps1\" audit-failure.py",
        "cwd": ".",
        "timeoutSec": 15
      }
    ]
  }
}
