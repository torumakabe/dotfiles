{{- if ne .chezmoi.os "windows" -}}
{{- $platform := printf "%s-%s" .chezmoi.os .chezmoi.arch -}}
#!/usr/bin/env bash
# golangci-lint 公式releaseを検証し、単一実行ファイルとして配置する。

set -euo pipefail

tool_name=golangci-lint
tool_version='{{ .golangciLint.version }}'
platform_os='{{ .chezmoi.os }}'
platform_arch='{{ .chezmoi.arch }}'
{{ if not (hasKey .golangciLint.assets $platform) }}
echo "error: golangci-lint ${tool_version} has no asset for {{ $platform }}" >&2
exit 1
{{ else }}
{{- $asset := index .golangciLint.assets $platform }}
bin_dir="${HOME}/.local/bin"
target="${bin_dir}/${tool_name}"
mise_target="${HOME}/.local/share/mise/shims/${tool_name}"
asset_file='{{ $asset.file }}'
asset_url='{{ $asset.url }}'
asset_sha256='{{ $asset.sha256 }}'
asset_entry='{{ $asset.entry }}'
executable_arch='{{ $asset.executableArch }}'

[ "${executable_arch}" = "${platform_arch}" ] || {
  echo "error: declared executable architecture ${executable_arch} does not match ${platform_arch}" >&2
  exit 1
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    echo "error: sha256sum or shasum is required to verify ${asset_file}" >&2
    return 1
  fi
}

assert_target_replaceable() {
  if [ -L "${target}" ]; then
    local current
    current="$(readlink "${target}")"
    if [ -d "${target}" ]; then
      echo "error: ${target} points to a directory; refusing to replace it" >&2
      return 1
    fi
    if [ "${current}" != "${mise_target}" ]; then
      echo "error: ${target} is a foreign symlink (${current}); refusing to replace it" >&2
      return 1
    fi
  elif [ -e "${target}" ] && [ ! -f "${target}" ]; then
    echo "error: ${target} is not a regular file; refusing to replace it" >&2
    return 1
  fi
}

has_expected_architecture() {
  local binary=$1 header
  [ -f "${binary}" ] && [ ! -L "${binary}" ] || return 1
  header="$(LC_ALL=C od -An -tx1 -N20 "${binary}" 2>/dev/null |
    awk '{ for (i = 1; i <= NF; i++) printf "%s", $i } END { print "" }')" || return 1
  case "${platform_os}:${platform_arch}" in
    linux:amd64)
      [ "${#header}" -ge 40 ] && [ "${header:0:12}" = "7f454c460201" ] &&
        [ "${header:36:4}" = "3e00" ]
      ;;
    linux:arm64)
      [ "${#header}" -ge 40 ] && [ "${header:0:12}" = "7f454c460201" ] &&
        [ "${header:36:4}" = "b700" ]
      ;;
    darwin:arm64)
      [ "${#header}" -ge 16 ] && [ "${header:0:16}" = "cffaedfe0c000001" ]
      ;;
    *) return 1 ;;
  esac
}

has_expected_version() {
  local binary=$1 cwd=$2 probe_home=$3 output
  mkdir -p "${probe_home}" "${probe_home}/cache"
  if ! output="$(
    cd "${cwd}" &&
      HOME="${probe_home}" GOLANGCI_LINT_CACHE="${probe_home}/cache" \
        GOTOOLCHAIN=local GOENV=off GOWORK=off \
        "${binary}" version --short 2>/dev/null
  )"; then
    return 1
  fi
  [ "${output}" = "${tool_version}" ]
}

command -v od >/dev/null 2>&1 || {
  echo "error: od is required to verify golangci-lint architecture" >&2
  exit 1
}
assert_target_replaceable
mkdir -p "${bin_dir}"
probe_root="$(mktemp -d "${bin_dir}/.golangci-lint-probe.XXXXXX")"
chmod 700 "${probe_root}"
stage_dir=""
trap 'rm -rf "${probe_root}" "${stage_dir}"' EXIT
if [ ! -L "${target}" ] && has_expected_architecture "${target}" &&
  has_expected_version "${target}" "${probe_root}" "${probe_root}/home"; then
  exit 0
fi

stage_dir="$(mktemp -d "${bin_dir}/.golangci-lint-install.XXXXXX")"
chmod 700 "${stage_dir}"
archive="${stage_dir}/download"
curl --proto '=https' --tlsv1.2 -fsSL -o "${archive}" "${asset_url}" || {
  echo "error: failed to download ${asset_file}; keeping the current golangci-lint" >&2
  exit 1
}
[ "$(sha256_file "${archive}")" = "${asset_sha256}" ] || {
  echo "error: checksum verification failed for ${asset_file}" >&2
  exit 1
}
case "${asset_entry}" in
  ""|/*|..|../*|*/..|*/../*)
    echo "error: unsafe archive entry ${asset_entry}" >&2
    exit 1
    ;;
esac
candidate="${stage_dir}/${tool_name}"
tar -xOzf "${archive}" "${asset_entry}" >"${candidate}" || {
  echo "error: failed to extract ${asset_entry} from ${asset_file}" >&2
  exit 1
}
[ -f "${candidate}" ] && [ ! -L "${candidate}" ] || {
  echo "error: ${asset_entry} is not a regular file in ${asset_file}" >&2
  exit 1
}
chmod 755 "${candidate}"
has_expected_architecture "${candidate}" || {
  echo "error: ${asset_file} does not contain a native ${platform_arch} executable" >&2
  exit 1
}
has_expected_version "${candidate}" "${stage_dir}" "${stage_dir}/probe-home" || {
  echo "error: ${asset_file} did not report golangci-lint ${tool_version}" >&2
  exit 1
}
assert_target_replaceable
mv -f "${candidate}" "${target}" || {
  echo "error: could not publish ${target}; the previous file was kept" >&2
  exit 1
}
{{ end }}
{{- end }}
