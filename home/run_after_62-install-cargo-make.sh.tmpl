{{- if ne .chezmoi.os "windows" -}}
{{- $platform := printf "%s-%s" .chezmoi.os .chezmoi.arch -}}
#!/usr/bin/env bash
# cargo-make と makers を、OS package・公式 release・検証済みcrate buildの
# いずれかから一つの transaction として ~/.local/bin へ配置する。

set -euo pipefail

tool_version='{{ .cargoMake.version }}'
minimum_version='{{ .cargoMake.minimumVersion }}'
platform_os='{{ .chezmoi.os }}'
platform_arch='{{ .chezmoi.arch }}'
bin_dir="${HOME}/.local/bin"
mise_dir="${HOME}/.local/share/mise/shims"
target_cargo_make="${bin_dir}/cargo-make"
target_makers="${bin_dir}/makers"

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    echo "error: sha256sum or shasum is required" >&2
    return 1
  fi
}

resolve_link() {
  local current=$1 next directory
  while [ -L "${current}" ]; do
    directory="$(cd -P "$(dirname "${current}")" && pwd)"
    next="$(readlink "${current}")"
    case "${next}" in
      /*) current="${next}" ;;
      *) current="${directory}/${next}" ;;
    esac
  done
  directory="$(cd -P "$(dirname "${current}")" && pwd)"
  printf '%s/%s\n' "${directory}" "$(basename "${current}")"
}

has_expected_architecture() {
  local binary=$1 header
  [ -f "${binary}" ] && [ ! -L "${binary}" ] || return 1
  header="$(LC_ALL=C od -An -tx1 -N20 "${binary}" 2>/dev/null |
    awk '{ for (i = 1; i <= NF; i++) printf "%s", $i } END { print "" }')" || return 1
  case "${platform_os}:${platform_arch}" in
    linux:amd64)
      [ "${#header}" -ge 40 ] && [ "${header:0:12}" = "7f454c460201" ] &&
        [ "${header:36:4}" = "3e00" ]
      ;;
    linux:arm64)
      [ "${#header}" -ge 40 ] && [ "${header:0:12}" = "7f454c460201" ] &&
        [ "${header:36:4}" = "b700" ]
      ;;
    darwin:arm64)
      [ "${#header}" -ge 16 ] && [ "${header:0:16}" = "cffaedfe0c000001" ]
      ;;
    *) return 1 ;;
  esac
}

has_expected_version() {
  local binary=$1 name=$2 cwd=$3 probe_home=$4 output
  mkdir -p "${probe_home}"
  case "${name}" in
    cargo-make)
      output="$(
        cd "${cwd}" &&
          HOME="${probe_home}" CARGO_HOME="${probe_home}/cargo" \
            CARGO_MAKE_DISABLE_CHECK_FOR_UPDATES=1 "${binary}" make --version 2>/dev/null
      )" || return 1
      ;;
    makers)
      output="$(
        cd "${cwd}" &&
          HOME="${probe_home}" CARGO_HOME="${probe_home}/cargo" \
            CARGO_MAKE_DISABLE_CHECK_FOR_UPDATES=1 "${binary}" --version 2>/dev/null
      )" || return 1
      ;;
    *) return 1 ;;
  esac
  [ "${output}" = "cargo-make ${tool_version}" ]
}

version_ge() {
  local left="${1%%[-+]*}" right="${2%%[-+]*}" index left_field right_field
  local -a left_parts right_parts
  case "${left}:${right}" in
    *[!0-9.:]*) return 1 ;;
  esac
  IFS='.' read -r -a left_parts <<<"${left}"
  IFS='.' read -r -a right_parts <<<"${right}"
  for index in 0 1 2; do
    left_field=$((10#${left_parts[index]:-0}))
    right_field=$((10#${right_parts[index]:-0}))
    [ "${left_field}" -gt "${right_field}" ] && return 0
    [ "${left_field}" -lt "${right_field}" ] && return 1
  done
  return 0
}

has_minimum_version() {
  local binary=$1 name=$2 cwd=$3 probe_home=$4 output found
  mkdir -p "${probe_home}"
  case "${name}" in
    cargo-make)
      output="$(
        cd "${cwd}" &&
          HOME="${probe_home}" CARGO_HOME="${probe_home}/cargo" \
            CARGO_MAKE_DISABLE_CHECK_FOR_UPDATES=1 "${binary}" make --version 2>/dev/null
      )" || return 1
      ;;
    makers)
      output="$(
        cd "${cwd}" &&
          HOME="${probe_home}" CARGO_HOME="${probe_home}/cargo" \
            CARGO_MAKE_DISABLE_CHECK_FOR_UPDATES=1 "${binary}" --version 2>/dev/null
      )" || return 1
      ;;
    *) return 1 ;;
  esac
  case "${output}" in
    "cargo-make "*) found="${output#cargo-make }" ;;
    *) return 1 ;;
  esac
  version_ge "${found}" "${minimum_version}"
}

assert_one_target() {
  local target=$1 name=$2 provider=${3:-} legacy_provider_root=${4:-}
  if [ -L "${target}" ]; then
    local current legacy_relative legacy_version
    current="$(readlink "${target}")"
    if [ -d "${target}" ]; then
      echo "error: ${target} points to a directory; refusing to replace it" >&2
      return 1
    fi
    if [ "${current}" = "${mise_dir}/${name}" ] ||
      { [ -n "${provider}" ] && [ "${current}" = "${provider}" ]; }; then
      return 0
    fi
    if [ -n "${legacy_provider_root}" ]; then
      case "${current}" in
        "${legacy_provider_root}/"*/bin/"${name}")
          legacy_relative="${current#"${legacy_provider_root}/"}"
          legacy_version="${legacy_relative%%/*}"
          if [ -n "${legacy_version}" ] && [ "${legacy_version}" != "." ] &&
            [ "${legacy_version}" != ".." ] &&
            [ "${legacy_relative}" = "${legacy_version}/bin/${name}" ]; then
            return 0
          fi
          ;;
      esac
    fi
    echo "error: ${target} is a foreign symlink (${current}); refusing to replace it" >&2
    return 1
  elif [ -e "${target}" ] && [ ! -f "${target}" ]; then
    echo "error: ${target} is not a regular file; refusing to replace it" >&2
    return 1
  fi
}

provider_cargo_make=""
provider_makers=""
legacy_provider_root=""
{{ if eq .chezmoi.os "darwin" -}}
brew_prefix='{{ .cargoMake.homebrew.prefix }}'
[ -d "${brew_prefix}" ] || {
  echo "error: Homebrew prefix ${brew_prefix} is not available" >&2
  exit 1
}
brew_prefix="$(cd -P "${brew_prefix}" && pwd)" || {
  echo "error: Homebrew prefix is not accessible" >&2
  exit 1
}
legacy_provider_root="${brew_prefix}/Cellar/cargo-make"
for name in cargo-make makers; do
  linked="${brew_prefix}/bin/${name}"
  stable="${brew_prefix}/opt/cargo-make/bin/${name}"
  [ -L "${linked}" ] || {
    echo "error: Homebrew did not provide ${linked}" >&2
    exit 1
  }
  resolved="$(resolve_link "${linked}")"
  case "${resolved}" in
    "${brew_prefix}/Cellar/cargo-make/"*) ;;
    *)
      echo "error: ${linked} is not owned by the cargo-make formula" >&2
      exit 1
      ;;
  esac
  [ -f "${resolved}" ] && [ ! -L "${resolved}" ] || {
    echo "error: ${resolved} is not a regular package-owned executable" >&2
    exit 1
  }
  [ -f "${stable}" ] && [ ! -L "${stable}" ] && [ "$(resolve_link "${stable}")" = "${resolved}" ] || {
    echo "error: ${stable} does not resolve to the current cargo-make formula executable" >&2
    exit 1
  }
  if [ "${name}" = cargo-make ]; then provider_cargo_make="${stable}"; else provider_makers="${stable}"; fi
done
{{ end -}}

assert_targets() {
  assert_one_target "${target_cargo_make}" cargo-make "${provider_cargo_make}" "${legacy_provider_root}"
  assert_one_target "${target_makers}" makers "${provider_makers}" "${legacy_provider_root}"
}

command -v od >/dev/null 2>&1 || {
  echo "error: od is required to verify cargo-make architecture" >&2
  exit 1
}
assert_targets
mkdir -p "${bin_dir}"
probe_root="$(mktemp -d "${bin_dir}/.cargo-make-probe.XXXXXX")"
chmod 700 "${probe_root}"
stage_dir=""
cleanup_stage=1
cleanup() {
  local status=$?
  trap - EXIT
  rm -rf "${probe_root}"
  if [ -n "${stage_dir}" ] && [ "${cleanup_stage}" -eq 1 ]; then rm -rf "${stage_dir}"; fi
  exit "${status}"
}
trap cleanup EXIT

{{ if eq .chezmoi.os "darwin" -}}
if has_expected_architecture "${provider_cargo_make}" &&
  has_expected_architecture "${provider_makers}" &&
  has_minimum_version "${provider_cargo_make}" cargo-make "${probe_root}" "${probe_root}/home-cargo-make" &&
  has_minimum_version "${provider_makers}" makers "${probe_root}" "${probe_root}/home-makers" &&
  [ -L "${target_cargo_make}" ] && [ "$(readlink "${target_cargo_make}")" = "${provider_cargo_make}" ] &&
  [ -L "${target_makers}" ] && [ "$(readlink "${target_makers}")" = "${provider_makers}" ]; then
  exit 0
fi
if ! has_expected_architecture "${provider_cargo_make}" ||
  ! has_expected_architecture "${provider_makers}"; then
  echo "error: Homebrew cargo-make is not native ${platform_arch}" >&2
  exit 1
fi
if ! has_minimum_version "${provider_cargo_make}" cargo-make "${probe_root}" "${probe_root}/home-cargo-make" ||
  ! has_minimum_version "${provider_makers}" makers "${probe_root}" "${probe_root}/home-makers"; then
  echo "error: Homebrew cargo-make does not satisfy ${minimum_version}" >&2
  exit 1
fi
{{ else -}}
if [ ! -L "${target_cargo_make}" ] && [ ! -L "${target_makers}" ] &&
  has_expected_architecture "${target_cargo_make}" &&
  has_expected_architecture "${target_makers}" &&
  has_expected_version "${target_cargo_make}" cargo-make "${probe_root}" "${probe_root}/home-cargo-make" &&
  has_expected_version "${target_makers}" makers "${probe_root}" "${probe_root}/home-makers"; then
  exit 0
fi
{{ end -}}

stage_dir="$(mktemp -d "${bin_dir}/.cargo-make-install.XXXXXX")"
chmod 700 "${stage_dir}"
staged_cargo_make="${stage_dir}/cargo-make"
staged_makers="${stage_dir}/makers"

{{ if eq .chezmoi.os "darwin" -}}
ln -s "${provider_cargo_make}" "${staged_cargo_make}"
ln -s "${provider_makers}" "${staged_makers}"
{{ else if and (eq .chezmoi.os "linux") (eq .chezmoi.arch "amd64") -}}
{{- $asset := index .cargoMake.assets $platform }}
asset_file='{{ $asset.file }}'
archive="${stage_dir}/download.zip"
curl --proto '=https' --tlsv1.2 -fsSL -o "${archive}" '{{ $asset.url }}' || {
  echo "error: failed to download ${asset_file}; keeping the current cargo-make" >&2
  exit 1
}
[ "$(sha256_file "${archive}")" = '{{ $asset.sha256 }}' ] || {
  echo "error: checksum verification failed for ${asset_file}" >&2
  exit 1
}
unzip -p "${archive}" '{{ $asset.entry }}' >"${staged_cargo_make}" || {
  echo "error: failed to extract cargo-make from ${asset_file}" >&2
  exit 1
}
unzip -p "${archive}" '{{ $asset.secondEntry }}' >"${staged_makers}" || {
  echo "error: failed to extract makers from ${asset_file}" >&2
  exit 1
}
chmod 755 "${staged_cargo_make}" "${staged_makers}"
{{ else if and (eq .chezmoi.os "linux") (eq .chezmoi.arch "arm64") -}}
source_file='{{ .cargoMake.source.file }}'
source_archive="${stage_dir}/${source_file}"
curl --proto '=https' --tlsv1.2 -fsSL -o "${source_archive}" '{{ .cargoMake.source.url }}' || {
  echo "error: failed to download ${source_file}; keeping the current cargo-make" >&2
  exit 1
}
[ "$(sha256_file "${source_archive}")" = '{{ .cargoMake.source.sha256 }}' ] || {
  echo "error: checksum verification failed for ${source_file}" >&2
  exit 1
}
if ! tar -tzf "${source_archive}" | awk '
  /^\/|(^|\/)\.\.(\/|$)/ { bad = 1 }
  END { exit(bad ? 1 : 0) }
'; then
  echo "error: unsafe path in ${source_file}" >&2
  exit 1
fi
mkdir "${stage_dir}/source"
tar -xzf "${source_archive}" -C "${stage_dir}/source"
source_root="${stage_dir}/source/{{ .cargoMake.source.entry }}"
[ -f "${source_root}/Cargo.lock" ] && [ -f "${source_root}/Cargo.toml" ] || {
  echo "error: ${source_file} is missing Cargo.lock or Cargo.toml" >&2
  exit 1
}
cargo_binary="$(rustup which cargo 2>/dev/null)" || {
  echo "error: rustup could not resolve cargo for native cargo-make build" >&2
  exit 1
}
case "${cargo_binary}" in
  "${RUSTUP_HOME:-${HOME}/.rustup}/toolchains/"*) ;;
  *)
    echo "error: cargo is not owned by the rustup toolchain" >&2
    exit 1
    ;;
esac
has_expected_architecture "${cargo_binary}" || {
  echo "error: rustup cargo is not native ${platform_arch}" >&2
  exit 1
}
mkdir "${stage_dir}/build-home" "${stage_dir}/cargo-home" "${stage_dir}/target"
(
  cd "${stage_dir}"
  HOME="${stage_dir}/build-home" \
    CARGO_HOME="${stage_dir}/cargo-home" \
    CARGO_TARGET_DIR="${stage_dir}/target" \
    "${cargo_binary}" install --path "${source_root}" --root "${stage_dir}/installed" --locked --bins
) || {
  echo "error: native cargo-make source build failed" >&2
  exit 1
}
mv "${stage_dir}/installed/bin/cargo-make" "${staged_cargo_make}"
mv "${stage_dir}/installed/bin/makers" "${staged_makers}"
{{ else -}}
echo "error: cargo-make ${tool_version} is unsupported on {{ $platform }}" >&2
exit 1
{{ end -}}

{{ if ne .chezmoi.os "darwin" -}}
if ! has_expected_architecture "${staged_cargo_make}" ||
  ! has_expected_architecture "${staged_makers}"; then
  echo "error: cargo-make candidates are not native ${platform_arch} executables" >&2
  exit 1
fi
if ! has_expected_version "${staged_cargo_make}" cargo-make "${stage_dir}" "${stage_dir}/probe-cargo-make" ||
  ! has_expected_version "${staged_makers}" makers "${stage_dir}" "${stage_dir}/probe-makers"; then
  echo "error: cargo-make candidates did not report ${tool_version}" >&2
  exit 1
fi
{{ end -}}

assert_targets
published_cargo_make=0
published_makers=0
rollback() {
  local failed=0
  if [ "${published_makers}" -eq 1 ]; then rm -f "${target_makers}" || failed=1; fi
  if [ "${published_cargo_make}" -eq 1 ]; then rm -f "${target_cargo_make}" || failed=1; fi
  if [ -e "${stage_dir}/previous-cargo-make" ] || [ -L "${stage_dir}/previous-cargo-make" ]; then
    mv "${stage_dir}/previous-cargo-make" "${target_cargo_make}" || failed=1
  fi
  if [ -e "${stage_dir}/previous-makers" ] || [ -L "${stage_dir}/previous-makers" ]; then
    mv "${stage_dir}/previous-makers" "${target_makers}" || failed=1
  fi
  return "${failed}"
}

if [ -e "${target_cargo_make}" ] || [ -L "${target_cargo_make}" ]; then
  mv "${target_cargo_make}" "${stage_dir}/previous-cargo-make"
fi
if [ -e "${target_makers}" ] || [ -L "${target_makers}" ]; then
  if ! mv "${target_makers}" "${stage_dir}/previous-makers"; then
    rollback || cleanup_stage=0
    echo "error: could not preserve makers; previous entries were restored" >&2
    exit 1
  fi
fi
if ! mv "${staged_cargo_make}" "${target_cargo_make}"; then
  rollback || cleanup_stage=0
  echo "error: could not publish cargo-make; previous entries were restored" >&2
  exit 1
fi
published_cargo_make=1
if ! mv "${staged_makers}" "${target_makers}"; then
  rollback || cleanup_stage=0
  echo "error: could not publish makers; previous entries were restored" >&2
  exit 1
fi
published_makers=1
{{- end }}
