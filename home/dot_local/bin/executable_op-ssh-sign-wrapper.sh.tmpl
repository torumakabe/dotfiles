#!/usr/bin/env bash
# WSL workaround (ADR-012): Git 2.36 未満では op-ssh-sign-wsl.exe の CRLF 出力から
# principal の末尾に \r が残り、SSH 署名検証が失敗する。対応 WSL 経路に古い Git
# への fallback があるため、stdout/stderr から CR を剥がす。
# 署名 (-Y sign) は -s <file> に書き出すため stdout を経由せず影響を受けない。

set -o pipefail

WIN_BIN="/mnt/c/Users/{{ .windowsUser }}/AppData/Local/Microsoft/WindowsApps/op-ssh-sign-wsl.exe"

"${WIN_BIN}" "$@" 2> >(tr -d '\r' >&2) | tr -d '\r'
