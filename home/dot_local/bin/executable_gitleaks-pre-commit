#!/bin/sh
set -eu

# gitleaks secret detection, run as a config-based pre-commit hook.
#
# Deployed by chezmoi to ~/.local/bin/gitleaks-pre-commit and wired up via
# `[hook "dotfiles-gitleaks"]` in ~/.gitconfig (see
# docs/adr/020-git-hooks-via-config.md). Git >= 2.54 runs config-based hooks
# for every repository, additively with any hook in $GIT_DIR/hooks, so a
# repo-local hook manager (lefthook, husky, ...) that owns
# <repo>/.git/hooks/pre-commit cannot displace this one. Git < 2.54 ignores
# the [hook] section entirely, so this file is simply never invoked there and
# ~/.config/git/templates/hooks/pre-commit (ADR-018) remains the only path.
#
# Opt out for a single repository with:
#   git config --local hook.dotfiles-gitleaks.enabled false
#
# Unlike hooks in $GIT_DIR/hooks, a config-based hook is not existence-checked
# by git: if this file is missing or unreadable the shell fails and the commit
# is blocked. That is intentional — a secret scanner must not disappear
# quietly — but it means this file must stay deployed alongside the gitconfig
# entry.
#
# Keep this POSIX sh compatible so Windows Git does not pick up WSL bash
# through /usr/bin/env bash and pass it an unopenable C:/... hook path.

find_gitleaks() {
  home_root="$(cd -P "${HOME}" && pwd)"
  home_mise_root="${home_root}/.local/share/mise/shims"
  localappdata_unix=""
  if [ -n "${LOCALAPPDATA:-}" ]; then
    if [ -x /usr/bin/cygpath ]; then
      localappdata_unix="$(/usr/bin/cygpath -u "${LOCALAPPDATA}")"
    else
      localappdata_unix="${LOCALAPPDATA}"
    fi
    if [ -d "${localappdata_unix}" ]; then
      localappdata_unix="$(cd -P "${localappdata_unix}" && pwd)"
    fi
  fi

  is_mise_shim_path() {
    checked_path=$1
    case "${checked_path}" in
      "${home_mise_root}/"*) return 0 ;;
    esac
    if [ -n "${localappdata_unix}" ]; then
      checked_lower="$(printf '%s' "${checked_path}" | /usr/bin/tr '[:upper:]' '[:lower:]')"
      home_mise_lower="$(printf '%s' "${home_mise_root}/" | /usr/bin/tr '[:upper:]' '[:lower:]')"
      mise_lower="$(printf '%s' "${localappdata_unix}/mise/shims/" | /usr/bin/tr '[:upper:]' '[:lower:]')"
      case "${checked_lower}" in
        "${home_mise_lower}"*|"${mise_lower}"*) return 0 ;;
      esac
    fi
    return 1
  }

  resolve_candidate() {
    current_path=$1
    link_depth=0
    while [ -L "${current_path}" ]; do
      link_depth=$((link_depth + 1))
      [ "${link_depth}" -le 16 ] || return 1
      current_dir="${current_path%/*}"
      [ "${current_dir}" != "${current_path}" ] || current_dir=.
      current_dir="$(cd -P "${current_dir}" && pwd)" || return 1
      next_path="$(/usr/bin/readlink "${current_path}")" || return 1
      case "${next_path}" in
        /*) current_path="${next_path}" ;;
        *) current_path="${current_dir}/${next_path}" ;;
      esac
    done
    current_dir="${current_path%/*}"
    [ "${current_dir}" != "${current_path}" ] || current_dir=.
    current_dir="$(cd -P "${current_dir}" && pwd)" || return 1
    printf '%s/%s\n' "${current_dir}" "${current_path##*/}"
  }

  candidate_is_usable() {
    candidate_path=$1
    [ -f "${candidate_path}" ] && [ -x "${candidate_path}" ] || return 1
    resolved_path="$(resolve_candidate "${candidate_path}")" || return 1
    is_mise_shim_path "${candidate_path}" && return 1
    is_mise_shim_path "${resolved_path}" && return 1
    return 0
  }

  for candidate_path in \
    "${home_root}/.local/bin/gitleaks.exe" \
    "${home_root}/.local/bin/gitleaks" \
    "${localappdata_unix:+${localappdata_unix}/Microsoft/WinGet/Links/gitleaks.exe}" \
    "/opt/homebrew/opt/gitleaks/bin/gitleaks"; do
    if [ -n "${candidate_path}" ] && candidate_is_usable "${candidate_path}"; then
      echo "${candidate_path}"
      return 0
    fi
  done

  for command_name in gitleaks.exe gitleaks; do
    path_candidate="$(
      IFS=:
      set -f
      for path_dir in ${PATH:-}; do
        [ -n "${path_dir}" ] || path_dir=.
        candidate_path="${path_dir}/${command_name}"
        if candidate_is_usable "${candidate_path}"; then
          echo "${candidate_path}"
          exit 0
        fi
      done
      exit 1
    )" || continue
    if [ -n "${path_candidate}" ]; then
      echo "${path_candidate}"
      return 0
    fi
  done

  return 1
}

GITLEAKS=$(find_gitleaks) || {
  echo "⚠️  gitleaks not found — skipping secret scan." >&2
  echo "   Run chezmoi apply to install the managed gitleaks command." >&2
  # fail-open: allow commit when gitleaks is not installed
  GITLEAKS=""
}

if [ -n "${GITLEAKS}" ]; then
  "${GITLEAKS}" git --pre-commit --staged --redact --verbose --no-banner
fi
