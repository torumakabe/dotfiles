{{ if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = 'Stop'
$PSNativeCommandUseErrorActionPreference = $false

$version = '2026.10.23'
$installerSha256 = '47b7724534c8f9fd2907b5ac05dffc6d1fb0b113be933e737c51b02f62400e1a'
$miseExe = Join-Path $HOME '.local\bin\mise.exe'
$shimExe = Join-Path $HOME '.local\bin\mise-shim.exe'

if (Test-Path -LiteralPath $miseExe) {
  if (-not (Test-Path -LiteralPath $miseExe -PathType Leaf) -or
      -not (Test-Path -LiteralPath $shimExe -PathType Leaf)) {
    throw "Existing mise installation is incomplete: $miseExe"
  }
  $existingVersion = & $miseExe --version
  if ($LASTEXITCODE -ne 0) { throw "Existing mise failed verification: $miseExe" }
  Write-Host "Keeping installed mise: $existingVersion"
}
else {
  $work = Join-Path ([System.IO.Path]::GetTempPath()) ("chezmoi-mise-" + [guid]::NewGuid().ToString('N'))
  New-Item -ItemType Directory -Path $work | Out-Null
  $environmentNames = @(
    'MISE_VERSION', 'MISE_INSTALL_PATH', 'MISE_INSTALL_MODIFY_PATH',
    'MISE_INSTALL_SHIMS_PATH', 'MISE_INSTALL_ARCH', 'MISE_INSTALL_HELP'
  )
  $previousEnvironment = @{}
  foreach ($name in $environmentNames) {
    $previousEnvironment[$name] = [Environment]::GetEnvironmentVariable($name, 'Process')
  }
  try {
    Write-Host "Installing mise $version from the official Windows installer..."
    $installer = Join-Path $work 'install.ps1'
    Invoke-WebRequest "https://github.com/jdx/mise/releases/download/v$version/install.ps1" -OutFile $installer
    if ((Get-FileHash -LiteralPath $installer -Algorithm SHA256).Hash -ne $installerSha256) {
      throw 'mise installer checksum mismatch.'
    }

    $env:MISE_VERSION = $version
    $env:MISE_INSTALL_PATH = $miseExe
    $env:MISE_INSTALL_MODIFY_PATH = '1'
    $env:MISE_INSTALL_SHIMS_PATH = '0'
    $env:MISE_INSTALL_ARCH = $null
    $env:MISE_INSTALL_HELP = '0'
    & $installer
    if (-not (Test-Path -LiteralPath $shimExe -PathType Leaf)) {
      throw "mise-shim.exe was not installed beside $miseExe"
    }
    & $miseExe --version
    if ($LASTEXITCODE -ne 0) { throw "Installed mise failed verification: $miseExe" }
  }
  finally {
    foreach ($name in $environmentNames) {
      [Environment]::SetEnvironmentVariable($name, $previousEnvironment[$name], 'Process')
    }
    Remove-Item -LiteralPath $work -Recurse -Force
  }
}

{{ end -}}
