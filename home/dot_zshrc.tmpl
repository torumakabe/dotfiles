{{ if ne .chezmoi.os "windows" -}}
# Oh My Zsh

# Path to your oh-my-zsh installation.
export ZSH=$HOME/.oh-my-zsh

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time oh-my-zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="robbyrussell"

# Which plugins would you like to load?
# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.
plugins=(
  git
  zsh-completions
)

source $ZSH/oh-my-zsh.sh

# User configuration

setopt autocd
setopt autopushd

export LC_ALL=C.UTF-8
export LANG=C.UTF-8
export EDITOR=vim
# PATH / GOPATH / brew shellenv / mise shims は ~/.profile に集約し、
# ~/.zprofile 経由で login 時に source される（非対話シェルは env 継承）。

# 対話 zsh で必要なツール連携を現在のシェルプロセスに適用する。
# eval ではなく process substitution + source を使い、出力をスクリプトとして評価する。
command -v mise >/dev/null && source <(mise activate zsh)

alias k=kubectl
alias ll='ls -ahl'

# Copilot CLI: local sandbox is enabled. preToolUse hooks still protect
# sensitive files and shell-level secret reads.
alias copilot-guardrails='copilot \
  --allow-all \
  --secret-env-vars "AZURE_CLIENT_SECRET,ARM_CLIENT_SECRET,ARM_ACCESS_KEY,AZURE_STORAGE_CONNECTION_STRING"'

# FPATH for completions (must be before compinit)
[ -f "$HOME/.zfunc/_rustup" ] && FPATH=$HOME/.zfunc:$FPATH

autoload -Uz +X compinit && compinit -ui
autoload -Uz +X bashcompinit && bashcompinit

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

case $(uname) in
  Darwin)
    command -v az >/dev/null && source "$(brew --prefix)/etc/bash_completion.d/az"
  ;;
  *)
    command -v az >/dev/null && source /etc/bash_completion.d/azure-cli
  ;;
esac

# Completion cache: generate once, source from file on subsequent loads.
# Cache is invalidated when the tool binary is updated (mtime comparison).
# Usage: _cached_source <cache_name> <command> <generation_command>
_cached_source() {
  local name=$1 cmd=$2 gen_cmd=$3
  local cmd_path
  cmd_path=$(command -v "$cmd" 2>/dev/null) || return 1

  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh-completions"
  local cache_file="$cache_dir/$name.zsh"
  mkdir -p "$cache_dir"

  if [[ -f "$cache_file" && "$cache_file" -nt "$cmd_path" ]]; then
    source "$cache_file"
    return
  fi

  eval "$gen_cmd" > "$cache_file" 2>/dev/null || { rm -f "$cache_file"; return 1; }
  source "$cache_file"
}

_completion_cache_clear() {
  rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}/zsh-completions"
  echo "Completion cache cleared. Restart shell to regenerate."
}

# Tool completions (cached)
_cached_source zoxide zoxide "zoxide init zsh --cmd cd"
alias z='cd'
alias zi='cdi'
_cached_source kubectl kubectl "kubectl completion zsh" && complete -o default -F __start_kubectl k
_cached_source helm helm "helm completion zsh"
command -v terraform >/dev/null && complete -o nospace -C "$(command -v terraform)" terraform
_cached_source rad rad "rad completion zsh"
_cached_source gh gh "gh completion -s zsh"
_cached_source azd azd "azd completion zsh"
_cached_source trivy trivy "trivy completion zsh"

# macOS は ~/.ssh/config の IdentityAgent が 1Password の agent を指すため、
# シェルからは ssh-agent を起動しない。
if [[ "$OSTYPE" != darwin* ]] && [ -z "$SSH_AUTH_SOCK" ] ; then
  if agent_output=$(ssh-agent -s 2>/dev/null); then
    while IFS= read -r line; do
      assignment=${line%%;*}
      case "$assignment" in
        SSH_AUTH_SOCK=/*)
          export "$assignment"
          ;;
        SSH_AGENT_PID=*)
          agent_pid=${assignment#SSH_AGENT_PID=}
          case "$agent_pid" in
            ''|*[!0-9]*)
              ;;
            *)
              export "$assignment"
              ;;
          esac
          ;;
      esac
    done <<< "$agent_output"
    ssh-add -l >/dev/null || ssh-add ~/.ssh/id_ed25519 >/dev/null 2>&1
  fi
fi

# ghq + fzf: fuzzy-search git repositories and cd into selection
function ghcd() {
  local dir
  dir=$(ghq list -p | fzf --preview 'ls -la {}')
  if [ -n "$dir" ]; then
    cd "$dir"
  fi
}

# git-hooks-audit: ghq 管理下の全リポジトリを走査し、init.templateDir 経由の
# pre-commit hook (gitleaks) が効いているか報告する (ADR-018)。
# init.templateDir は git init/clone 時に一度だけ hook をコピーする方式のため、
# 既存リポジトリや、独自 hooksPath を持つリポジトリ (lefthook/husky 等) では
# 自動的には保護されない。ここでは削除・変更は一切行わず、状態を可視化するのみ。
git-hooks-audit() {
  if ! command -v ghq >/dev/null 2>&1; then
    echo "❌ ghq が見つかりません" >&2
    return 1
  fi

  local repo hooks_path_effective hook_path is_bare
  ghq list -p | while IFS= read -r repo; do
    [ -d "$repo" ] || continue
    # --local ではなく実効値を見る（global/system/includeIf 由来の override も検知するため）
    hooks_path_effective=$(git -C "$repo" config --get core.hooksPath 2>/dev/null || true)
    if [ -n "${hooks_path_effective}" ]; then
      if [ "${hooks_path_effective}" = "${HOME}/.config/git/hooks" ] || [ "${hooks_path_effective}" = "~/.config/git/hooks" ]; then
        echo "⚠️  ${repo}: core.hooksPath=${hooks_path_effective} (旧グローバル設定。chezmoi apply 後に再確認)"
      else
        echo "⚠️  ${repo}: core.hooksPath=${hooks_path_effective} (init.templateDir hook は使われません)"
      fi
      continue
    fi
    is_bare=$(git -C "$repo" rev-parse --is-bare-repository 2>/dev/null || true)
    if [ -z "${is_bare}" ]; then
      echo "❓ ${repo}: git repo として認識できません"
      continue
    fi
    if [ "${is_bare}" = "true" ]; then
      echo "ℹ️  ${repo}: bare repo のため対象外"
      continue
    fi
    # 手動で相対パスを組み立てない（worktree 等で $repo 相対とは限らないため）
    hook_path=$(git -C "$repo" rev-parse --path-format=absolute --git-path hooks/pre-commit 2>/dev/null || true)
    if [ -z "${hook_path}" ]; then
      echo "❓ ${repo}: hook path を解決できません"
      continue
    fi
    if [ ! -f "${hook_path}" ]; then
      echo "❌ ${repo}: pre-commit hook が無い（backfill: git -C '${repo}' init）"
      continue
    fi
    if grep -q "gitleaks.*git.*--pre-commit.*--staged" "${hook_path}" 2>/dev/null; then
      echo "✅ ${repo}: gitleaks hook 有効"
    else
      echo "ℹ️  ${repo}: pre-commit hook はあるが gitleaks 製ではない（他ツールが管理中と思われる）"
    fi
  done
}

# mise 管理ツールの一括更新（日常操作）
# upgrade → lockfile 更新 → chezmoi 反映 → git commit+push を一括実行
_mise_normalize_log_line() {
  emulate -L zsh

  command sed $'s/\033\\[[0-9;]*[[:alpha:]]//g' <<< "$1"
}

_mise_is_allowed_warning() {
  emulate -L zsh

  local warning="$1"
  local minimum_release_age_pattern='^mise WARN[[:space:]]+newer [^[:space:]]+ release [^[:space:]]+([[:space:]]+\(released [^)]+\))?[[:space:]]+ignored by minimum_release_age \([^)]+\); latest eligible release is [^[:space:]]+$'
  local recovered_fallback_pattern='^mise WARN[[:space:]]+mise-versions[[:space:]]+endpoint=[^[:space:]]+[[:space:]]+repo=[^[:space:]]+[[:space:]]+tag=[^[:space:]]+[[:space:]]+outcome=[^[:space:]]+[[:space:]]+status=[^[:space:]]+[[:space:]]+fallback=true([[:space:]]+error=.*)?$'

  if [[ "$warning" =~ $minimum_release_age_pattern ]]; then
    print -r -- "minimum_release_age"
    return 0
  fi
  if [[ "$warning" =~ $recovered_fallback_pattern ]]; then
    print -r -- "recovered_fallback"
    return 0
  fi
  return 1
}

_mise_check_warnings() {
  emulate -L zsh

  local log_file="$1"
  local phase="$2"
  local line warning warning_type
  local blocking_warning=0

  while IFS= read -r line || [[ -n "$line" ]]; do
    warning=$(_mise_normalize_log_line "$line")
    [[ "$warning" == *"mise WARN"* ]] || continue

    if warning_type=$(_mise_is_allowed_warning "$warning"); then
      if [[ "$warning_type" == "minimum_release_age" ]]; then
        echo "⚠️ ${phase}: リリース待機期間による保留を検出しました。処理を継続します:" >&2
      else
        echo "⚠️ ${phase}: 回復済みのメタデータ取得フォールバックを検出しました。処理を継続します:" >&2
      fi
      echo "  $warning" >&2
    else
      if (( ! blocking_warning )); then
        echo "❌ ${phase}: 処理を中止する警告を検出しました:" >&2
      fi
      echo "  $warning" >&2
      blocking_warning=1
    fi
  done < "$log_file"

  (( blocking_warning == 0 ))
}

_mise_restore_artifacts() {
  emulate -L zsh

  local lockfile="$1"
  local locks_dir="$2"
  local backup_dir="$3"
  local had_lockfile="$4"
  local had_locks_dir="$5"
  local restore_status=0

  rm -f "$lockfile" || restore_status=1
  if [[ -n "$locks_dir" ]]; then
    rm -rf "$locks_dir" || restore_status=1
  fi
  if (( had_lockfile )); then
    command cp -p "${backup_dir}/mise.lock" "$lockfile" || restore_status=1
  fi
  if (( had_locks_dir )); then
    if [[ -n "$locks_dir" ]]; then
      command cp -Rp "${backup_dir}/locks" "$locks_dir" || restore_status=1
    else
      restore_status=1
    fi
  fi

  if (( restore_status == 0 )); then
    echo "↩️ lockfile と dependency sidecar を復元しました" >&2
  else
    echo "❌ lockfile と dependency sidecar を復元できませんでした" >&2
  fi
  return "$restore_status"
}

_mise_validate_lock_sidecars() {
  emulate -L zsh

  local lockfile="$1"
  local config_dir="$2"
  local aube_path
  local path_part
  local -a path_parts
  local expected_count extracted_count=0

  if [[ ! -f "$lockfile" ]] ||
      ! command grep -q '[^[:space:]]' "$lockfile"; then
    echo "❌ lockfile が存在しないか空です" >&2
    return 1
  fi

  expected_count=$(command grep -Ec '^[[:space:]]*aube[[:space:]]*=' "$lockfile") || expected_count=0

  while IFS= read -r aube_path; do
    (( extracted_count++ ))
    path_parts=("${(@s:/:)aube_path}")
    if [[ "$aube_path" != locks/?* ||
          "$aube_path" == *\\* ||
          "$aube_path" == *//* ||
          "$aube_path" == */ ]]; then
      echo "❌ lockfile の dependency sidecar path が不正です: $aube_path" >&2
      return 1
    fi
    for path_part in "${path_parts[@]}"; do
      if [[ "$path_part" == ".." ]]; then
        echo "❌ lockfile の dependency sidecar path が不正です: $aube_path" >&2
        return 1
      fi
    done
    if [[ ! -f "${config_dir}/${aube_path}/aube-lock.yaml" ||
          ! -f "${config_dir}/${aube_path}/package.json" ]]; then
      echo "❌ dependency sidecar が不足しています: $aube_path" >&2
      return 1
    fi
  done < <(command sed -n 's/^[[:space:]]*aube[[:space:]]*=[[:space:]]*{[[:space:]]*path[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$lockfile")

  if (( extracted_count != expected_count )); then
    echo "❌ lockfile の dependency sidecar path をすべて解析できません" >&2
    return 1
  fi

  print -r -- "$extracted_count"
}

mise-upgrade() {
  emulate -L zsh

  # 前提条件チェック
  if ! command -v gh >/dev/null 2>&1; then
    echo "❌ gh CLI が見つかりません。https://cli.github.com/ からインストールしてください" >&2
    return 1
  fi
  if ! command -v mise >/dev/null 2>&1; then
    echo "❌ mise が見つかりません。https://mise.jdx.dev/ からインストールしてください" >&2
    return 1
  fi
  if ! command -v chezmoi >/dev/null 2>&1; then
    echo "❌ chezmoi が見つかりません。https://www.chezmoi.io/ からインストールしてください" >&2
    return 1
  fi

  local token
  token=$(gh auth token 2>/dev/null) || {
    echo "❌ GitHub 認証が必要です。gh auth login を実行してください" >&2
    return 1
  }

  local work_dir
  work_dir=$(mktemp -d "${TMPDIR:-/tmp}/mise-upgrade.XXXXXX") || {
    echo "❌ mise の一時ディレクトリを作成できません" >&2
    return 1
  }

  local mise_log="${work_dir}/mise.log"
  local config_dir="$HOME/.config/mise"
  local lockfile="${config_dir}/mise.lock"
  local locks_dir="${config_dir}/locks"
  local target_backup="${work_dir}/target"
  local had_lockfile=0
  local had_locks_dir=0
  mkdir -p "$target_backup" || {
    rm -rf "$work_dir"
    echo "❌ mise 生成物の退避先を作成できません" >&2
    return 1
  }
  if [[ -f "$lockfile" ]]; then
    command cp -p "$lockfile" "${target_backup}/mise.lock" || {
      rm -rf "$work_dir"
      echo "❌ 既存 lockfile を退避できません" >&2
      return 1
    }
    had_lockfile=1
  fi
  if [[ -d "$locks_dir" ]]; then
    command cp -Rp "$locks_dir" "${target_backup}/locks" || {
      rm -rf "$work_dir"
      echo "❌ 既存 dependency sidecar を退避できません" >&2
      return 1
    }
    had_locks_dir=1
  fi

  echo "==> mise upgrade: ツールを最新版に更新..."
  NO_COLOR=1 GITHUB_TOKEN="$token" mise upgrade 2>&1 | tee "$mise_log"
  if (( pipestatus[1] != 0 )); then
    _mise_restore_artifacts \
      "$lockfile" "$locks_dir" "$target_backup" \
      "$had_lockfile" "$had_locks_dir" || :
    echo "❌ mise upgrade に失敗しました" >&2
    echo "実行ログ: $mise_log" >&2
    return 1
  fi
  if ! _mise_check_warnings "$mise_log" "mise upgrade"; then
    _mise_restore_artifacts \
      "$lockfile" "$locks_dir" "$target_backup" \
      "$had_lockfile" "$had_locks_dir" || :
    echo "lockfile の再生成、commit、push は実行していません" >&2
    echo "実行ログ: $mise_log" >&2
    return 1
  fi

  echo "==> mise lock: lockfile と dependency sidecar を再生成..."
  rm -f "$lockfile"
  rm -rf "$locks_dir"
  : > "$mise_log"
  NO_COLOR=1 GITHUB_TOKEN="$token" mise lock --global --platform linux-x64,linux-arm64,macos-arm64,windows-x64,windows-arm64 2>&1 | tee "$mise_log"
  if (( pipestatus[1] != 0 )); then
    _mise_restore_artifacts \
      "$lockfile" "$locks_dir" "$target_backup" \
      "$had_lockfile" "$had_locks_dir" || :
    echo "❌ lockfile と dependency sidecar の再生成に失敗しました。実行ログを確認してください" >&2
    echo "実行ログ: $mise_log" >&2
    return 1
  fi
  if ! _mise_check_warnings "$mise_log" "mise lock"; then
    _mise_restore_artifacts \
      "$lockfile" "$locks_dir" "$target_backup" \
      "$had_lockfile" "$had_locks_dir" || :
    echo "chezmoi re-add、commit、push は実行していません" >&2
    echo "実行ログ: $mise_log" >&2
    return 1
  fi
  mkdir -p "$locks_dir" || {
    _mise_restore_artifacts \
      "$lockfile" "$locks_dir" "$target_backup" \
      "$had_lockfile" "$had_locks_dir" || :
    echo "❌ dependency sidecar ディレクトリを作成できません" >&2
    echo "実行ログ: $mise_log" >&2
    return 1
  }
  local sidecar_count
  if ! sidecar_count=$(_mise_validate_lock_sidecars "$lockfile" "$config_dir"); then
    _mise_restore_artifacts \
      "$lockfile" "$locks_dir" "$target_backup" \
      "$had_lockfile" "$had_locks_dir" || :
    echo "実行ログ: $mise_log" >&2
    return 1
  fi
  if (( sidecar_count == 0 )); then
    : > "${locks_dir}/.keep" || {
      _mise_restore_artifacts \
        "$lockfile" "$locks_dir" "$target_backup" \
        "$had_lockfile" "$had_locks_dir" || :
      echo "❌ 空の dependency sidecar ディレクトリを管理対象にできません" >&2
      return 1
    }
  fi

  local source_home source_root branch
  source_home=$(chezmoi source-path) || {
    _mise_restore_artifacts \
      "$lockfile" "$locks_dir" "$target_backup" \
      "$had_lockfile" "$had_locks_dir" || :
    echo "❌ chezmoi ソースディレクトリを取得できません" >&2
    return 1
  }
  source_root="${source_home:h}"
  branch=$(git -C "$source_root" rev-parse --abbrev-ref HEAD) || {
    _mise_restore_artifacts \
      "$lockfile" "$locks_dir" "$target_backup" \
      "$had_lockfile" "$had_locks_dir" || :
    echo "❌ chezmoi ソースのブランチを確認できません" >&2
    return 1
  }
  if [[ "$branch" != "main" ]]; then
    _mise_restore_artifacts \
      "$lockfile" "$locks_dir" "$target_backup" \
      "$had_lockfile" "$had_locks_dir" || :
    echo "❌ chezmoi ソースが main ブランチではありません (現在: $branch)。git checkout main してから再実行してください" >&2
    return 1
  fi

  local source_lockfile source_locks_dir source_backup
  local had_source_lockfile=0
  local had_source_locks_dir=0
  source_lockfile=$(chezmoi source-path "$lockfile") || {
    _mise_restore_artifacts \
      "$lockfile" "$locks_dir" "$target_backup" \
      "$had_lockfile" "$had_locks_dir" || :
    echo "❌ mise.lock の chezmoi ソースパスを取得できません" >&2
    return 1
  }
  source_locks_dir=$(chezmoi source-path "$locks_dir" 2>/dev/null) ||
    source_locks_dir=""
  source_backup="${work_dir}/source"
  mkdir -p "$source_backup" || {
    _mise_restore_artifacts \
      "$lockfile" "$locks_dir" "$target_backup" \
      "$had_lockfile" "$had_locks_dir" || :
    echo "❌ chezmoi ソースの退避先を作成できません" >&2
    return 1
  }
  if [[ -f "$source_lockfile" ]]; then
    command cp -p "$source_lockfile" "${source_backup}/mise.lock" || {
      _mise_restore_artifacts \
        "$lockfile" "$locks_dir" "$target_backup" \
        "$had_lockfile" "$had_locks_dir" || :
      echo "❌ chezmoi ソースの mise.lock を退避できません" >&2
      return 1
    }
    had_source_lockfile=1
  fi
  if [[ -d "$source_locks_dir" ]]; then
    command cp -Rp "$source_locks_dir" "${source_backup}/locks" || {
      _mise_restore_artifacts \
        "$lockfile" "$locks_dir" "$target_backup" \
        "$had_lockfile" "$had_locks_dir" || :
      echo "❌ chezmoi ソースの dependency sidecar を退避できません" >&2
      return 1
    }
    had_source_locks_dir=1
  fi

  local source_update_failed=0
  echo "==> chezmoi: lockfile と dependency sidecar をソースに反映..."
  chezmoi re-add "$lockfile" || source_update_failed=1
  if (( ! source_update_failed && had_source_locks_dir )); then
    chezmoi forget --force "$locks_dir" || source_update_failed=1
  fi
  if (( ! source_update_failed )); then
    chezmoi add --exact "$locks_dir" || source_update_failed=1
  fi
  if (( ! source_update_failed )); then
    local updated_source_locks_dir
    if updated_source_locks_dir=$(chezmoi source-path "$locks_dir" 2>/dev/null) &&
        [[ -n "$updated_source_locks_dir" ]]; then
      source_locks_dir="$updated_source_locks_dir"
    else
      source_update_failed=1
    fi
  fi
  if (( source_update_failed )); then
    local current_source_locks_dir
    chezmoi forget --force "$locks_dir" >/dev/null 2>&1 || :
    current_source_locks_dir=$(chezmoi source-path "$locks_dir" 2>/dev/null) &&
      source_locks_dir="$current_source_locks_dir"
    _mise_restore_artifacts \
      "$source_lockfile" "$source_locks_dir" "$source_backup" \
      "$had_source_lockfile" "$had_source_locks_dir" || :
    _mise_restore_artifacts \
      "$lockfile" "$locks_dir" "$target_backup" \
      "$had_lockfile" "$had_locks_dir" || :
    echo "❌ lockfile と dependency sidecar の chezmoi 反映に失敗しました" >&2
    echo "実行ログ: $mise_log" >&2
    return 1
  fi

  rm -rf "$work_dir"

  git -C "$source_root" add -A || {
    echo "❌ git add に失敗しました" >&2
    return 1
  }
  if git -C "$source_root" diff --cached --quiet; then
    echo "✅ 更新するツールはありませんでした"
    return 0
  fi

  git -C "$source_root" commit -m "chore: upgrade mise tools" || {
    echo "❌ git commit に失敗しました" >&2
    return 1
  }

  git -C "$source_root" push || {
    echo "❌ git push に失敗しました。コミットは完了しています。手動で push してください" >&2
    return 1
  }

  echo "✅ mise ツールの更新が完了しました"
}

{{ end -}}
