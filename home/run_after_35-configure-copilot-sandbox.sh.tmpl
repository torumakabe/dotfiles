{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# Copilot CLI local sandbox 設定 (Linux/macOS)
#
# Copilot sandbox policy version: 15

set -euo pipefail
umask 077

sandbox_default_enabled={{ if or .codespaces .devcontainer }}false{{ else }}true{{ end }}

fail() {
  echo "Error: Copilot sandbox settings: $*" >&2
  exit 1
}

command -v jq >/dev/null 2>&1 || fail "jq not found on PATH."

readonly_grants='[]'

add_readonly_grant() {
  local path="$1"
  case "${path}" in
  /*) ;;
  *) fail "readonly grant must be an absolute path: ${path}" ;;
  esac
  [[ "${path}" != *$'\n'* && "${path}" != *$'\r'* ]] ||
    fail "readonly grant must be a single-line path."
  readonly_grants="$(
    jq -c --arg path "${path}" '
      if index($path) then . else . + [$path] end
    ' <<<"${readonly_grants}"
  )"
}

add_directory_grant() {
  local path="$1"
  local resolved

  add_readonly_grant "${path}"
  if [ -d "${path}" ]; then
    resolved="$(cd -P -- "${path}" && pwd -P)"
    if [ "${resolved}" != "${path}" ]; then
      add_readonly_grant "${resolved}"
    fi
  fi
}

uv_config_home="${XDG_CONFIG_HOME:-}"
if [[ "${uv_config_home}" != /* ]]; then
  [[ "${HOME:-}" = /* ]] ||
    fail "HOME must be an absolute path to determine the uv config file."
  uv_config_home="${HOME%/}/.config"
fi
uv_config_path="${uv_config_home%/}/uv/uv.toml"
add_readonly_grant "${uv_config_path}"

copilot_home="${COPILOT_HOME:-${HOME}/.copilot}"
hooks_dir="${HOME}/.copilot/hooks"

# mise shims と install ディレクトリは agent の Bash tool が
# jq/rg/node/uv を解決するために必要。
mise_data_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-${HOME}/.local/share}/mise}"

uv_cmd=""
if command -v uv >/dev/null 2>&1; then
  uv_cmd=uv
elif command -v mise >/dev/null 2>&1; then
  if uv_candidate="$(MISE_ENABLE_TOOLS=uv mise which uv 2>/dev/null)" &&
    [ -x "${uv_candidate}" ]; then
    uv_cmd="${uv_candidate}"
  fi
fi

uv_python_dir=""
if [ -n "${uv_cmd}" ]; then
  uv_python_dir="$(MISE_ENABLE_TOOLS=uv "${uv_cmd}" python dir)" ||
    fail "uv python dir failed."
  [ -n "${uv_python_dir}" ] || fail "uv python dir returned an empty path."
else
  echo "Warning: uv was not found on PATH or by mise; install uv and re-run chezmoi apply to allow managed Python in the sandbox." >&2
fi

add_directory_grant "${mise_data_dir}"
if [ -n "${uv_python_dir}" ]; then
  add_directory_grant "${uv_python_dir}"
fi

settings_path="${copilot_home}/settings.json"
settings_dir="$(dirname "${settings_path}")"
hooks_migration_marker="${settings_dir}/.dotfiles-copilot-hooks-retired"
remove_hooks_grant=true
if [ -f "${hooks_migration_marker}" ]; then remove_hooks_grant=false; fi
[ ! -L "${settings_path}" ] || fail "refusing a settings.json symlink."
input='{}'
if [ -e "${settings_path}" ]; then input="$(cat "${settings_path}")"; fi
jq -e 'type == "object"' <<<"${input}" >/dev/null || fail "settings must be a JSON object."

desired="$(cat <<'JSON'
{{ include ".chezmoitemplates/copilot-user-settings.json" }}
JSON
)"

# Preserve explicit /sandbox disable, including false (jq // would replace it).
enabled_present="$(jq -r '(.sandbox // {}) | has("enabled")' <<<"${input}")"
existing_enabled="${sandbox_default_enabled}"
if [ "${enabled_present}" = true ]; then
  enabled_type="$(jq -r '.sandbox.enabled | type' <<<"${input}")"
  [ "${enabled_type}" = boolean ] ||
    fail "${settings_path} has a non-boolean sandbox.enabled (${enabled_type}); fix or remove it and re-run chezmoi apply."
  existing_enabled="$(jq -c '.sandbox.enabled' <<<"${input}")"
fi

for path_name in readwritePaths readonlyPaths deniedPaths; do
  path_type="$(jq -r --arg name "${path_name}" '
    (.sandbox.userPolicy.filesystem // {}) as $fs
    | if ($fs | has($name)) then ($fs[$name] | type) else "missing" end
  ' <<<"${input}")"
  case "${path_type}" in
  missing|null|array) ;;
  *) fail "${settings_path} has a non-array sandbox.userPolicy.filesystem.${path_name} (${path_type}); fix or remove it and re-run chezmoi apply." ;;
  esac
  jq -e --arg name "${path_name}" '
    (.sandbox.userPolicy.filesystem[$name] // [])
    | all(type == "string" and length > 0 and (test("[\\r\\n]") | not))
  ' <<<"${input}" >/dev/null || fail "${path_name} must contain nonempty, single-line path strings."
done

mkdir -p "${settings_dir}"
settings_tmp="${settings_dir}/.settings.json.$$"
(set -o noclobber; : >"${settings_tmp}") || fail "cannot create private settings staging file."
chmod 0600 "${settings_tmp}"
trap 'rm -f "${settings_tmp}"' EXIT

jq --argjson desired "${desired}" --argjson enabled "${existing_enabled}" \
  --argjson readonly_grants "${readonly_grants}" \
  --argjson remove_hooks_grant "${remove_hooks_grant}" --arg hooks_dir "${hooks_dir}" '
  . * $desired
  | .sandbox.enabled = $enabled
  | .sandbox.userPolicy |= (
    del(.version)
    | .filesystem |= (
      .readwritePaths = (.readwritePaths // [])
      | .readonlyPaths = (
          reduce $readonly_grants[] as $path
            ((if $remove_hooks_grant
              then (.readonlyPaths // [] | map(select(. != $hooks_dir)))
              else (.readonlyPaths // [])
              end);
             if index($path) then . else . + [$path] end)
        )
      | .deniedPaths = (.deniedPaths // [])
      | .clearPolicyOnExit = false
    )
    | .network |= del(.allowedHosts, .blockedHosts)
  )
' <<<"${input}" >"${settings_tmp}"
jq -e . "${settings_tmp}" >/dev/null
mv -f "${settings_tmp}" "${settings_path}"
if [ "${remove_hooks_grant}" = true ]; then
  (set -o noclobber; : >"${hooks_migration_marker}") ||
    fail "cannot record hook grant migration in ${hooks_migration_marker}."
fi
echo "Configured GitHub Copilot user settings in ${settings_path}"
{{- end -}}
