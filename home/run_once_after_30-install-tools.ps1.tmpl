        VersionArguments = @('--version')
        Architecture = '{{ index (index .bat.winget.platforms $p3WingetPlatform) "architecture" }}'
        ExecutableArch = '{{ index (index .bat.winget.platforms $p3WingetPlatform) "executableArch" }}'
        Emulated = ${{ index (index .bat.winget.platforms $p3WingetPlatform) "emulated" }}
