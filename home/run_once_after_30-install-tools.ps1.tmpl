{{ if eq .chezmoi.os "windows" -}}
# Windows 向け追加ツールのインストール
# 実行順序: run_once_after_20-mise-install の後。mise でインストールされた uv 等が PATH に必要
$ErrorActionPreference = 'Stop'

# mise shims を PATH に追加 (非対話シェル対応)
$shimsDir = Join-Path $env:LOCALAPPDATA 'mise\shims'
if (($env:Path -split ';') -notcontains $shimsDir) {
    $env:Path = "$shimsDir;$env:Path"
}

# --- Go tools ---
if (Get-Command go -ErrorAction SilentlyContinue) {
    Write-Host "Installing Go tools..."
    try {
        go install golang.org/x/tools/go/analysis/passes/fieldalignment/cmd/fieldalignment@latest
        if ($LASTEXITCODE -ne 0) { throw "go install failed" }
    } catch {
        Write-Warning "Failed to install fieldalignment. Retry manually with 'go install golang.org/x/tools/go/analysis/passes/fieldalignment/cmd/fieldalignment@latest'."
    }
    try {
        go install github.com/ddo/fast@latest
        if ($LASTEXITCODE -ne 0) { throw "go install failed" }
    } catch {
        Write-Warning "Failed to install fast. Retry manually with 'go install github.com/ddo/fast@latest'."
    }
}

# --- uv tools ---
# ty: Python LSP サーバー (Astral)。mise に ty 用バックエンドがないため uv tool で管理
# Spec Kit CLI: ubi backend の廃止予定と GitHub SAML 認証の影響を避けるため uv tool で管理
if (Get-Command uv -ErrorAction SilentlyContinue) {
    Write-Host "Installing uv tools..."
    if (Get-Command mise -ErrorAction SilentlyContinue) {
        $legacySpecKit = mise ls --installed 'ubi:github/spec-kit' 2>$null
        if ($LASTEXITCODE -eq 0 -and $legacySpecKit) {
            Write-Host "Removing the legacy mise-managed Spec Kit CLI..."
            try {
                mise uninstall --all 'ubi:github/spec-kit'
                if ($LASTEXITCODE -ne 0) { throw "mise uninstall failed" }
            } catch {
                Write-Warning "Failed to remove the legacy mise-managed Spec Kit CLI. Retry manually with 'mise uninstall --all ubi:github/spec-kit'."
            }
        }
    }
    try {
        uv tool install --quiet ty
        if ($LASTEXITCODE -ne 0) { throw "uv tool install failed" }
    } catch {
        Write-Warning "Failed to install ty. Retry manually with 'uv tool install ty'."
    }
    try {
        uv tool install --quiet specify-cli --from 'git+https://github.com/github/spec-kit.git@v{{ .specKit.version }}'
        if ($LASTEXITCODE -ne 0) { throw "uv tool install failed" }
    } catch {
        Write-Warning "Failed to install Spec Kit CLI. Retry manually with 'uv tool install specify-cli --from git+https://github.com/github/spec-kit.git@v{{ .specKit.version }}'."
    }

    # uv tool の bin ディレクトリ (~/.local/bin) を User PATH に登録。
    # PowerShell プロファイルを読まない子プロセス (Copilot CLI 等) からも uv tool が見えるようにする。
    try {
        uv tool update-shell | Out-Null
    } catch {
        Write-Warning "Failed to run 'uv tool update-shell'. Add '$HOME\.local\bin' to PATH manually."
    }
}

Write-Host "Tool installation complete!"
{{ end -}}
