{{- if eq .chezmoi.os "windows" -}}
{{- $platform := printf "%s-%s" .chezmoi.os .chezmoi.arch -}}
# Go — 公式アーカイブ (go.dev/dl) を直接導入する。
# 実行順序: run_once_after_30-install-tools より前。あちらの Go 検出はここが作る
# $HOME\.local\share\chezmoi-dotfiles\go\bin を前提にする。
#
# 導入済みの版が宣言と一致する場合はネットワークへ出ない。取得物は staging へ展開し、
# checksum と版の確認まで終えてから最終パス (固定・無版数の root) へ置き換える。
# 途中で失敗した場合は既存の Go を残す。
$ErrorActionPreference = 'Stop'

$goVersion = '{{ .go.version }}'
{{ if not (hasKey .go.assets $platform) }}
# 宣言に無い OS/CPU は非対応。別 CPU 向けの asset へフォールバックしない。
Write-Warning "Go $goVersion has no official asset for {{ $platform }}; skipping installation."
exit 0
{{ else }}
{{- $asset := index .go.assets $platform }}
$shareDir = Join-Path $HOME '.local\share\chezmoi-dotfiles'
$finalRoot = Join-Path $shareDir 'go'
$entrypoint = Join-Path $finalRoot 'bin\go.exe'
$assetFile = '{{ $asset.file }}'
$assetSha256 = '{{ $asset.sha256 }}'
$assetUrl = '{{ $.go.downloadBaseUrl }}/{{ $asset.file }}'
$goOsArch = '{{ .chezmoi.os }}_{{ .chezmoi.arch }}'

# `go version` は "go version go1.27.1 windows/amd64" を出力する。
function Get-InstalledGoVersion {
    param([string]$Path)

    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) { return $null }
    $probeParent = Join-Path $HOME '.local\share\chezmoi-dotfiles'
    $probeDir = Join-Path $probeParent (".go-version-probe." + [System.IO.Path]::GetRandomFileName())
    $previousLocation = Get-Location
    $previousGoToolchain = $env:GOTOOLCHAIN
    $previousGoWork = $env:GOWORK
    try {
        New-Item -ItemType Directory -Force -Path $probeDir | Out-Null
        Set-Location -LiteralPath $probeDir
        $env:GOTOOLCHAIN = 'local'
        $env:GOWORK = 'off'
        $output = & $Path version 2>$null
        if ($LASTEXITCODE -ne 0 -or -not $output) { return $null }
        $fields = ([string]($output | Select-Object -First 1)).Trim() -split '\s+'
        if ($fields.Length -lt 3) { return $null }
        return ($fields[2] -replace '^go', '')
    }
    catch {
        return $null
    }
    finally {
        Set-Location -LiteralPath $previousLocation
        $env:GOTOOLCHAIN = $previousGoToolchain
        $env:GOWORK = $previousGoWork
        Remove-Item -LiteralPath $probeDir -Recurse -Force -ErrorAction SilentlyContinue
    }
}

# バージョン文字列の一致だけでは、gofmt やコンパイラ本体を欠いた不完全な
# 導入 (空ディレクトリマーカーのようなもの) を見逃す。bin\gofmt.exe と
# 実際のコンパイラツールチェイン (pkg\tool\<os>_<arch>\compile.exe) の
# 実在も見る。
function Test-GoPayloadComplete {
    param([string]$Root)

    $gofmt = Join-Path $Root 'bin\gofmt.exe'
    $compile = Join-Path $Root ("pkg\tool\{0}\compile.exe" -f $goOsArch)
    return (Test-Path -LiteralPath $gofmt -PathType Leaf) -and
        (Test-Path -LiteralPath $compile -PathType Leaf)
}

# 実行中の go.exe は置き換えられない。root ごと入れ替える前に排他で開けるか確認する。
function Assert-BinaryReplaceable {
    param([string]$Path)

    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) { return }
    try {
        $stream = [System.IO.File]::Open(
            $Path,
            [System.IO.FileMode]::Open,
            [System.IO.FileAccess]::ReadWrite,
            [System.IO.FileShare]::None
        )
        $stream.Dispose()
    }
    catch {
        throw ("go.exe を置き換えられません。実行中のプロセスが掴んでいる可能性があります。" +
            "go を使っているプロセスを終了してから 'chezmoi apply' を再実行してください。" +
            "既存の Go インストールは変更していません。")
    }
}

if ((Get-InstalledGoVersion -Path $entrypoint) -eq $goVersion -and (Test-GoPayloadComplete -Root $finalRoot)) {
    exit 0
}

New-Item -ItemType Directory -Force -Path $shareDir | Out-Null

# staging を最終パスと同じファイルシステムへ置き、置き換えを rename で終わらせる。
$stageDir = Join-Path $shareDir (".go-install." + [System.IO.Path]::GetRandomFileName())
New-Item -ItemType Directory -Force -Path $stageDir | Out-Null
$cleanupStageDir = $true
try {
    $archive = Join-Path $stageDir $assetFile
    try {
        Invoke-WebRequest -Uri $assetUrl -OutFile $archive -UseBasicParsing
    }
    catch {
        throw "failed to download $assetFile; keeping the current Go installation. ($($_.Exception.Message))"
    }

    $actualSha256 = (Get-FileHash -LiteralPath $archive -Algorithm SHA256).Hash.ToLowerInvariant()
    if ($actualSha256 -ne $assetSha256) {
        throw "checksum verification failed for $assetFile"
    }

    # 公式アーカイブは常に go\ という単一の頂点ディレクトリを持つ。
    $extractedParent = Join-Path $stageDir 'extracted'
    Expand-Archive -LiteralPath $archive -DestinationPath $extractedParent -Force
    $extractedGo = Join-Path $extractedParent 'go'
    $stagedEntrypoint = Join-Path $extractedGo 'bin\go.exe'
    if (-not (Test-Path -LiteralPath $stagedEntrypoint -PathType Leaf)) {
        throw "expected entrypoint bin\go.exe missing from $assetFile"
    }

    if (-not (Test-GoPayloadComplete -Root $extractedGo)) {
        throw "expected bin\gofmt.exe or pkg\tool\$goOsArch\compile.exe missing from $assetFile"
    }

    $stagedVersion = Get-InstalledGoVersion -Path $stagedEntrypoint
    if ($stagedVersion -ne $goVersion) {
        $found = if ($stagedVersion) { $stagedVersion } else { 'unknown' }
        throw "expected go $goVersion but $assetFile reported $found"
    }

    Assert-BinaryReplaceable -Path $entrypoint

    Write-Host "Installing Go $goVersion..."
    $backupRoot = Join-Path $stageDir 'previous-go'
    try {
        if (Test-Path -LiteralPath $finalRoot) {
            Move-Item -LiteralPath $finalRoot -Destination $backupRoot
        }
        Move-Item -LiteralPath $extractedGo -Destination $finalRoot
    }
    catch {
        $replacementError = $_
        try {
            if (Test-Path -LiteralPath $backupRoot) {
                Remove-Item -LiteralPath $finalRoot -Recurse -Force -ErrorAction SilentlyContinue
                Move-Item -LiteralPath $backupRoot -Destination $finalRoot -Force
            }
        }
        catch {
            $cleanupStageDir = $false
            throw ("Go の復旧を完了できませんでした。復旧用ファイルは $stageDir に残しています。" +
                "実行中の go 関連プロセスを終了し、同ディレクトリの previous-go を確認してください。" +
                "置換原因: $($replacementError.Exception.Message); 復旧原因: $($_.Exception.Message)")
        }
        throw ("Go の置き換えに失敗したため、以前のインストールへ戻しました。" +
            "実行中の go 関連プロセスを終了してから 'chezmoi apply' を再実行してください。" +
            "原因: $($replacementError.Exception.Message)")
    }
}
finally {
    if ($cleanupStageDir) {
        Remove-Item -LiteralPath $stageDir -Recurse -Force -ErrorAction SilentlyContinue
    }
}
{{ end }}
{{- end -}}
