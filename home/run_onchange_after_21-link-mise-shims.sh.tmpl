{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# GitHub Desktop の Copilot SDK は mise shims を含まない固定 PATH で子 shell を
# 起動するが、~/.local/bin は含めるため、安全な shim だけをここへリンクする。
# 本スクリプトが作成したリンクだけを state ファイルで管理する。
# 公式インストーラーが ~/.local/bin へ置いた実体（uv / uvx / jq / gh）は本スクリプトの
# 管理対象ではなく、mise から外れた shim のリンクはここで掃除される。
# 関連: docs/architecture.md「PATH 管理（非対話シェル対応）」
#
# mise config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

set -euo pipefail

SHIM_DIR="$HOME/.local/share/mise/shims"
LINK_DIR="$HOME/.local/bin"
STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi-dotfiles/mise-shim-links"

# ~/.local/bin を優先するアプリケーションが意図しない版を使わないようにする。
# Rust は ADR-016 により mise の管理外であり、cargo / rust の除外は不要。
# ADR-028 で mise から公式の直接導入へ移行したコマンドは、mise shims
# ディレクトリに同名の古い shim が残っていても symlink 対象にしない。
# 残存 shim を誤って `~/.local/bin` へ復活させると、GUI 起動プロセスから
# 見えるツールが古い mise 管理版のまま固定されてしまうためである。
EXCLUDE_EXACT=(
  go gofmt
  node npm npx pnpm
  dotnet dnx
  bun bunx
  tsc tsserver typescript-language-server
  kubelogin cosign cue helm kubectl kustomize sqlc terraform trivy yq
)

# glob パターン。*.bat/*.ps1/*.sh/*.zst/*.txt/*-darwin-* は shim ではない付随ファイル。
EXCLUDE_PATTERN=('*.bat' '*.ps1' '*.sh' '*.zst' '*.txt' '*-darwin-*')

is_excluded() {
  local name="$1" e p
  for p in "${EXCLUDE_PATTERN[@]}"; do
    # shellcheck disable=SC2053
    [[ "$name" == $p ]] && return 0
  done
  for e in "${EXCLUDE_EXACT[@]}"; do
    [ "$name" = "$e" ] && return 0
  done
  return 1
}

if [ ! -d "$SHIM_DIR" ]; then
  echo "mise shims not found at $SHIM_DIR; skipping (run 'mise install' first)." >&2
  exit 0
fi

mkdir -p "$LINK_DIR" "$(dirname "$STATE_FILE")"

# 今回リンク対象にする shim 一覧を収集。
eligible=()
for shim in "$SHIM_DIR"/*; do
  [ -f "$shim" ] || continue
  [ -x "$shim" ] || continue
  name=$(basename "$shim")
  if is_excluded "$name"; then
    continue
  fi
  eligible+=("$name")
done

in_eligible() {
  local target="$1" n
  for n in "${eligible[@]}"; do
    [ "$n" = "$target" ] && return 0
  done
  return 1
}

# 1) 前回作成したリンクのうち、今回 eligible でなくなった / shim が消えたものを削除。
#    state file に載っていないリンクは管理対象外として絶対に触らない。
if [ -f "$STATE_FILE" ]; then
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    link="$LINK_DIR/$name"
    [ -L "$link" ] || continue
    expected="$SHIM_DIR/$name"
    [ "$(readlink "$link")" = "$expected" ] || continue
    if ! in_eligible "$name"; then
      echo "Removing stale shim link: $link"
      rm -f "$link"
    fi
  done < "$STATE_FILE"
fi

# 2) eligible shim をリンクし、新しい state を書き出す。
new_state=""
for name in "${eligible[@]}"; do
  shim="$SHIM_DIR/$name"
  link="$LINK_DIR/$name"
  if [ -e "$link" ] || [ -L "$link" ]; then
    if [ -L "$link" ] && [ "$(readlink "$link")" = "$shim" ]; then
      # 既に本スクリプトが作成した正しいリンク。state に記録するだけ。
      new_state+="$name"$'\n'
      continue
    fi
    # 非 symlink / 別ターゲットの symlink (ユーザー管理) は触らない。
    echo "Skip: $link already exists (user-managed); leaving alone" >&2
    continue
  fi
  ln -s "$shim" "$link"
  echo "Linked $link -> $shim"
  new_state+="$name"$'\n'
done

# state file を更新 (空でも作る: 次回実行時に掃除漏れを起こさないため)
printf '%s' "$new_state" > "$STATE_FILE"
{{ end -}}
