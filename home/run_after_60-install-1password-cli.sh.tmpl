{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# OS package manager が所有する 1Password CLI を ~/.local/bin/op へ公開する。

set -euo pipefail

tool_version='{{ .onePassword.minimumVersion }}'
platform_os='{{ .chezmoi.os }}'
platform_arch='{{ .chezmoi.arch }}'
bin_dir="${HOME}/.local/bin"
target="${bin_dir}/op"
mise_target="${HOME}/.local/share/mise/shims/op"

version_ge() {
  local left="${1%%[-+]*}" right="${2%%[-+]*}" index left_field right_field
  local -a left_parts right_parts
  case "${left}:${right}" in
    *[!0-9.:]*) return 1 ;;
  esac
  IFS='.' read -r -a left_parts <<<"${left}"
  IFS='.' read -r -a right_parts <<<"${right}"
  for index in 0 1 2; do
    left_field=$((10#${left_parts[index]:-0}))
    right_field=$((10#${right_parts[index]:-0}))
    [ "${left_field}" -gt "${right_field}" ] && return 0
    [ "${left_field}" -lt "${right_field}" ] && return 1
  done
  return 0
}

resolve_link() {
  local current=$1 next directory
  while [ -L "${current}" ]; do
    directory="$(cd -P "$(dirname "${current}")" && pwd)"
    next="$(readlink "${current}")"
    case "${next}" in
      /*) current="${next}" ;;
      *) current="${directory}/${next}" ;;
    esac
  done
  directory="$(cd -P "$(dirname "${current}")" && pwd)"
  printf '%s/%s\n' "${directory}" "$(basename "${current}")"
}

provider_binary() {
{{ if eq .chezmoi.os "linux" -}}
  local owners
  dpkg-query -W -f='${db:Status-Abbrev}' 1password-cli 2>/dev/null |
    grep -q '^ii ' || return 1
  owners="$(dpkg-query -S /usr/bin/op 2>/dev/null)" || return 1
  printf '%s\n' "${owners}" | awk -F: '$1 == "1password-cli" || $1 ~ /^1password-cli:/ { found = 1 } END { exit(found ? 0 : 1) }' ||
    return 1
  [ -f /usr/bin/op ] && [ ! -L /usr/bin/op ] || return 1
  printf '%s\n' /usr/bin/op
{{ else if eq .chezmoi.os "darwin" -}}
  local prefix linked resolved
  prefix='{{ .onePassword.homebrew.prefix }}'
  [ -d "${prefix}" ] || return 1
  prefix="$(cd -P "${prefix}" && pwd)" || return 1
  linked="${prefix}/bin/op"
  [ -L "${linked}" ] || return 1
  resolved="$(resolve_link "${linked}")" || return 1
  case "${resolved}" in
    "${prefix}/Caskroom/1password-cli/"*) ;;
    *) return 1 ;;
  esac
  [ -f "${resolved}" ] && [ ! -L "${resolved}" ] || return 1
  printf '%s\n' "${resolved}"
{{ else -}}
  return 1
{{ end -}}
}

has_expected_architecture() {
  local binary=$1 header
  [ -f "${binary}" ] && [ ! -L "${binary}" ] || return 1
  header="$(LC_ALL=C od -An -tx1 -N20 "${binary}" 2>/dev/null |
    awk '{ for (i = 1; i <= NF; i++) printf "%s", $i } END { print "" }')" || return 1
  case "${platform_os}:${platform_arch}" in
    linux:amd64)
      [ "${#header}" -ge 40 ] && [ "${header:0:12}" = "7f454c460201" ] &&
        [ "${header:36:4}" = "3e00" ]
      ;;
    linux:arm64)
      [ "${#header}" -ge 40 ] && [ "${header:0:12}" = "7f454c460201" ] &&
        [ "${header:36:4}" = "b700" ]
      ;;
    darwin:arm64)
      [ "${#header}" -ge 16 ] && [ "${header:0:16}" = "cffaedfe0c000001" ]
      ;;
    *) return 1 ;;
  esac
}

has_minimum_version() {
  local binary=$1 cwd=$2 probe_home=$3 output
  mkdir -p "${probe_home}"
  if ! output="$(cd "${cwd}" && HOME="${probe_home}" "${binary}" --version 2>/dev/null)"; then
    return 1
  fi
  [ "${output}" = "${output%%$'\n'*}" ] || return 1
  version_ge "${output}" "${tool_version}"
}

assert_target_replaceable() {
  if [ -L "${target}" ]; then
    local current
    current="$(readlink "${target}")"
    if [ -d "${target}" ]; then
      echo "error: ${target} points to a directory; refusing to replace it" >&2
      return 1
    fi
    if [ "${current}" != "${provider}" ] && [ "${current}" != "${mise_target}" ]; then
      echo "error: ${target} is a foreign symlink (${current}); refusing to replace it" >&2
      return 1
    fi
  elif [ -e "${target}" ] && [ ! -f "${target}" ]; then
    echo "error: ${target} is not a regular file; refusing to replace it" >&2
    return 1
  fi
}

command -v od >/dev/null 2>&1 || {
  echo "error: od is required to verify 1Password CLI architecture" >&2
  exit 1
}
provider="$(provider_binary || true)"
[ -n "${provider}" ] || {
  echo "error: the OS package manager did not provide a supported 1Password CLI" >&2
  exit 1
}
assert_target_replaceable
probe_root="${bin_dir}/.op-probe.$$"
mkdir -p "${probe_root}"
trap 'rm -rf "${probe_root}"' EXIT
chmod 700 "${probe_root}"
has_expected_architecture "${provider}" || {
  echo "error: the package-owned 1Password CLI is not a native ${platform_arch} executable" >&2
  exit 1
}
has_minimum_version "${provider}" "${probe_root}" "${probe_root}/home" || {
  echo "error: the package-owned 1Password CLI is older than ${tool_version}" >&2
  exit 1
}
if [ -L "${target}" ] && [ "$(readlink "${target}")" = "${provider}" ]; then
  exit 0
fi

mkdir -p "${bin_dir}"
stage_dir="$(mktemp -d "${bin_dir}/.op-entrypoint.XXXXXX")"
chmod 700 "${stage_dir}"
ln -s "${provider}" "${stage_dir}/op"
assert_target_replaceable
if ! mv -f "${stage_dir}/op" "${target}"; then
  echo "error: could not publish ${target}; the previous entry was kept" >&2
  exit 1
fi
{{- end }}
