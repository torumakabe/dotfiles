{{ if ne .chezmoi.os "windows" -}}
#!/bin/bash
set -euo pipefail

# mise — tool version manager
# Order dependency:
# - Keep this after run_once_before_10-install-packages so package-manager prerequisites
#   such as git/zsh/curl are already installed where needed.
# - Keep this before run_once_after_20-mise-install so `mise install` has a bootstrapper.
MISE_VERSION="v2026.8.10"
MISE_BIN_DIR="${HOME}/.local/bin"

mise_path="$(command -v mise 2>/dev/null || true)"
homebrew_mise=0
brew_mise_link=""
brew_mise_bin=""

report_homebrew_mise_cleanup() {
  local expected_mise=$1
  echo "Homebrew mise formula remains to keep the current shell activation valid." >&2
  echo "Restart every shell using the Homebrew activation, then verify" >&2
  echo "'command -v mise' returns ${expected_mise}," >&2
  echo "then run 'brew uninstall mise' manually." >&2
}

{{ if eq .chezmoi.os "darwin" -}}
if command -v brew >/dev/null 2>&1 \
  && brew list --formula mise >/dev/null 2>&1; then
  brew_prefix="$(brew --prefix)"
  brew_mise_prefix="$(brew --prefix mise)"
  brew_mise_link="${brew_prefix}/bin/mise"
  brew_mise_bin="${brew_mise_prefix}/bin/mise"
  if [ -z "${mise_path}" ] \
    || [ "${mise_path}" -ef "${brew_mise_link}" ] \
    || [ "${mise_path}" -ef "${brew_mise_bin}" ]; then
    homebrew_mise=1
  else
    if ! existing_version="$("${mise_path}" --version)"; then
      echo "error: existing mise failed verification: ${mise_path}" >&2
      exit 1
    fi
    echo "mise is already installed: ${existing_version}"
    report_homebrew_mise_cleanup "${mise_path}"
    exit 0
  fi
fi
{{ end -}}

if [ -n "${mise_path}" ] && [ "${homebrew_mise}" -eq 0 ]; then
  if ! existing_version="$("${mise_path}" --version)"; then
    echo "error: existing mise failed verification: ${mise_path}" >&2
    exit 1
  fi
  echo "mise is already installed: ${existing_version}"
  exit 0
fi

if [ -e "${MISE_BIN_DIR}/mise" ] || [ -L "${MISE_BIN_DIR}/mise" ]; then
  if [ "${homebrew_mise}" -eq 1 ] \
    && { [ "${MISE_BIN_DIR}/mise" -ef "${brew_mise_link}" ] \
      || [ "${MISE_BIN_DIR}/mise" -ef "${brew_mise_bin}" ]; }; then
    :
  elif [ ! -x "${MISE_BIN_DIR}/mise" ]; then
    echo "error: ${MISE_BIN_DIR}/mise exists but is not executable" >&2
    exit 1
  else
    if ! existing_version="$("${MISE_BIN_DIR}/mise" --version)"; then
      echo "error: existing mise failed verification: ${MISE_BIN_DIR}/mise" >&2
      exit 1
    fi
    echo "mise is already installed: ${existing_version}"
    if [ "${homebrew_mise}" -eq 1 ]; then
      report_homebrew_mise_cleanup "${MISE_BIN_DIR}/mise"
    fi
    exit 0
  fi
fi

download_file() {
  local url=$1
  local output=$2

  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "${output}" "${url}"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "${output}" "${url}"
  else
    echo "error: curl or wget required to install mise" >&2
    exit 1
  fi
}

sha256_file() {
  local file=$1

  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "${file}" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "${file}" | awk '{print $1}'
  else
    echo "error: sha256sum or shasum required to verify mise" >&2
    exit 1
  fi
}

case "$(uname -s):$(uname -m)" in
  Darwin:arm64)
    mise_archive="mise-${MISE_VERSION}-macos-arm64.tar.gz"
    expected_sha256="ac6ed53215e70abfb220524aed121bf02dbd3fbd4a19355032dd1c5a108fb212"
    ;;
  Linux:x86_64|Linux:amd64)
    mise_archive="mise-${MISE_VERSION}-linux-x64.tar.gz"
    expected_sha256="e013fe11a0a9055fe78d2546baa85eba90a56e6445c431021b4fe328e6910fe2"
    ;;
  Linux:aarch64|Linux:arm64)
    mise_archive="mise-${MISE_VERSION}-linux-arm64.tar.gz"
    expected_sha256="5fd8a9ffb312b47e29f642d377ad4fa9093962b47061ef5c15665086904e1046"
    ;;
  *)
    echo "error: unsupported platform: $(uname -s) $(uname -m)" >&2
    exit 1
    ;;
esac

echo "Installing mise..."
tmp_dir=$(mktemp -d)
staged_dir=""
cleanup() {
  rm -rf "${tmp_dir}"
  if [ -n "${staged_dir}" ]; then
    rm -rf "${staged_dir}"
  fi
}
trap cleanup EXIT

archive_path="${tmp_dir}/${mise_archive}"
archive_url="https://github.com/jdx/mise/releases/download/${MISE_VERSION}/${mise_archive}"

download_file "${archive_url}" "${archive_path}"

actual_sha256="$(sha256_file "${archive_path}")"
if [ "${actual_sha256}" != "${expected_sha256}" ]; then
  echo "error: checksum verification failed for ${mise_archive}" >&2
  echo "expected: ${expected_sha256}" >&2
  echo "actual:   ${actual_sha256}" >&2
  exit 1
fi

mkdir -p "${MISE_BIN_DIR}"
tar -xzf "${archive_path}" -C "${tmp_dir}" mise/bin/mise
staged_dir="$(mktemp -d "${MISE_BIN_DIR}/.mise.XXXXXX")"
staged_path="${staged_dir}/mise"
install -m 0755 "${tmp_dir}/mise/bin/mise" "${staged_path}"
"${staged_path}" --version
mv -f "${staged_path}" "${MISE_BIN_DIR}/mise"

if [ "${homebrew_mise}" -eq 1 ]; then
  report_homebrew_mise_cleanup "${MISE_BIN_DIR}/mise"
fi
{{ end -}}
