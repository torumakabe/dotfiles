{{ if ne .chezmoi.os "windows" -}}
#!/bin/bash
set -euo pipefail

# mise — tool version manager
# Order dependency:
# - Keep this after run_once_before_10-install-packages so package-manager prerequisites
#   such as git/zsh/curl are already installed where needed.
# - Keep this before run_once_after_20-mise-install so `mise install` has a bootstrapper.
MISE_VERSION="v2026.11.3"
MISE_BIN_DIR="${HOME}/.local/bin"

mise_path="$(command -v mise 2>/dev/null || true)"
if [ -n "${mise_path}" ]; then
  if ! existing_version="$("${mise_path}" --version)"; then
    echo "error: existing mise failed verification: ${mise_path}" >&2
    exit 1
  fi
  echo "mise is already installed: ${existing_version}"
  exit 0
fi

if [ -e "${MISE_BIN_DIR}/mise" ] || [ -L "${MISE_BIN_DIR}/mise" ]; then
  if [ ! -x "${MISE_BIN_DIR}/mise" ]; then
    echo "error: ${MISE_BIN_DIR}/mise exists but is not executable" >&2
    exit 1
  fi
  if ! existing_version="$("${MISE_BIN_DIR}/mise" --version)"; then
    echo "error: existing mise failed verification: ${MISE_BIN_DIR}/mise" >&2
    exit 1
  fi
  echo "mise is already installed: ${existing_version}"
  exit 0
fi

download_file() {
  local url=$1
  local output=$2

  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "${output}" "${url}"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "${output}" "${url}"
  else
    echo "error: curl or wget required to install mise" >&2
    exit 1
  fi
}

sha256_file() {
  local file=$1

  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "${file}" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "${file}" | awk '{print $1}'
  else
    echo "error: sha256sum or shasum required to verify mise" >&2
    exit 1
  fi
}

case "$(uname -s):$(uname -m)" in
  Darwin:arm64)
    mise_archive="mise-${MISE_VERSION}-macos-arm64.tar.gz"
    expected_sha256="de9a54330fee4edede51a3cf6196bbf522f01c5e3fd981e0bebea33f561a0431"
    ;;
  Linux:x86_64|Linux:amd64)
    mise_archive="mise-${MISE_VERSION}-linux-x64.tar.gz"
    expected_sha256="837acae6defb8c9ad74823f6e38856633bacb04c65c1ac67d952749847543bd9"
    ;;
  Linux:aarch64|Linux:arm64)
    mise_archive="mise-${MISE_VERSION}-linux-arm64.tar.gz"
    expected_sha256="13547a80d1dc2d5f81bb183023732f4981486e894d060e30993cc4364b4af51d"
    ;;
  *)
    echo "error: unsupported platform: $(uname -s) $(uname -m)" >&2
    exit 1
    ;;
esac

echo "Installing mise..."
tmp_dir=$(mktemp -d)
staged_dir=""
cleanup() {
  rm -rf "${tmp_dir}"
  if [ -n "${staged_dir}" ]; then
    rm -rf "${staged_dir}"
  fi
}
trap cleanup EXIT

archive_path="${tmp_dir}/${mise_archive}"
archive_url="https://github.com/jdx/mise/releases/download/${MISE_VERSION}/${mise_archive}"

download_file "${archive_url}" "${archive_path}"

actual_sha256="$(sha256_file "${archive_path}")"
if [ "${actual_sha256}" != "${expected_sha256}" ]; then
  echo "error: checksum verification failed for ${mise_archive}" >&2
  echo "expected: ${expected_sha256}" >&2
  echo "actual:   ${actual_sha256}" >&2
  exit 1
fi

mkdir -p "${MISE_BIN_DIR}"
tar -xzf "${archive_path}" -C "${tmp_dir}" mise/bin/mise
staged_dir="$(mktemp -d "${MISE_BIN_DIR}/.mise.XXXXXX")"
staged_path="${staged_dir}/mise"
install -m 0755 "${tmp_dir}/mise/bin/mise" "${staged_path}"
"${staged_path}" --version
mv -f "${staged_path}" "${MISE_BIN_DIR}/mise"
{{ end -}}
